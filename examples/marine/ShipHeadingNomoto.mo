// Ship heading autopilot on the first-order Nomoto model, tracking a course-change maneuver.
//
// Nomoto model (yaw rate response to rudder): T*r' = -r + K*(rudder + d_wave), psi' = r.
// The wave/wind yaw moment is expressed as an equivalent rudder angle d_wave (bounded).
// The heading reference is generated by a smooth turn profile psi_ref' = r_ref,
// r_ref' = a_ref with a_ref free; the autopilot inverts the Nomoto model for feedforward,
//   rudder_ff = (T*a_ref + r_ref)/K,
// and adds PID feedback on the heading error (integral state xi' = e_psi).
// Closed-loop poles were placed at s = -0.05 and s = -0.08 +- 0.06i (gains below).
//
// Certified: heading error, yaw-rate error and the integrator stay bounded during every
// course change, for every wave disturbance within +-2 deg of equivalent rudder.
// Values are illustrative for a ~150 m cargo ship at service speed.
model ShipHeadingNomoto
  parameter Real K = 0.1 "Nomoto gain [1/s]";
  parameter Real T = 20.0 "Nomoto time constant [s]";
  parameter Real kp = 3.6 "Heading gain [rad/rad]";
  parameter Real kd = 32.0 "Yaw-rate gain [rad*s/rad]";
  parameter Real ki = 0.1 "Integral gain [rad/(rad*s)]";

  input Real psi_ref "Heading reference [rad]"
    annotation(__Dynacert(reference(derivative = "r_ref", start = 0)));
  input Real r_ref "Yaw-rate reference [rad/s]"
    annotation(__Dynacert(reference(derivative = "a_ref", start = 0)));
  input Real a_ref "Yaw-acceleration reference [rad/s2]" annotation(__Dynacert(reference));
  input Real d_wave "Wave yaw moment as equivalent rudder [rad]"
    annotation(__Dynacert(disturbance(bound = 0.035)));

  Real psi(start = 0, fixed = true) "Heading [rad]";
  Real r(start = 0, fixed = true) "Yaw rate [rad/s]";
  Real xi(start = 0, fixed = true) "Integral of heading error [rad*s]"
    annotation(__Dynacert(certify));
  Real e_psi "Heading error [rad]" annotation(__Dynacert(certify));
  Real e_r "Yaw-rate error [rad/s]" annotation(__Dynacert(certify));
  Real rudder_ff "Feedforward rudder [rad]";
  Real rudder "Rudder angle [rad]";
equation
  e_psi = psi - psi_ref;
  e_r = r - r_ref;
  rudder_ff = (T*a_ref + r_ref)/K;
  rudder = rudder_ff - kp*e_psi - kd*e_r - ki*xi;
  der(xi) = e_psi;
  der(psi) = r;
  T*der(r) = -r + K*(rudder + d_wave);
end ShipHeadingNomoto;
