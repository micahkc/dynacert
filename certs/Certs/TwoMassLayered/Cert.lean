/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `a.x`, `a.v`, `b.x`, `b.v`. -/
def vec (s : States) (v : Inputs) : Fin 4 → ℝ :=
  ![(1 : ℝ) * s.«a.x», (1 : ℝ) * s.«a.v», (1 : ℝ) * s.«b.x», (1 : ℝ) * s.«b.v»]
/-- Disturbance channels: `d1`, `d2`. -/
def dist (v : Inputs) : Fin 2 → ℝ := ![v.d1, v.d2]

def model : LTIModel 4 2 where
  A := !![0, 1, 0, 0; -6/5, -6/5, 1/5, 0; 0, 0, 0, 1; 1/5, 0, -11/5, -3/2]
  B := !![0, 0; 1, 0; 0, 0; 0, 1]

theorem f_apply (z : Fin 4 → ℝ) (w : Fin 2 → ℝ) :
    model.toSystem.f z w = ![(1 : ℝ) * (z 1), (-6/5 : ℝ) * (z 0) + (-6/5 : ℝ) * (z 1) + (1/5 : ℝ) * (z 2) + (1 : ℝ) * (w 0), (1 : ℝ) * (z 3), (1/5 : ℝ) * (z 0) + (-11/5 : ℝ) * (z 2) + (-3/2 : ℝ) * (z 3) + (1 : ℝ) * (w 1)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (0.2 : ℝ) = 1/5 := by norm_num
theorem lit1 : (1.0 : ℝ) = 1 := by norm_num
theorem lit2 : (1.2 : ℝ) = 6/5 := by norm_num
theorem lit3 : (2.0 : ℝ) = 2 := by norm_num
theorem lit4 : (1.5 : ℝ) = 3/2 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hc3, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«a.x») (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«a.v») (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«b.x») (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«b.v») (Icc 0 T)
      exact (continuousOn_const.mul hc3)
  · obtain ⟨hd0, hd1, hd2, hd3, ⟨e0, e1, e2, e3, e4, e5⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3 e4 e5
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«a.x») _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«a.x» = (1 : ℝ) * ((1 : ℝ) * (x t).«a.v»)
      linear_combination (1 : ℝ) * e0
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«a.v») _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«a.v» = (-6/5 : ℝ) * ((1 : ℝ) * (x t).«a.x») + (-6/5 : ℝ) * ((1 : ℝ) * (x t).«a.v») + (1/5 : ℝ) * ((1 : ℝ) * (x t).«b.x») + (1 : ℝ) * ((u t).d1)
      linear_combination (1 : ℝ) * e1 + (1 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«b.x») _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«b.x» = (1 : ℝ) * ((1 : ℝ) * (x t).«b.v»)
      linear_combination (1 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«b.v») _ (Ici t) t
      refine ((hd3.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«b.v» = (1/5 : ℝ) * ((1 : ℝ) * (x t).«a.x») + (-11/5 : ℝ) * ((1 : ℝ) * (x t).«b.x») + (-3/2 : ℝ) * ((1 : ℝ) * (x t).«b.v») + (1 : ℝ) * ((u t).d2)
      linear_combination (1 : ℝ) * e3 + (1 : ℝ) * e5

