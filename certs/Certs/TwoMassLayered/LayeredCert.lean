/-! ### Coupling signals: the states each layer reads from the others -/

def sig (s : States) : Fin 2 → ℝ := ![|s.«a.x»|, |s.«b.x»|]
/-- Assumed bounds. -/
def Bsig : Fin 2 → ℚ := ![651/472, 91917/163460]
/-- Guaranteed bounds (strictly smaller). -/
def Csig : Fin 2 → ℚ := ![8315/6113, 5323/9695]

theorem Csig_lt : ∀ i, Csig i < Bsig i := by decide +kernel

/-! ### Layer 0: `a` (states `a.x`, `a.v`; reads `b.x`) -/

def vec0 (s : States) : Fin 2 → ℝ := ![s.«a.x», s.«a.v»]
def dist0 (s : States) (v : Inputs) : Fin 2 → ℝ := ![v.d1, s.«b.x»]
def model0 : LTIModel 2 2 where
  A := !![0, 1; -6/5, -6/5]
  B := !![0, 0; 1, 1/5]

theorem f_apply0 (z : Fin 2 → ℝ) (w : Fin 2 → ℝ) :
    model0.toSystem.f z w = ![(1 : ℝ) * (z 1), (-6/5 : ℝ) * (z 0) + (-6/5 : ℝ) * (z 1) + (1 : ℝ) * (w 0) + (1/5 : ℝ) * (w 1)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model0, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem link0 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) :
    model0.toSystem.IsSolution (fun t => vec0 (x t)) (fun t => dist0 (x t) (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hc3, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · exact hc0
    · exact hc1
  · obtain ⟨hd0, hd1, hd2, hd3, ⟨e0, e1, e2, e3, e4, e5⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3 e4 e5
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (x s).«a.x») _ (Ici t) t
      refine hd0.congr_deriv ?_
      rw [f_apply0]
      show (dx t).«a.x» = (1 : ℝ) * ((x t).«a.v»)
      linear_combination (1 : ℝ) * e0
    · show HasDerivWithinAt (fun s => (x s).«a.v») _ (Ici t) t
      refine hd1.congr_deriv ?_
      rw [f_apply0]
      show (dx t).«a.v» = (-6/5 : ℝ) * ((x t).«a.x») + (-6/5 : ℝ) * ((x t).«a.v») + (1 : ℝ) * ((u t).d1) + (1/5 : ℝ) * ((x t).«b.x»)
      linear_combination (1 : ℝ) * e1 + (1 : ℝ) * e4

