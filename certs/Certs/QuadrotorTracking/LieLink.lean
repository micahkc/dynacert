/-- `(«quad.p», «quad.v», «quad.R»)` is an SE₂(3) trajectory: `a = (y t).«quad.a»`, `ω = (y t).«quad.w»`,
`g = ![0, 0, -p.«quad.g»]`. -/
theorem se23_quad_R {p : Params} {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) (h0 : Initial p (x 0)) :
    SpacecraftSolution
      (ofScalars (fun t => (x t).«quad.p») (fun t => (x t).«quad.v») (fun t => (x t).«quad.R»))
      (fun t => (y t).«quad.a») (fun t => (y t).«quad.w») (fun t => ![0, 0, -p.«quad.g»]) T := by
  obtain ⟨dx, c0, c1, c2, c3, c4, c5, c6, hder⟩ := h
  obtain ⟨i0, i1, i2, i3, i4, i5, i6⟩ := h0
  refine spacecraft_of_components
    (dp := fun t => (dx t).«quad.p») (dv := fun t => (dx t).«quad.v»)
    (dR := fun t => (dx t).«quad.R») c0 c1 c2
    (fun t ht => by obtain ⟨d0, d1, d2, d3, d4, d5, d6, -⟩ := hder t ht; exact d0)
    (fun t ht => by obtain ⟨d0, d1, d2, d3, d4, d5, d6, -⟩ := hder t ht; exact d1)
    (fun t ht => by obtain ⟨d0, d1, d2, d3, d4, d5, d6, -⟩ := hder t ht; exact d2)
    (fun t ht => by obtain ⟨d0, d1, d2, d3, d4, d5, d6, ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15⟩⟩ := hder t ht; exact e2)
    (fun t ht => by obtain ⟨d0, d1, d2, d3, d4, d5, d6, ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15⟩⟩ := hder t ht; exact e3)
    (fun t ht => by obtain ⟨d0, d1, d2, d3, d4, d5, d6, ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15⟩⟩ := hder t ht; exact e4)
    (by rw [i2]; exact identity_mem_SO3)

/-- `(«ref.p», «ref.v», «ref.R»)` is an SE₂(3) trajectory: `a = (y t).«ref.a»`, `ω = (y t).«ref.w»`,
`g = ![0, 0, -p.«ref.g»]`. -/
theorem se23_ref_R {p : Params} {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) (h0 : Initial p (x 0)) :
    SpacecraftSolution
      (ofScalars (fun t => (x t).«ref.p») (fun t => (x t).«ref.v») (fun t => (x t).«ref.R»))
      (fun t => (y t).«ref.a») (fun t => (y t).«ref.w») (fun t => ![0, 0, -p.«ref.g»]) T := by
  obtain ⟨dx, c0, c1, c2, c3, c4, c5, c6, hder⟩ := h
  obtain ⟨i0, i1, i2, i3, i4, i5, i6⟩ := h0
  refine spacecraft_of_components
    (dp := fun t => (dx t).«ref.p») (dv := fun t => (dx t).«ref.v»)
    (dR := fun t => (dx t).«ref.R») c3 c4 c5
    (fun t ht => by obtain ⟨d0, d1, d2, d3, d4, d5, d6, -⟩ := hder t ht; exact d3)
    (fun t ht => by obtain ⟨d0, d1, d2, d3, d4, d5, d6, -⟩ := hder t ht; exact d4)
    (fun t ht => by obtain ⟨d0, d1, d2, d3, d4, d5, d6, -⟩ := hder t ht; exact d5)
    (fun t ht => by obtain ⟨d0, d1, d2, d3, d4, d5, d6, ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15⟩⟩ := hder t ht; exact e5)
    (fun t ht => by obtain ⟨d0, d1, d2, d3, d4, d5, d6, ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15⟩⟩ := hder t ht; exact e6)
    (fun t ht => by obtain ⟨d0, d1, d2, d3, d4, d5, d6, ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15⟩⟩ := hder t ht; exact e7)
    (by rw [i5]; exact identity_mem_SO3)

/-- Vehicle and reference feel the same gravity: `![0, 0, -p.«quad.g»] = ![0, 0, -p.«ref.g»]`, so the
gravity term of the log-error field vanishes (`gravity_residual_const`). -/
theorem gravity_eq_quad_R {p : Params} (hp : p.Bound) {x : ℝ → States} (t : ℝ) :
    (fun t => ![0, 0, -p.«quad.g»]) t = (fun t => ![0, 0, -p.«ref.g»]) t := by
  obtain ⟨b0, b1, b2, b3, b4, b5, b6, b7⟩ := hp
  simp only [b0, b1, b2, b3, b4, b5, b6, b7]

