theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7, hb8, hb9, hb10⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hc3, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).e_y) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).v_y) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).e_psi) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).r) (Icc 0 T)
      exact (continuousOn_const.mul hc3)
  · obtain ⟨hd0, hd1, hd2, hd3, ⟨e0, e1, e2, e3, e4⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7, hb8, hb9, hb10, lit0, lit1, lit2, lit3, lit4, lit5, lit6, lit7, lit8, lit9] at e0 e1 e2 e3 e4
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).e_y) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).e_y = (1 : ℝ) * ((1 : ℝ) * (x t).v_y) + (20 : ℝ) * ((1 : ℝ) * (x t).e_psi)
      linear_combination (1 : ℝ) * e1
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).v_y) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).v_y = (-188/25 : ℝ) * ((1 : ℝ) * (x t).e_y) + (-104/15 : ℝ) * ((1 : ℝ) * (x t).v_y) + (-2136/25 : ℝ) * ((1 : ℝ) * (x t).e_psi) + (-1996/75 : ℝ) * ((1 : ℝ) * (x t).r) + (448/3 : ℝ) * ((u t).kappa)
      linear_combination (160/3 : ℝ) * e0 + (1/1500 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).e_psi) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).e_psi = (1 : ℝ) * ((1 : ℝ) * (x t).r) + (-20 : ℝ) * ((u t).kappa)
      linear_combination (1 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).r) _ (Ici t) t
      refine ((hd3.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).r = (-3384/625 : ℝ) * ((1 : ℝ) * (x t).e_y) + (-64/125 : ℝ) * ((1 : ℝ) * (x t).v_y) + (-38448/625 : ℝ) * ((1 : ℝ) * (x t).e_psi) + (-7456/625 : ℝ) * ((1 : ℝ) * (x t).r) + (2688/25 : ℝ) * ((u t).kappa)
      linear_combination (192/5 : ℝ) * e0 + (1/2500 : ℝ) * e4

