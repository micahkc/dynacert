import Rumoca.Prelude

set_option linter.unusedVariables false

namespace LaneKeepingLateral
open Matrix

/-- Parameters and constants. -/
structure Params where
  /-- Vehicle mass [kg] -/
  m : ℝ
  /-- Yaw inertia [kg*m2] -/
  Iz : ℝ
  /-- CG to front axle [m] -/
  a : ℝ
  /-- CG to rear axle [m] -/
  b : ℝ
  /-- Front axle cornering stiffness [N/rad] -/
  Cf : ℝ
  /-- Rear axle cornering stiffness [N/rad] -/
  Cr : ℝ
  /-- Longitudinal speed [m/s] -/
  vx : ℝ
  /-- Lateral offset gain [rad/m] -/
  k_y : ℝ
  /-- Lateral velocity gain [rad*s/m] -/
  k_vy : ℝ
  /-- Heading error gain [rad/rad] -/
  k_psi : ℝ
  /-- Yaw rate gain [rad*s/rad] -/
  k_r : ℝ

/-- Inputs. -/
structure Inputs where
  /-- Road curvature [1/m] -/
  kappa : ℝ

/-- Differentiated variables (also used for their derivatives). -/
structure States where
  /-- Lateral offset [m] -/
  e_y : ℝ
  /-- Lateral velocity [m/s] -/
  v_y : ℝ
  /-- Heading error [rad] -/
  e_psi : ℝ
  /-- Yaw rate [rad/s] -/
  r : ℝ

/-- Algebraic (non-differentiated) variables. -/
structure Algebraics where
  /-- Front steering angle [rad] -/
  delta : ℝ

/-- Modelica names of the parameters and constants, in declaration order. -/
def paramNames : List String := ["m", "Iz", "a", "b", "Cf", "Cr", "vx", "k_y", "k_vy", "k_psi", "k_r"]

/-- Modelica names of the inputs, in declaration order. -/
def inputNames : List String := ["kappa"]

/-- Modelica names of the states, in declaration order. -/
def stateNames : List String := ["e_y", "v_y", "e_psi", "r"]

/-- Modelica names of the algebraic variables and outputs, in declaration order. -/
def algebraicNames : List String := ["delta"]

/-- The parameter bindings of the model. -/
def Params.Bound (p : Params) : Prop :=
  p.m = 1500.0
  ∧ p.Iz = 2500.0
  ∧ p.a = 1.2
  ∧ p.b = 1.6
  ∧ p.Cf = 80000.0
  ∧ p.Cr = 80000.0
  ∧ p.vx = 20.0
  ∧ p.k_y = 0.141
  ∧ p.k_vy = 0.03
  ∧ p.k_psi = 1.602
  ∧ p.k_r = 0.144

/-- Initial conditions: the `fixed = true` start values of the states. -/
def Initial (p : Params) (x : States) : Prop :=
  x.e_y = 0
  ∧ x.v_y = 0
  ∧ x.e_psi = 0
  ∧ x.r = 0

/-- The continuous equations of `LaneKeepingLateral` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.delta = (p.a + p.b) * u.kappa - p.k_y * x.e_y - p.k_vy * x.v_y - p.k_psi * x.e_psi - p.k_r * x.r
  ∧ dx.e_y = x.v_y + p.vx * x.e_psi
  ∧ dx.e_psi = x.r - p.vx * u.kappa
  ∧ p.m * dx.v_y = -((p.Cf + p.Cr) / p.vx * x.v_y) + ((p.b * p.Cr - p.a * p.Cf) / p.vx - p.m * p.vx) * x.r + p.Cf * y.delta
  ∧ p.Iz * dx.r = (p.b * p.Cr - p.a * p.Cf) / p.vx * x.v_y - (p.a * p.a * p.Cf + p.b * p.b * p.Cr) / p.vx * x.r + p.a * p.Cf * y.delta

/-- `x`, `y` is a solution of `LaneKeepingLateral` under input `u`: every state
component has derivative `dx t` at every `t`, and the equations hold. -/
def IsSolution (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) : Prop :=
  ∃ dx : ℝ → States, ∀ t : ℝ,
    HasDerivAt (fun s => (x s).e_y) (dx t).e_y t ∧
    HasDerivAt (fun s => (x s).v_y) (dx t).v_y t ∧
    HasDerivAt (fun s => (x s).e_psi) (dx t).e_psi t ∧
    HasDerivAt (fun s => (x s).r) (dx t).r t ∧
    Equations t p (u t) (x t) (dx t) (y t)

/-- `x`, `y` is a solution of `LaneKeepingLateral` on `[0, T]` under input `u`:
every state component is continuous on `[0, T]` and has right derivative
`dx t` at every `t ∈ [0, T)`, where the equations hold. Right derivatives
admit piecewise-continuous, right-continuous inputs (steps, zero-order hold). -/
def IsSolutionOn (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ) : Prop :=
  ∃ dx : ℝ → States,
    ContinuousOn (fun s => (x s).e_y) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).v_y) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).e_psi) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).r) (Set.Icc 0 T) ∧
    ∀ t ∈ Set.Ico 0 T,
      HasDerivWithinAt (fun s => (x s).e_y) (dx t).e_y (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).v_y) (dx t).v_y (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).e_psi) (dx t).e_psi (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).r) (dx t).r (Set.Ici t) t ∧
      Equations t p (u t) (x t) (dx t) (y t)

/-- A solution on all of `ℝ` is a solution on every `[0, T]`. -/
theorem IsSolution.isSolutionOn {p : Params} {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} (h : IsSolution p u x y) (T : ℝ) : IsSolutionOn p u x y T := by
  obtain ⟨dx, hdx⟩ := h
  exact ⟨dx,
    fun s _ => ((hdx s).1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.2.1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.2.2.1).continuousAt.continuousWithinAt,
    fun t _ => ⟨
      ((hdx t).1).hasDerivWithinAt,
      ((hdx t).2.1).hasDerivWithinAt,
      ((hdx t).2.2.1).hasDerivWithinAt,
      ((hdx t).2.2.2.1).hasDerivWithinAt,
      (hdx t).2.2.2.2⟩⟩

end LaneKeepingLateral
