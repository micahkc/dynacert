set_option linter.style.setOption false
set_option linter.style.longLine false

namespace PlotterXYTracking.Spec

open Set PlotterXYTracking

/-- Admissible disturbances: componentwise peak bounds. -/
def Admissible (u : ℝ → Inputs) (T : ℝ) : Prop :=
  ∀ t ∈ Ico 0 T, |(u t).d 0| ≤ (1 : ℝ) ∧ |(u t).d 1| ≤ (1/2 : ℝ)

/-- Reference signals: continuous on `[0, T]` with the declared right
derivatives on `[0, T)`. -/
def References (u : ℝ → Inputs) (T : ℝ) : Prop :=
  ContinuousOn (fun s => (u s).x_ref 0) (Icc 0 T) ∧
  ContinuousOn (fun s => (u s).x_ref 1) (Icc 0 T) ∧
  ContinuousOn (fun s => (u s).v_ref 0) (Icc 0 T) ∧
  ContinuousOn (fun s => (u s).v_ref 1) (Icc 0 T) ∧
  ∀ t ∈ Ico 0 T, HasDerivWithinAt (fun s => (u s).x_ref 0) ((u t).v_ref 0) (Ici t) t ∧
    HasDerivWithinAt (fun s => (u s).x_ref 1) ((u t).v_ref 1) (Ici t) t ∧
    HasDerivWithinAt (fun s => (u s).v_ref 0) ((u t).a_ref 0) (Ici t) t ∧
    HasDerivWithinAt (fun s => (u s).v_ref 1) ((u t).a_ref 1) (Ici t) t

/-- Reference values at `t = 0`. -/
def ReferenceStart (u : ℝ → Inputs) : Prop :=
  (u 0).x_ref 0 = (0 : ℝ) ∧ (u 0).x_ref 1 = (0 : ℝ) ∧ (u 0).v_ref 0 = (0 : ℝ) ∧ (u 0).v_ref 1 = (0 : ℝ)

/-- **The claim.** Every solution with admissible parameter values, admissible
disturbances, the declared references, and the model's initial condition keeps
`e[1]`, `e[2]`, `ev[1]`, `ev[2]` within the bounds `b`. -/
def Claim (b : Fin 4 → ℚ) : Prop :=
  ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) (T : ℝ),
    p.Bound → IsSolutionOn p u x y T → Admissible u T → References u T →
    ReferenceStart u → Initial p (x 0) →
    (∀ t ∈ Ico 0 T, |(y t).e 0| ≤ (b 0 : ℝ) ∧ |(y t).e 1| ≤ (b 1 : ℝ) ∧ |(y t).ev 0| ≤ (b 2 : ℝ) ∧ |(y t).ev 1| ≤ (b 3 : ℝ))

end PlotterXYTracking.Spec
