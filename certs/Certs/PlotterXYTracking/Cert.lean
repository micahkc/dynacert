    (ht : t ∈ Ico 0 T) :
    (y t).ev 1 = (fun i => ((![0, 0, 0, 1] : Fin 4 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![0, 0, 0, 1] : Fin 4 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).v 1 + (-1 : ℝ) * (u t).v_ref 1) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  obtain ⟨hb0, hb1, hb2, hb3⟩ := hp
  obtain ⟨dx, hder⟩ := h
  have hE := (hder.2.2 t ht).2.2
  obtain ⟨eq0, eq1, eq2, eq3, eq4⟩ := hE
  have e0 := (congrFun eq0 0)
  have e1 := (congrFun eq0 1)
  have e2 := (congrFun eq1 0)
  have e3 := (congrFun eq1 1)
  have e4 := (congrFun eq2 0)
  have e5 := (congrFun eq2 1)
  have e6 := (congrFun eq3 0)
  have e7 := (congrFun eq3 1)
  have e8 := (congrFun eq4 0)
  have e9 := (congrFun eq4 1)
  try simp only [hb0, hb1, hb2, hb3, lit0, lit1, lit2, lit3, lit4, lit5, Matrix.mulVec, Matrix.vecMul, dotProduct, Fin.sum_univ_succ, Fin.sum_univ_zero, Matrix.of_apply, Matrix.cons_val, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_succ, Pi.add_apply, Pi.sub_apply, Pi.neg_apply, Pi.smul_apply, smul_eq_mul, Matrix.add_apply, Matrix.sub_apply, Matrix.neg_apply, Matrix.smul_apply, Matrix.transpose_apply, Matrix.mul_apply, Fin.isValue, Rumoca.slice, Rumoca.at1, Rumoca.at2, Rumoca.skew, Fin.succ_zero_eq_one, Fin.succ_one_eq_two, fin_succ_eq_mk, Fin.val_succ, Fin.val_zero, Fin.coe_ofNat_eq_mod, Nat.reduceMod, Nat.reduceSub, Nat.reduceAdd, Nat.reduceMul, Nat.one_le_ofNat, Nat.reduceLeDiff, and_self, dite_true, le_refl, fin_mk_ofNat, Pi.zero_apply, Matrix.zero_apply, cross_apply] at e0 e1 e2 e3 e4 e5 e6 e7 e8 e9
  linear_combination (1 : ℝ) * e3

/-- **Tube.** Under the hypotheses of `Spec.Claim`, the error-frame state
`z = vec (x t) (u t)` (coordinates `e[1]`, `e[2]`, `ev[1]`, `ev[2]`) stays in the certified ellipsoid
`zᵀ P z ≤ level` on `[0, T]`. With a reference trajectory this is a tube around it:
the physical state lies in the reference plus this ellipsoid. -/
theorem tube : ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ), p.Bound → IsSolutionOn p u x y T → Spec.Admissible u T →
    Spec.References u T → Spec.ReferenceStart u → Initial p (x 0) →
    ∀ t ∈ Icc 0 T, quad (toReal P) (vec (x t) (u t)) ≤ (level : ℝ) := by
  intro p u x y T hp h hu hr hr0 h0
  have hx := link hp h hr
  have hw : ∀ t ∈ Ico 0 T, cert.energy (dist (u t)) ≤
      ∑ j, (γ j : ℝ) * ((δ j : ℝ) * (δ j : ℝ)) := by
    intro t ht
    have hut := hu t ht
    refine cert.energy_le_of_abs_le (δ := δ) fun j => ?_
    fin_cases j <;> simp [dist, δ] <;> simp_all
  have h0' : quad (toReal cert.P) (vec (x 0) (u 0)) ≤ (level : ℝ) := by
    rw [init hp h0 hr0]; exact init_le
  exact cert.invariant hx hw h0' budget_le

/-- **Certified.** The claim of `Spec.lean` holds with the bounds `![250/3281, 540/9337, 2018/9235, 1616/7323]`. -/
theorem certified : Spec.Claim ![250/3281, 540/9337, 2018/9235, 1616/7323] := by
  intro p u x y T hp h hu hr hr0 h0
  have hV := tube p u x y T hp h hu hr hr0 h0
  intro t ht
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [out0 hp h ht]; exact box0.abs_le (hV t ⟨ht.1, ht.2.le⟩)
  · rw [out1 hp h ht]; exact box1.abs_le (hV t ⟨ht.1, ht.2.le⟩)
  · rw [out2 hp h ht]; exact box2.abs_le (hV t ⟨ht.1, ht.2.le⟩)
  · rw [out3 hp h ht]; exact box3.abs_le (hV t ⟨ht.1, ht.2.le⟩)

end PlotterXYTracking.Cert
