theorem f_apply (z : Fin 4 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(-9/5 : ℝ) * (z 0) + (-3/5 : ℝ) * (z 1) + (1 : ℝ) * (w 0), (-6/5 : ℝ) * (z 1) + (39/5 : ℝ) * (z 2), (5 : ℝ) * (z 0) + (-27/5 : ℝ) * (z 2) + (5/2 : ℝ) * (z 3), (1 : ℝ) * (z 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

