theorem out2 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Ico 0 T) :
    (y t).dTc = (fun i => ((![0, -2, -1] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![0, -2, -1] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (-2 : ℝ) * ((1 : ℝ) * (x t).dT) + (-1 : ℝ) * ((1 : ℝ) * (x t).z) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7⟩ := hp
  obtain ⟨dx, hder⟩ := h
  have hE := (hder.2.2.2 t ht).2.2.2
  obtain ⟨e0, e1, e2, e3⟩ := hE
  try simp only [hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7, lit0, lit1, lit2, lit3, lit4, lit5, lit6] at e0 e1 e2 e3
  linear_combination (1 : ℝ) * e0

/-- **Tube.** Under the hypotheses of `Spec.Claim`, the error-frame state
`z = vec (x t) (u t)` (coordinates `dCa`, `dT`, `z`) stays in the certified ellipsoid
`zᵀ P z ≤ level` on `[0, T]`. With a reference trajectory this is a tube around it:
the physical state lies in the reference plus this ellipsoid. -/
theorem tube : ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ), p.Bound → IsSolutionOn p u x y T → Spec.Admissible u T →
    Spec.References u T → Spec.ReferenceStart u → Initial p (x 0) →
    ∀ t ∈ Icc 0 T, quad (toReal P) (vec (x t) (u t)) ≤ (level : ℝ) := by
  intro p u x y T hp h hu hr hr0 h0
  have hx := link hp h hr
  have hw : ∀ t ∈ Ico 0 T, cert.energy (dist (u t)) ≤
      ∑ j, (γ j : ℝ) * ((δ j : ℝ) * (δ j : ℝ)) := by
    intro t ht
    have hut := hu t ht
    refine cert.energy_le_of_abs_le (δ := δ) fun j => ?_
    fin_cases j <;> simp [dist, δ] <;> simp_all
  have h0' : quad (toReal cert.P) (vec (x 0) (u 0)) ≤ (level : ℝ) := by
    rw [init hp h0 hr0]; exact init_le
  exact cert.invariant hx hw h0' budget_le

/-- **Certified.** The claim of `Spec.lean` holds with the bounds `![494/2403, 747/215, 67959/9410]`. -/
theorem certified : Spec.Claim ![494/2403, 747/215, 67959/9410] := by
  intro p u x y T hp h hu hr hr0 h0
  have hV := tube p u x y T hp h hu hr hr0 h0
  refine ⟨?_, ?_⟩
  · intro t ht
    refine ⟨?_, ?_⟩
    · rw [out0 hp h ht]; exact box0.abs_le (hV t ht)
    · rw [out1 hp h ht]; exact box1.abs_le (hV t ht)
  · intro t ht
    rw [out2 hp h ht]; exact box2.abs_le (hV t ⟨ht.1, ht.2.le⟩)

