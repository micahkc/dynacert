/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `dCa`, `dT`, `z`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.dCa, (1 : ℝ) * s.dT, (1 : ℝ) * s.z]
/-- Disturbance channels: `dTf`, `dCaf`. -/
def dist (v : Inputs) : Fin 2 → ℝ := ![v.dTf, v.dCaf]

def model : LTIModel 3 2 where
  A := !![-57/50, -51/5000, 0; 2927/100, -51419/10000, -523/250; 0, 1, 0]
  B := !![0, 1; 1, 0; 0, 0]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 2 → ℝ) :
    model.toSystem.f z w = ![(-57/50 : ℝ) * (z 0) + (-51/5000 : ℝ) * (z 1) + (1 : ℝ) * (w 1), (2927/100 : ℝ) * (z 0) + (-51419/10000 : ℝ) * (z 1) + (-523/250 : ℝ) * (z 2) + (1 : ℝ) * (w 0), (1 : ℝ) * (z 1)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

