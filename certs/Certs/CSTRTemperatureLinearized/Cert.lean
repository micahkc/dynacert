theorem lit1 : (0.0102 : ℝ) = 51/5000 := by norm_num
theorem lit2 : (29.27 : ℝ) = 2927/100 := by norm_num
theorem lit3 : (0.9579 : ℝ) = 9579/10000 := by norm_num
theorem lit4 : (2.092 : ℝ) = 523/250 := by norm_num
theorem lit5 : (1.0 : ℝ) = 1 := by norm_num
