theorem init {p : Params} (hp : p.Bound) {s : States} {v : Inputs} (h0 : Initial p s)
    (hr0 : True) :
    vec s v = fun i => (((![0, 0, 0] : Fin 3 → ℚ) i : ℚ) : ℝ) := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7⟩ := hp
  obtain ⟨i0, i1, i2⟩ := h0
  funext i
  fin_cases i <;>
    simp [vec, hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7, lit0, lit1, lit2, lit3, lit4, lit5, lit6, i0, i1, i2] <;> norm_num

theorem init_le :
    quad (toReal P) (fun i => (((![0, 0, 0] : Fin 3 → ℚ) i : ℚ) : ℝ)) ≤ (level : ℝ) := by
  rw [quad_toReal_cast]
  exact_mod_cast (by decide +kernel : quad P ![0, 0, 0] ≤ level)

theorem out0 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Icc 0 T) :
    (x t).dCa = (fun i => ((![1, 0, 0] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![1, 0, 0] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).dCa) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  ring

