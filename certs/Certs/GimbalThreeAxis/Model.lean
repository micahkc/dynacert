  obtain ⟨dx, hdx⟩ := h
  exact ⟨dx,
    fun i s _ => ((hdx s).1 i).continuousAt.continuousWithinAt,
    fun i s _ => ((hdx s).2.1 i).continuousAt.continuousWithinAt,
    fun t _ => ⟨
      fun i => ((hdx t).1 i).hasDerivWithinAt,
      fun i => ((hdx t).2.1 i).hasDerivWithinAt,
      (hdx t).2.2⟩⟩

