/-- The continuous equations of `GimbalThreeAxis` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  dx.th = x.w
  ∧ (∀ i : Fin 3, dx.w i = -(p.K *ᵥ x.th) i - p.c i * x.w i + u.d i)

/-- `x`, `y` is a solution of `GimbalThreeAxis` under input `u`: every state
