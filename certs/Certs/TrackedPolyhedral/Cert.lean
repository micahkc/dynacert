/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `e`, `ev`. -/
def vec (s : States) (v : Inputs) : Fin 2 → ℝ :=
  ![(1 : ℝ) * s.x + (-1 : ℝ) * v.x_ref, (1 : ℝ) * s.v + (-1 : ℝ) * v.v_ref]
/-- Disturbance channels: `d`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.d]

def model : LTIModel 2 1 where
  A := !![0, 1; -6, -5]
  B := !![0; 1]

theorem f_apply (z : Fin 2 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(1 : ℝ) * (z 1), (-6 : ℝ) * (z 0) + (-5 : ℝ) * (z 1) + (1 : ℝ) * (w 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (6.0 : ℝ) = 6 := by norm_num
theorem lit1 : (5.0 : ℝ) = 5 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1⟩ := hp
  obtain ⟨dx, hc0, hc1, hder⟩ := h
  obtain ⟨hrc0, hrc1, hrder⟩ := hr
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).x + (-1 : ℝ) * (u s).x_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc0)).add (continuousOn_const.mul hrc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).v + (-1 : ℝ) * (u s).v_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc1)).add (continuousOn_const.mul hrc1)
  · obtain ⟨hd0, hd1, ⟨e0, e1, e2, e3⟩⟩ := hder t ht
    obtain ⟨hrd0, hrd1⟩ := hrder t ht
    try simp only [hb0, hb1, lit0, lit1] at e0 e1 e2 e3
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).x + (-1 : ℝ) * (u s).x_ref) _ (Ici t) t
      refine (((hd0.const_mul (1 : ℝ))).add (hrd0.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).x + (-1 : ℝ) * (u t).v_ref = (1 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref)
      linear_combination (1 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).v + (-1 : ℝ) * (u s).v_ref) _ (Ici t) t
      refine (((hd1.const_mul (1 : ℝ))).add (hrd1.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).v + (-1 : ℝ) * (u t).a_ref = (-6 : ℝ) * ((1 : ℝ) * (x t).x + (-1 : ℝ) * (u t).x_ref) + (-5 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref) + (1 : ℝ) * ((u t).d)
      linear_combination (-6 : ℝ) * e0 + (-5 : ℝ) * e1 + (1 : ℝ) * e3

/-! ### Storage function `V z = zᵀ P z` and per-channel rates -/

def P : Matrix (Fin 2) (Fin 2) ℚ := !![3999495/939323, 565876/677373; 565876/677373, 240743/198270]
def α : ℚ := 157105/114173
def γ : Fin 1 → ℚ := ![120892/720907]

def lmiL : Matrix (Fin 2 ⊕ Fin 1) (Fin 2 ⊕ Fin 1) ℚ :=
  fromBlocks !![1, 4845059968376730271102/3333465774412981448595; 0, 1] !![-60687555461229004/302629666310756373; -53889165828666628239124468260494665/564186314974549948524689716725333557]
      !![0, 0] !![1]
def lmiD : Fin 2 ⊕ Fin 1 → ℚ :=
  Sum.elim ![100876555436918791/24215029149754289, 564186314974549948524689716725333557/172089770212598978088435987775503876312450] ![278601693240548470460007929096534404124830747/1653030711114247530443162000857148440562853871362]

def cert : ChannelCert model :=
  ⟨P, α, γ, by decide +kernel, by decide +kernel, by decide +kernel,
    ⟨lmiL, lmiD, by decide +kernel, by decide +kernel⟩⟩

/-- Invariant level `max(Σγⱼδⱼ²/α, V(z₀))`. -/
def level : ℚ := 13802602316/113258094235
def δ : Fin 1 → ℚ := ![1]

theorem budget_le :
    (∑ j, (γ j : ℝ) * ((δ j : ℝ) * (δ j : ℝ))) / (α : ℝ) ≤ (level : ℝ) := by
  have h : (∑ j, γ j * (δ j * δ j)) / α ≤ level := by decide +kernel
  exact_mod_cast h

/-- `|e| ≤ 1123/6173` on `{zᵀPz ≤ level}`. -/
def box0 : LinearBoxCert P level ![1, 0] (1123/6173) :=
  ⟨by decide +kernel, by decide +kernel,
    ⟨!![1, 6901957940075795514605107420/4754720541344491679055893079; 0, 1],
     ![7019353504412622999523/368539527620263169965795, 138995879408140769847756963568213282101661/2703708890956013621230467899487731699256481290],
     by decide +kernel, by decide +kernel⟩⟩

/-- `|ev| ≤ 480/1409` on `{zᵀPz ≤ level}`. -/
def box1 : LinearBoxCert P level ![0, 1] (480/1409) :=
  ⟨by decide +kernel, by decide +kernel,
    ⟨!![1, 531540341948/2709149926635; 0, 1],
     ![921483648000/1864820104763, 492146626086043750308995018452628/20200128903870529721314486013369200995],
