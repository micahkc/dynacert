/-! ### Modes

The if-expressions of `Equations`, grouped into switches by their condition chain; a mode
picks one branch of every switch. In mode `m` the model, in coordinates `z`, is
`ż = A_m z + B w`:

* mode 0: `|x.z| < 0.1`
* mode 1: `¬(|x.z| < 0.1) ∧ |x.z| < 0.2`
* mode 2: `¬(|x.z| < 0.1) ∧ ¬(|x.z| < 0.2)`
-/

/-- Coordinates: `w`, `z`. -/
def vec (s : States) (v : Inputs) : Fin 2 → ℝ :=
  ![(1 : ℝ) * s.w, (1 : ℝ) * s.z]
/-- Disturbance channels: `d`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.d]

/-- Mode matrices `A_m`. -/
def As : Fin 3 → Matrix (Fin 2) (Fin 2) ℚ :=
  ![!![-9, -1; 1, 0],
    !![-7, -1; 1, 0],
    !![-5, -1; 1, 0]]
def Bm : Matrix (Fin 2) (Fin 1) ℚ := !![1; 0]

/-- Indicator of the active mode, written with the model's own conditions (verbatim
from `Equations`, same binders). -/
noncomputable def weights (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Fin 3 → ℝ :=
  ![(if |x.z| < 0.1 then (1 : ℝ) else if |x.z| < 0.2 then (0 : ℝ) else (0 : ℝ)),
    (if |x.z| < 0.1 then (0 : ℝ) else if |x.z| < 0.2 then (1 : ℝ) else (0 : ℝ)),
    (if |x.z| < 0.1 then (0 : ℝ) else if |x.z| < 0.2 then (0 : ℝ) else (1 : ℝ))]

theorem weights_nonneg (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : ∀ i, 0 ≤ weights t p u x dx y i := by
  intro i
  fin_cases i
  · show (0 : ℝ) ≤ (if |x.z| < 0.1 then (1 : ℝ) else if |x.z| < 0.2 then (0 : ℝ) else (0 : ℝ))
    split_ifs <;> norm_num
  · show (0 : ℝ) ≤ (if |x.z| < 0.1 then (0 : ℝ) else if |x.z| < 0.2 then (1 : ℝ) else (0 : ℝ))
    split_ifs <;> norm_num
  · show (0 : ℝ) ≤ (if |x.z| < 0.1 then (0 : ℝ) else if |x.z| < 0.2 then (0 : ℝ) else (1 : ℝ))
    split_ifs <;> norm_num

theorem weights_sum (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : ∑ i, weights t p u x dx y i = 1 := by
  have h : (if |x.z| < 0.1 then (1 : ℝ) else if |x.z| < 0.2 then (0 : ℝ) else (0 : ℝ)) + (if |x.z| < 0.1 then (0 : ℝ) else if |x.z| < 0.2 then (1 : ℝ) else (0 : ℝ)) + (if |x.z| < 0.1 then (0 : ℝ) else if |x.z| < 0.2 then (0 : ℝ) else (1 : ℝ)) = 1 := by
    split_ifs <;> norm_num
  simpa [weights, Fin.sum_univ_succ, add_assoc] using h

theorem f_apply (wt : Fin 3 → ℝ) (z : Fin 2 → ℝ) (w : Fin 1 → ℝ) :
    (∑ i, wt i • toReal (As i)) *ᵥ z + toReal Bm *ᵥ w = ![wt 0 * ((-9 : ℝ) * (z 0) + (-1 : ℝ) * (z 1)) + wt 1 * ((-7 : ℝ) * (z 0) + (-1 : ℝ) * (z 1)) + wt 2 * ((-5 : ℝ) * (z 0) + (-1 : ℝ) * (z 1)) + (1 : ℝ) * (w 0), wt 0 * ((1 : ℝ) * (z 0)) + wt 1 * ((1 : ℝ) * (z 0)) + wt 2 * ((1 : ℝ) * (z 0))] := by
  funext i
  fin_cases i <;>
    simp [As, Bm, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (8.0 : ℝ) = 8 := by norm_num
theorem lit1 : (6.0 : ℝ) = 6 := by norm_num
theorem lit2 : (4.0 : ℝ) = 4 := by norm_num
theorem lit3 : (1.0 : ℝ) = 1 := by norm_num
theorem lit4 : (0.1 : ℝ) = 1/10 := by norm_num
theorem lit5 : (0.2 : ℝ) = 1/5 := by norm_num

/-- **Pointwise link.** At one instant, the model's equations give each coordinate
derivative as the active mode's linear right-hand side. The `if`-expressions of the
equations and of `weights` are split together. -/
theorem step {t : ℝ} {p : Params} {u : Inputs} {x dx : States} {y : Algebraics} (hp : p.Bound)
    (h : Equations t p u x dx y) :
    (1 : ℝ) * dx.w = (weights t p u x dx y 0) * ((-9 : ℝ) * ((1 : ℝ) * x.w) + (-1 : ℝ) * ((1 : ℝ) * x.z)) + (weights t p u x dx y 1) * ((-7 : ℝ) * ((1 : ℝ) * x.w) + (-1 : ℝ) * ((1 : ℝ) * x.z)) + (weights t p u x dx y 2) * ((-5 : ℝ) * ((1 : ℝ) * x.w) + (-1 : ℝ) * ((1 : ℝ) * x.z)) + (1 : ℝ) * (u.d) ∧
    (1 : ℝ) * dx.z = (weights t p u x dx y 0) * ((1 : ℝ) * ((1 : ℝ) * x.w)) + (weights t p u x dx y 1) * ((1 : ℝ) * ((1 : ℝ) * x.w)) + (weights t p u x dx y 2) * ((1 : ℝ) * ((1 : ℝ) * x.w)) := by
  obtain ⟨hb0, hb1, hb2, hb3⟩ := hp
  obtain ⟨e0, e1, e2⟩ := h
  show (1 : ℝ) * dx.w = ((if |x.z| < 0.1 then (1 : ℝ) else if |x.z| < 0.2 then (0 : ℝ) else (0 : ℝ))) * ((-9 : ℝ) * ((1 : ℝ) * x.w) + (-1 : ℝ) * ((1 : ℝ) * x.z)) + ((if |x.z| < 0.1 then (0 : ℝ) else if |x.z| < 0.2 then (1 : ℝ) else (0 : ℝ))) * ((-7 : ℝ) * ((1 : ℝ) * x.w) + (-1 : ℝ) * ((1 : ℝ) * x.z)) + ((if |x.z| < 0.1 then (0 : ℝ) else if |x.z| < 0.2 then (0 : ℝ) else (1 : ℝ))) * ((-5 : ℝ) * ((1 : ℝ) * x.w) + (-1 : ℝ) * ((1 : ℝ) * x.z)) + (1 : ℝ) * (u.d) ∧
    (1 : ℝ) * dx.z = ((if |x.z| < 0.1 then (1 : ℝ) else if |x.z| < 0.2 then (0 : ℝ) else (0 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * x.w)) + ((if |x.z| < 0.1 then (0 : ℝ) else if |x.z| < 0.2 then (1 : ℝ) else (0 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * x.w)) + ((if |x.z| < 0.1 then (0 : ℝ) else if |x.z| < 0.2 then (0 : ℝ) else (1 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * x.w))
  split_ifs at e0 ⊢ <;>
    (try simp only [hb0, hb1, hb2, hb3, lit0, lit1, lit2, lit3, lit4, lit5] at e0 e1 e2) <;>
    exact ⟨by first | linear_combination (1 : ℝ) * e0 + (1 : ℝ) * e1,
      by first | linear_combination (1 : ℝ) * e2⟩

/-- **Link.** Along a solution, the coordinates obey `ż = Σ_m wt t m • (A_m z + B w)`
with `wt t` the indicator of the mode active at `t`. -/
theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    ∃ wt : ℝ → Fin 3 → ℝ, (∀ t ∈ Ico 0 T, ∀ i, 0 ≤ wt t i) ∧
      (∀ t ∈ Ico 0 T, ∑ i, wt t i = 1) ∧
      ContinuousOn (fun t => vec (x t) (u t)) (Icc 0 T) ∧ ∀ t ∈ Ico 0 T,
        HasDerivWithinAt (fun t => vec (x t) (u t))
          ((∑ i, wt t i • toReal (As i)) *ᵥ vec (x t) (u t) + toReal Bm *ᵥ dist (u t))
          (Ici t) t := by
  obtain ⟨dx, hc0, hc1, hder⟩ := h
  refine ⟨fun t => weights t p (u t) (x t) (dx t) (y t), fun t _ => weights_nonneg t p (u t) (x t) (dx t) (y t),
    fun t _ => weights_sum t p (u t) (x t) (dx t) (y t), ?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).w) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).z) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
  · obtain ⟨hd0, hd1, hE⟩ := hder t ht
    obtain ⟨s0, s1⟩ := step hp hE
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).w) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).w = (weights t p (u t) (x t) (dx t) (y t) 0) * ((-9 : ℝ) * ((1 : ℝ) * (x t).w) + (-1 : ℝ) * ((1 : ℝ) * (x t).z)) + (weights t p (u t) (x t) (dx t) (y t) 1) * ((-7 : ℝ) * ((1 : ℝ) * (x t).w) + (-1 : ℝ) * ((1 : ℝ) * (x t).z)) + (weights t p (u t) (x t) (dx t) (y t) 2) * ((-5 : ℝ) * ((1 : ℝ) * (x t).w) + (-1 : ℝ) * ((1 : ℝ) * (x t).z)) + (1 : ℝ) * ((u t).d)
      exact s0
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).z) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).z = (weights t p (u t) (x t) (dx t) (y t) 0) * ((1 : ℝ) * ((1 : ℝ) * (x t).w)) + (weights t p (u t) (x t) (dx t) (y t) 1) * ((1 : ℝ) * ((1 : ℝ) * (x t).w)) + (weights t p (u t) (x t) (dx t) (y t) 2) * ((1 : ℝ) * ((1 : ℝ) * (x t).w))
      exact s1

