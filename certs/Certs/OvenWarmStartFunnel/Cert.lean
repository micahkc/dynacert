/-- Invariant level `max(Σγⱼδⱼ²/α, V(z₀))`. -/
def level : ℚ := 209519083966258171/7097845760592485
def δ : Fin 1 → ℚ := ![1/10]

theorem budget_le :
    (∑ j, (γ j : ℝ) * ((δ j : ℝ) * (δ j : ℝ))) / (α : ℝ) ≤ (level : ℝ) := by
  have h : (∑ j, γ j * (δ j * δ j)) / α ≤ level := by decide +kernel
  exact_mod_cast h

/-- `|T| ≤ 10023/4145` on `{zᵀPz ≤ level}`. -/
def box0 : LinearBoxCert P level ![1, 0] (10023/4145) :=
