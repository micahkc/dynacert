/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `T`, `xi`. -/
def vec (s : States) (v : Inputs) : Fin 2 → ℝ :=
  ![(1 : ℝ) * s.T, (1 : ℝ) * s.xi]
/-- Disturbance channels: `d`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.d]

def model : LTIModel 2 1 where
  A := !![-3/5, -1/20; 1, 0]
  B := !![1; 0]

theorem f_apply (z : Fin 2 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(-3/5 : ℝ) * (z 0) + (-1/20 : ℝ) * (z 1) + (1 : ℝ) * (w 0), (1 : ℝ) * (z 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (0.1 : ℝ) = 1/10 := by norm_num
theorem lit1 : (0.5 : ℝ) = 1/2 := by norm_num
theorem lit2 : (0.05 : ℝ) = 1/20 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2⟩ := hp
  obtain ⟨dx, hc0, hc1, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).T) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).xi) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
  · obtain ⟨hd0, hd1, ⟨e0, e1⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, lit0, lit1, lit2] at e0 e1
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).T) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).T = (-3/5 : ℝ) * ((1 : ℝ) * (x t).T) + (-1/20 : ℝ) * ((1 : ℝ) * (x t).xi) + (1 : ℝ) * ((u t).d)
      linear_combination (1 : ℝ) * e0
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).xi) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).xi = (1 : ℝ) * ((1 : ℝ) * (x t).T)
      linear_combination (1 : ℝ) * e1

/-! ### Storage function `V z = zᵀ P z` and per-channel rates -/

def P : Matrix (Fin 2) (Fin 2) ℚ := !![368231/61445, 641175/594469; 641175/594469, 1197959/971585]
def α : ℚ := 14582/429623
def γ : Fin 1 → ℚ := ![6295703/110992]

def lmiL : Matrix (Fin 2 ⊕ Fin 1) (Fin 2 ⊕ Fin 1) ℚ :=
