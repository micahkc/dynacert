/-! ### Initial set: `z₀ = c₀ + G₀ e` with `|eᵢ| ≤ ρ₀ᵢ` (the `initialSet` box) -/

def c₀ : Fin 2 → ℚ := ![0, 0]
def G₀ : Matrix (Fin 2) (Fin 2) ℚ := !![1, 0; 0, 1]
def ρ₀ : Fin 2 → ℚ := ![2, 1]

theorem P_symm : Pᵀ = P := by decide +kernel

/-- Bound on `zᵀPz` over the initial set (`boxBound`). -/
def V0 : ℚ := 209519083966258171/7097845760592485

theorem init_box : boxBound P c₀ G₀ ρ₀ ≤ V0 := by decide +kernel

theorem V0_le : V0 ≤ level := by decide +kernel

theorem init {p : Params} (hp : p.Bound) {s : States} {v : Inputs}
    (h0 : Spec.InitialSet p s) (hr0 : True) :
    ∃ e : Fin 2 → ℝ, (∀ i, |e i| ≤ ((ρ₀ i : ℚ) : ℝ)) ∧
      vec s v = fun i => ((c₀ i : ℚ) : ℝ) + (toReal G₀ *ᵥ e) i := by
  obtain ⟨hb0, hb1, hb2⟩ := hp
  obtain ⟨l0, u0, l1, u1⟩ := h0
  refine ⟨![s.T - (0 : ℝ), s.xi - (0 : ℝ)], fun i => ?_, ?_⟩
  · fin_cases i <;> simp [ρ₀] <;> rw [abs_le] <;> constructor <;> linarith
  · funext i
    fin_cases i <;>
      simp [vec, c₀, G₀, toReal, mulVec, dotProduct, Fin.sum_univ_succ, hb0, hb1, hb2, lit0, lit1, lit2] <;> ring

theorem init_V0 {p : Params} (hp : p.Bound) {s : States} {v : Inputs}
    (h0 : Spec.InitialSet p s) (hr0 : True) :
    quad (toReal P) (vec s v) ≤ (V0 : ℝ) := by
  obtain ⟨e, he, hz⟩ := init hp h0 hr0
  rw [hz]
  exact quad_le_boxBound P_symm init_box e he

theorem out0 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Icc 0 T) :
    (x t).T = (fun i => ((![1, 0] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![1, 0] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).T) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  ring

/-- **Tube.** Under the hypotheses of `Spec.Claim`, the error-frame state
`z = vec (x t) (u t)` (coordinates `T`, `xi`) stays in the certified ellipsoid
`zᵀ P z ≤ level` on `[0, T]`. With a reference trajectory this is a tube around it:
the physical state lies in the reference plus this ellipsoid. -/
theorem tube : ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ), p.Bound → IsSolutionOn p u x y T → Spec.Admissible u T →
    Spec.References u T → Spec.ReferenceStart u → Spec.InitialSet p (x 0) →
    ∀ t ∈ Icc 0 T, quad (toReal P) (vec (x t) (u t)) ≤ (level : ℝ) := by
  intro p u x y T hp h hu hr hr0 h0
  have hx := link hp h hr
  have hw : ∀ t ∈ Ico 0 T, cert.energy (dist (u t)) ≤
      ∑ j, (γ j : ℝ) * ((δ j : ℝ) * (δ j : ℝ)) := by
    intro t ht
    have hut := hu t ht
    refine cert.energy_le_of_abs_le (δ := δ) fun j => ?_
    fin_cases j <;> simp [dist, δ] <;> simp_all
  have h0' : quad (toReal cert.P) (vec (x 0) (u 0)) ≤ (level : ℝ) := by
    exact (init_V0 hp h0 hr0).trans (by exact_mod_cast V0_le)
  exact cert.invariant hx hw h0' budget_le

/-- **Certified.** The claim of `Spec.lean` holds with the bounds `![10023/4145]`. -/
theorem certified : Spec.Claim ![10023/4145] := by
  intro p u x y T hp h hu hr hr0 h0
  have hV := tube p u x y T hp h hu hr hr0 h0
  intro t ht
  rw [out0 hp h ht]; exact box0.abs_le (hV t ht)

/-- The disturbance budget `Σⱼ γⱼ δⱼ²`. -/
theorem budget_eq :
    ∑ j, (γ j : ℝ) * ((δ j : ℝ) * (δ j : ℝ)) = ((6295703/11099200 : ℚ) : ℝ) := by
  have h : ∑ j, γ j * (δ j * δ j) = 6295703/11099200 := by decide +kernel
  exact_mod_cast h

/-- **Funnel.** Under the hypotheses of `Spec.Claim`, the storage of the error-frame
state `z = vec (x t) (u t)` (coordinates `T`, `xi`) obeys the shrinking bound
`zᵀPz ≤ V₀ e^{-αt} + (γμ/α)(1 - e^{-αt})` on `[0, T]`: `V₀` bounds `zᵀPz` on the
initial set, `α` is the decay rate and `γμ/α = Σⱼγⱼδⱼ²/α` the asymptotic level. -/
theorem funnel : ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ), p.Bound → IsSolutionOn p u x y T → Spec.Admissible u T →
    Spec.References u T → Spec.ReferenceStart u → Spec.InitialSet p (x 0) →
    ∀ t ∈ Icc 0 T, quad (toReal P) (vec (x t) (u t)) ≤
      ((209519083966258171/7097845760592485 : ℚ) : ℝ) * Real.exp (-((14582/429623 : ℚ) : ℝ) * t) + ((2704778809969/161848534400 : ℚ) : ℝ) * (1 - Real.exp (-((14582/429623 : ℚ) : ℝ) * t)) := by
  intro p u x y T hp h hu hr hr0 h0
  have hx := link hp h hr
  have hw : ∀ t ∈ Ico 0 T, cert.energy (dist (u t)) ≤ ((6295703/11099200 : ℚ) : ℝ) := by
    intro t ht
    have hut := hu t ht
    refine (cert.energy_le_of_abs_le (δ := δ) fun j => ?_).trans_eq budget_eq
    fin_cases j <;> simp [dist, δ] <;> simp_all
  exact cert.funnel hx hw (init_V0 hp h0 hr0) (by decide +kernel)

