  x.x = 0
  ∧ x.v = 0
  ∧ x.xi = 0
  ∧ x.q = 0
  ∧ x.qd = 0

/-- The continuous equations of `WaferStageScan` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.e = x.x - u.x_ref
  ∧ y.ev = x.v - u.v_ref
  ∧ y.ei = x.xi
  ∧ y.F = p.m * u.a_ref / 1000000.0 - p.kp * y.e - p.kd * y.ev - p.ki * x.xi
  ∧ y.a_f = -(p.wn ^ 2 * x.q) - 2 * p.zf * p.wn * x.qd
  ∧ dx.xi = p.wi * y.e
  ∧ dx.x = x.v
  ∧ dx.v = 1000000.0 * (y.F + u.F_rip) / p.m - y.a_f
  ∧ dx.q = x.qd
  ∧ dx.qd = y.a_f - u.a_floor

/-- `x`, `y` is a solution of `WaferStageScan` under input `u`: every state
