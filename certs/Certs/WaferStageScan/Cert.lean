theorem init {p : Params} (hp : p.Bound) {s : States} {v : Inputs} (h0 : Initial p s)
    (hr0 : v.x_ref = (0 : ℝ) ∧ v.v_ref = (0 : ℝ)) :
    vec s v = fun i => (((![0, 0, 0, 0, 0] : Fin 5 → ℚ) i : ℚ) : ℝ) := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5, hb6⟩ := hp
  obtain ⟨i0, i1, i2, i3, i4⟩ := h0
  obtain ⟨r0, r1⟩ := hr0
  funext i
  fin_cases i <;>
    simp [vec, hb0, hb1, hb2, hb3, hb4, hb5, hb6, lit0, lit1, lit2, lit3, lit4, lit5, lit6, lit7, i0, i1, i2, i3, i4, r0, r1] <;> norm_num

theorem init_le :
    quad (toReal P) (fun i => (((![0, 0, 0, 0, 0] : Fin 5 → ℚ) i : ℚ) : ℝ)) ≤ (level : ℝ) := by
  rw [quad_toReal_cast]
  exact_mod_cast (by decide +kernel : quad P ![0, 0, 0, 0, 0] ≤ level)

