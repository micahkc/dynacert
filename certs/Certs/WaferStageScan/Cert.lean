    (ht : t ∈ Icc 0 T) :
    (x t).q = (fun i => ((![1, 0, 0, 0, 0] : Fin 5 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![1, 0, 0, 0, 0] : Fin 5 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
