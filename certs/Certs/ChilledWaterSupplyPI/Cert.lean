theorem f_apply (z : Fin 4 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(-2/3 : ℝ) * (z 0) + (2/3 : ℝ) * (z 1) + (-1/300 : ℝ) * (z 2), (2/15 : ℝ) * (z 0) + (-2/15 : ℝ) * (z 1) + (1/1500 : ℝ) * (w 0), (150 : ℝ) * (z 0) + (-1/2 : ℝ) * (z 2) + (50 : ℝ) * (z 3), (1 : ℝ) * (z 0)] := by
