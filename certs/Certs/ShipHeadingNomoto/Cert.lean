theorem init {p : Params} (hp : p.Bound) {s : States} {v : Inputs} (h0 : Initial p s)
    (hr0 : v.psi_ref = (0 : ℝ) ∧ v.r_ref = (0 : ℝ)) :
    vec s v = fun i => (((![0, 0, 0] : Fin 3 → ℚ) i : ℚ) : ℝ) := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨i0, i1, i2⟩ := h0
  obtain ⟨r0, r1⟩ := hr0
  funext i
  fin_cases i <;>
    simp [vec, hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3, i0, i1, i2, r0, r1] <;> norm_num

theorem init_le :
    quad (toReal P) (fun i => (((![0, 0, 0] : Fin 3 → ℚ) i : ℚ) : ℝ)) ≤ (level : ℝ) := by
  rw [quad_toReal_cast]
  exact_mod_cast (by decide +kernel : quad P ![0, 0, 0] ≤ level)

theorem out0 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Icc 0 T) :
    (x t).xi = (fun i => ((![1, 0, 0] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![1, 0, 0] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).xi) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  ring

theorem out1 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Ico 0 T) :
    (y t).e_psi = (fun i => ((![0, 1, 0] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![0, 1, 0] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).psi + (-1 : ℝ) * (u t).psi_ref) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hder⟩ := h
  have hE := (hder.2.2.2 t ht).2.2.2
  obtain ⟨e0, e1, e2, e3, e4, e5, e6⟩ := hE
  try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5 e6
  linear_combination (1 : ℝ) * e0

theorem out2 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
