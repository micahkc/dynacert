/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `xi`, `e_psi`, `e_r`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.xi, (1 : ℝ) * s.psi + (-1 : ℝ) * v.psi_ref, (1 : ℝ) * s.r + (-1 : ℝ) * v.r_ref]
/-- Disturbance channels: `d_wave`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.d_wave]

def model : LTIModel 3 1 where
  A := !![0, 1, 0; 0, 0, 1; -1/2000, -9/500, -21/100]
  B := !![0; 0; 1/200]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(1 : ℝ) * (z 1), (1 : ℝ) * (z 2), (-1/2000 : ℝ) * (z 0) + (-9/500 : ℝ) * (z 1) + (-21/100 : ℝ) * (z 2) + (1/200 : ℝ) * (w 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (0.1 : ℝ) = 1/10 := by norm_num
theorem lit1 : (20.0 : ℝ) = 20 := by norm_num
theorem lit2 : (3.6 : ℝ) = 18/5 := by norm_num
theorem lit3 : (32.0 : ℝ) = 32 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  obtain ⟨hrc0, hrc1, hrder⟩ := hr
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).xi) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).psi + (-1 : ℝ) * (u s).psi_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc0)).add (continuousOn_const.mul hrc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).r + (-1 : ℝ) * (u s).r_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc1)).add (continuousOn_const.mul hrc1)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3, e4, e5, e6⟩⟩ := hder t ht
    obtain ⟨hrd0, hrd1⟩ := hrder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5 e6
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).xi) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).xi = (1 : ℝ) * ((1 : ℝ) * (x t).psi + (-1 : ℝ) * (u t).psi_ref)
      linear_combination (1 : ℝ) * e0 + (1 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).psi + (-1 : ℝ) * (u s).psi_ref) _ (Ici t) t
      refine (((hd0.const_mul (1 : ℝ))).add (hrd0.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).psi + (-1 : ℝ) * (u t).r_ref = (1 : ℝ) * ((1 : ℝ) * (x t).r + (-1 : ℝ) * (u t).r_ref)
      linear_combination (1 : ℝ) * e5
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).r + (-1 : ℝ) * (u s).r_ref) _ (Ici t) t
      refine (((hd1.const_mul (1 : ℝ))).add (hrd1.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).r + (-1 : ℝ) * (u t).a_ref = (-1/2000 : ℝ) * ((1 : ℝ) * (x t).xi) + (-9/500 : ℝ) * ((1 : ℝ) * (x t).psi + (-1 : ℝ) * (u t).psi_ref) + (-21/100 : ℝ) * ((1 : ℝ) * (x t).r + (-1 : ℝ) * (u t).r_ref) + (1/200 : ℝ) * ((u t).d_wave)
      linear_combination (-9/500 : ℝ) * e0 + (-4/25 : ℝ) * e1 + (1/200 : ℝ) * e2 + (1/200 : ℝ) * e3 + (1/20 : ℝ) * e6

