    have hv1 : SectorM1.V (SectorLink.vec (x t)) ≤ (SectorM1.outer : ℝ) := hall 1
    have hR0 : |(x t).th1| ≤ (43/599 : ℝ) := by
      rw [coord0 hp hE]; exact SectorM0.boxR0_le hv0
    have hR1 : |(x t).th2| ≤ (328/8169 : ℝ) := by
