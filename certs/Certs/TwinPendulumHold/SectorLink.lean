namespace TwinPendulumHold.SectorLink

open Matrix Set Real Dynacert Dynacert.Linear Dynacert.Sector TwinPendulumHold

/-- Coordinates: the states `th1, w1, th2, w2`. -/
def vec (s : States) : Fin 4 → ℝ := ![s.th1, s.w1, s.th2, s.w2]

/-- Residual channel 0 (sector): `-th1 + sin(th1)`. -/
noncomputable def ch0 (s : States) (a : Algebraics) : ℝ := (((-1 : ℝ) * s.th1) + (Real.sin s.th1))

/-- Residual channel 1 (sector): `-th2 + sin(th2)`. -/
noncomputable def ch1 (s : States) (a : Algebraics) : ℝ := (((-1 : ℝ) * s.th2) + (Real.sin s.th2))

/-- The signals `w`: residual channels, then disturbances. -/
noncomputable def sig (s : States) (a : Algebraics) (v : Inputs) : Fin 4 → ℝ :=
  ![ch0 s a, ch1 s a, v.d1, v.d2]

/-- Exact linear part and channel input matrix: `ż = A z + B w`. -/
def A : Matrix (Fin 4) (Fin 4) ℚ := !![0, 1, 0, 0; -1619/100, -8, 1, 0; 0, 0, 0, 1; 1, 0, -1619/100, -8]
def B : Matrix (Fin 4) (Fin 4) ℚ := !![0, 0, 0, 0; 981/100, 0, 1, 0; 0, 0, 0, 0; 0, 981/100, 0, 1]

theorem field_apply (z : Fin 4 → ℝ) (w : Fin 4 → ℝ) :
    toReal A *ᵥ z + toReal B *ᵥ w = ![(1 : ℝ) * z 1, (-1619/100 : ℝ) * z 0 + (-8 : ℝ) * z 1 + (1 : ℝ) * z 2 + (981/100 : ℝ) * w 0 + (1 : ℝ) * w 2, (1 : ℝ) * z 3, (1 : ℝ) * z 0 + (-1619/100 : ℝ) * z 2 + (-8 : ℝ) * z 3 + (981/100 : ℝ) * w 1 + (1 : ℝ) * w 3] := by
  funext i
  fin_cases i <;> simp [A, B, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

/-- Sector variable 0: `th1`. -/
noncomputable def Q0 (z : Fin 4 → ℝ) : ℝ := (1 : ℝ) * z 0

/-- Sector variable 1: `th2`. -/
noncomputable def Q1 (z : Fin 4 → ℝ) : ℝ := (1 : ℝ) * z 2

/-- What the certificate needs of the signals on the region: sector channels are
`δ q` with `δ ∈ [ℓ, u]`, the other channels and the disturbances are bounded. -/
def Facts (z : Fin 4 → ℝ) (w : Fin 4 → ℝ) : Prop :=
  (∃ δ ∈ Icc (-859/1000000 : ℝ) (0 : ℝ), w 0 = δ * Q0 z) ∧
  (∃ δ ∈ Icc (-269/1000000 : ℝ) (0 : ℝ), w 1 = δ * Q1 z) ∧
  |w 2| ≤ (1 : ℝ) ∧
  |w 3| ≤ (1/2 : ℝ)

theorem pvals {p : Params} (hp : p.Bound) :
    p.a = (981/100 : ℝ) ∧ p.kp = (25 : ℝ) ∧ p.kd = (8 : ℝ) ∧ p.ks = (1 : ℝ) := by
  obtain ⟨hb0, hb1, hb2, hb3⟩ := hp
  refine ⟨?_, ?_, ?_, ?_⟩ <;> norm_num [hb0, hb1, hb2, hb3]

/-- **Link.** Along a solution, `z = vec x` is continuous and `ż = A z + B w`. -/
theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) :
    ContinuousOn (fun t => vec (x t)) (Icc 0 T) ∧
    ∀ t ∈ Ico 0 T, HasDerivWithinAt (fun t => vec (x t))
      (toReal A *ᵥ vec (x t) + toReal B *ᵥ sig (x t) (y t) (u t)) (Ici t) t := by
  obtain ⟨pv0, pv1, pv2, pv3⟩ := pvals hp
  obtain ⟨dx, hc0, hc1, hc2, hc3, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · exact hc0
    · exact hc1
    · exact hc2
    · exact hc3
  · obtain ⟨hd0, hd1, hd2, hd3, ⟨e0, e1, e2, e3, e4, e5⟩⟩ := hder t ht
    try simp only [pv0, pv1, pv2, pv3] at e0 e1 e2 e3 e4 e5
    rw [field_apply, hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (x s).th1) _ (Ici t) t
      refine hd0.congr_deriv ?_
      show (dx t).th1 = (1 : ℝ) * (x t).w1
      linear_combination ((1 : ℝ)) * e2
    · show HasDerivWithinAt (fun s => (x s).w1) _ (Ici t) t
      refine hd1.congr_deriv ?_
      show (dx t).w1 = (-1619/100 : ℝ) * (x t).th1 + (-8 : ℝ) * (x t).w1 + (1 : ℝ) * (x t).th2 + (981/100 : ℝ) * (((-1 : ℝ) * (x t).th1) + (Real.sin (x t).th1)) + (1 : ℝ) * (u t).d1
      linear_combination ((1 : ℝ)) * e3 + ((1 : ℝ)) * e0
    · show HasDerivWithinAt (fun s => (x s).th2) _ (Ici t) t
      refine hd2.congr_deriv ?_
      show (dx t).th2 = (1 : ℝ) * (x t).w2
      linear_combination ((1 : ℝ)) * e4
    · show HasDerivWithinAt (fun s => (x s).w2) _ (Ici t) t
      refine hd3.congr_deriv ?_
      show (dx t).w2 = (1 : ℝ) * (x t).th1 + (-1619/100 : ℝ) * (x t).th2 + (-8 : ℝ) * (x t).w2 + (981/100 : ℝ) * (((-1 : ℝ) * (x t).th2) + (Real.sin (x t).th2)) + (1 : ℝ) * (u t).d2
      linear_combination ((1 : ℝ)) * e5 + ((1 : ℝ)) * e1

theorem eqs_at {p : Params} {u : ℝ → Inputs} {x : ℝ → States} {y : ℝ → Algebraics}
    {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ} (ht : t ∈ Ico 0 T) :
    ∃ ds : States, Equations t p (u t) (x t) ds (y t) := by
  obtain ⟨dx, hc0, hc1, hc2, hc3, hder⟩ := h
  obtain ⟨hd0, hd1, hd2, hd3, hE⟩ := hder t ht
  exact ⟨dx t, hE⟩

theorem init {p : Params} (hp : p.Bound) {s : States} (h0 : Initial p s) :
    vec s = 0 := by
  obtain ⟨pv0, pv1, pv2, pv3⟩ := pvals hp
  obtain ⟨i0, i1, i2, i3⟩ := h0
  funext i
  fin_cases i <;> simp [vec, i0, i1, i2, i3]

theorem coord0 {p : Params} (hp : p.Bound) {t : ℝ} {v : Inputs}
    {s ds : States} {a : Algebraics} (hE : Equations t p v s ds a) :
    s.th1 = (1 : ℝ) * vec s 0 := by
  obtain ⟨pv0, pv1, pv2, pv3⟩ := pvals hp
  obtain ⟨e0, e1, e2, e3, e4, e5⟩ := hE
  try simp only [pv0, pv1, pv2, pv3] at e0 e1 e2 e3 e4 e5
  simp only [vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val]
  linear_combination 0

theorem coord1 {p : Params} (hp : p.Bound) {t : ℝ} {v : Inputs}
    {s ds : States} {a : Algebraics} (hE : Equations t p v s ds a) :
    s.th2 = (1 : ℝ) * vec s 2 := by
  obtain ⟨pv0, pv1, pv2, pv3⟩ := pvals hp
  obtain ⟨e0, e1, e2, e3, e4, e5⟩ := hE
  try simp only [pv0, pv1, pv2, pv3] at e0 e1 e2 e3 e4 e5
  simp only [vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val]
  linear_combination 0

/-- **Rigorous residual bounds.** On the region box, every channel satisfies its
sector or peak bound (lemmas of `Dynacert/Sector/Atoms.lean`). -/
theorem facts {p : Params} (hp : p.Bound) {t : ℝ} {v : Inputs} {s ds : States}
    {a : Algebraics} (hE : Equations t p v s ds a)
    (hR : |s.th1| ≤ (43/599 : ℝ) ∧ |s.th2| ≤ (328/8169 : ℝ))
    (hw : |v.d1| ≤ (1 : ℝ) ∧ |v.d2| ≤ (1/2 : ℝ)) :
    Facts (vec s) (sig s a v) := by
  obtain ⟨pv0, pv1, pv2, pv3⟩ := pvals hp
  obtain ⟨e0, e1, e2, e3, e4, e5⟩ := hE
  try simp only [pv0, pv1, pv2, pv3] at e0 e1 e2 e3 e4 e5
  obtain ⟨hR0, hR1⟩ := hR
  obtain ⟨hw0, hw1⟩ := hw
  have hA0L : |s.th1| ≤ (43/599 : ℝ) := abs_le.mpr ⟨by linarith [(abs_le.mp hR0).1, (abs_le.mp hR0).2], by linarith [(abs_le.mp hR0).1, (abs_le.mp hR0).2]⟩
  have hA1L : |s.th2| ≤ (328/8169 : ℝ) := abs_le.mpr ⟨by linarith [(abs_le.mp hR1).1, (abs_le.mp hR1).2], by linarith [(abs_le.mp hR1).1, (abs_le.mp hR1).2]⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  · obtain ⟨δ, hδ, hk⟩ := sin_sub_self_gain (lo := (-859/1000000 : ℝ)) (hi := (0 : ℝ)) hA0L (by norm_num) (by norm_num)
    refine ⟨δ, hδ, ?_⟩
    simp only [sig, ch0, Q0 , vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
    linear_combination hk
  · obtain ⟨δ, hδ, hk⟩ := sin_sub_self_gain (lo := (-269/1000000 : ℝ)) (hi := (0 : ℝ)) hA1L (by norm_num) (by norm_num)
    refine ⟨δ, hδ, ?_⟩
    simp only [sig, ch1, Q1 , vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
    linear_combination hk
  · simpa [sig] using hw0
  · simpa [sig] using hw1

end TwinPendulumHold.SectorLink
