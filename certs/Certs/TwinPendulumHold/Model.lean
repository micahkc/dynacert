import Rumoca.Prelude

set_option linter.unusedVariables false

namespace TwinPendulumHold
open Matrix

/-- Parameters and constants. -/
structure Params where
  /-- g/l [1/s2] -/
  a : ℝ
  /-- Angle gain [1/s2] -/
  kp : ℝ
  /-- Rate gain [1/s] -/
  kd : ℝ
  /-- Spring between the links [1/s2] -/
  ks : ℝ

/-- Inputs. -/
structure Inputs where
  /-- Torque, link 1 [rad/s2] -/
