/-- Modelica names of the states, in declaration order. -/
def stateNames : List String := ["th1", "w1", "th2", "w2"]

/-- Modelica names of the algebraic variables and outputs, in declaration order. -/
def algebraicNames : List String := ["u1", "u2"]

/-- The parameter bindings of the model. -/
def Params.Bound (p : Params) : Prop :=
  p.a = 9.81
  ∧ p.kp = 25.0
  ∧ p.kd = 8.0
  ∧ p.ks = 1.0

/-- Initial conditions: the `fixed = true` start values of the states. -/
def Initial (p : Params) (x : States) : Prop :=
  x.th1 = 0
  ∧ x.w1 = 0
  ∧ x.th2 = 0
  ∧ x.w2 = 0

/-- The continuous equations of `TwinPendulumHold` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.u1 = -(p.kp * x.th1) - p.kd * x.w1
  ∧ y.u2 = -(p.kp * x.th2) - p.kd * x.w2
  ∧ dx.th1 = x.w1
  ∧ dx.w1 = p.a * Real.sin x.th1 + p.ks * (x.th2 - x.th1) + y.u1 + u.d1
  ∧ dx.th2 = x.w2
  ∧ dx.w2 = p.a * Real.sin x.th2 + p.ks * (x.th1 - x.th2) + y.u2 + u.d2

/-- `x`, `y` is a solution of `TwinPendulumHold` under input `u`: every state
component has derivative `dx t` at every `t`, and the equations hold. -/
def IsSolution (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) : Prop :=
  ∃ dx : ℝ → States, ∀ t : ℝ,
    HasDerivAt (fun s => (x s).th1) (dx t).th1 t ∧
    HasDerivAt (fun s => (x s).w1) (dx t).w1 t ∧
    HasDerivAt (fun s => (x s).th2) (dx t).th2 t ∧
    HasDerivAt (fun s => (x s).w2) (dx t).w2 t ∧
    Equations t p (u t) (x t) (dx t) (y t)

/-- `x`, `y` is a solution of `TwinPendulumHold` on `[0, T]` under input `u`:
every state component is continuous on `[0, T]` and has right derivative
