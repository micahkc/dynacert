  /-- Torque, link 2 [rad/s2] -/
  d2 : ℝ

/-- Differentiated variables (also used for their derivatives). -/
structure States where
  /-- Angle, link 1 [rad] -/
  th1 : ℝ
  /-- Rate, link 1 [rad/s] -/
  w1 : ℝ
  /-- Angle, link 2 [rad] -/
  th2 : ℝ
  /-- Rate, link 2 [rad/s] -/
  w2 : ℝ

/-- Algebraic (non-differentiated) variables. -/
structure Algebraics where
  /-- Control, link 1 [rad/s2] -/
  u1 : ℝ
  /-- Control, link 2 [rad/s2] -/
