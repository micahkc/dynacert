namespace GantryPayload.Spec

open Set GantryPayload

/-- Admissible disturbances: componentwise peak bounds. -/
def Admissible (u : ℝ → Inputs) (T : ℝ) : Prop :=
  ∀ t ∈ Ico 0 T, |(u t).a_vib| ≤ (1/2 : ℝ) ∧ |(u t).a_drag| ≤ (1/5 : ℝ)

def References (u : ℝ → Inputs) (T : ℝ) : Prop := True

def ReferenceStart (u : ℝ → Inputs) : Prop := True

/-- Parameter values: the model's bindings, with the uncertain parameters
ranging over their annotated intervals. -/
def ParamsOK (p : Params) : Prop :=
  (1/50 : ℝ) ≤ p.winv ∧ p.winv ≤ (333/10000 : ℝ) ∧
  p.c = (80 : ℝ) ∧
  p.kp = (16000 : ℝ) ∧
  p.kd = (1200 : ℝ) ∧
  p.ki = (40000 : ℝ)

/-- **The claim.** Every solution with admissible parameter values, admissible
disturbances, the declared references, and the model's initial condition keeps
`x`, `v`, `xi` within the bounds `b`. -/
def Claim (b : Fin 3 → ℚ) : Prop :=
  ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) (T : ℝ),
    ParamsOK p → IsSolutionOn p u x y T → Admissible u T → References u T →
    ReferenceStart u → Initial p (x 0) →
    (∀ t ∈ Icc 0 T, |(x t).x| ≤ (b 0 : ℝ) ∧ |(x t).v| ≤ (b 1 : ℝ) ∧ |(x t).xi| ≤ (b 2 : ℝ))

end GantryPayload.Spec
