/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `x`, `v`, `xi`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.x, (1 : ℝ) * s.v, (1 : ℝ) * s.xi]
/-- Disturbance channels: `a_vib`, `a_drag`. -/
def dist (v : Inputs) : Fin 2 → ℝ := ![v.a_vib, v.a_drag]

/-- Vertex matrices of the polytope of systems (corners of the parameter box). -/
def As : Fin 2 → Matrix (Fin 3) (Fin 3) ℚ :=
  ![!![0, 1, 0; -320, -128/5, -800; 1, 0, 0],
    !![0, 1, 0; -2664/5, -5328/125, -1332; 1, 0, 0]]
def Bm : Matrix (Fin 3) (Fin 2) ℚ := !![0, 0; 1, 1; 0, 0]

/-- Interpolation weights of the actual parameters. -/
noncomputable def weights (p : Params) : Fin 2 → ℝ :=
  ![(((333/10000 : ℝ) - p.winv) / (133/10000 : ℝ)), ((p.winv - (1/50 : ℝ)) / (133/10000 : ℝ))]

theorem f_apply (wt : Fin 2 → ℝ) (z : Fin 3 → ℝ) (w : Fin 2 → ℝ) :
    (∑ i, wt i • toReal (As i)) *ᵥ z + toReal Bm *ᵥ w = ![wt 0 * ((1 : ℝ) * (z 1)) + wt 1 * ((1 : ℝ) * (z 1)), wt 0 * ((-320 : ℝ) * (z 0) + (-128/5 : ℝ) * (z 1) + (-800 : ℝ) * (z 2)) + wt 1 * ((-2664/5 : ℝ) * (z 0) + (-5328/125 : ℝ) * (z 1) + (-1332 : ℝ) * (z 2)) + (1 : ℝ) * (w 0) + (1 : ℝ) * (w 1), wt 0 * ((1 : ℝ) * (z 0)) + wt 1 * ((1 : ℝ) * (z 0))] := by
  funext i
  fin_cases i <;>
    simp [As, Bm, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

