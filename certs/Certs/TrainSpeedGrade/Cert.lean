/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `xi`, `e_x`, `e_v`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.xi, (1 : ℝ) * s.x + (-1 : ℝ) * v.x_ref, (1 : ℝ) * s.v + (-1 : ℝ) * v.v_ref]
/-- Disturbance channels: `F_grade`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.F_grade]

def model : LTIModel 3 1 where
  A := !![0, 1, 0; 0, 0, 1; -1/50, -1/5, -203/200]
  B := !![0; 0; 1/400]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(1 : ℝ) * (z 1), (1 : ℝ) * (z 2), (-1/50 : ℝ) * (z 0) + (-1/5 : ℝ) * (z 1) + (-203/200 : ℝ) * (z 2) + (1/400 : ℝ) * (w 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (0.02 : ℝ) = 1/50 := by norm_num
theorem lit1 : (400.0 : ℝ) = 400 := by norm_num
theorem lit2 : (6.0 : ℝ) = 6 := by norm_num
theorem lit3 : (80.0 : ℝ) = 80 := by norm_num
theorem lit4 : (8.0 : ℝ) = 8 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  obtain ⟨hrc0, hrc1, hrder⟩ := hr
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).xi) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).x + (-1 : ℝ) * (u s).x_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc0)).add (continuousOn_const.mul hrc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).v + (-1 : ℝ) * (u s).v_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc1)).add (continuousOn_const.mul hrc1)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3, e4, e5, e6⟩⟩ := hder t ht
    obtain ⟨hrd0, hrd1⟩ := hrder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3 e4 e5 e6
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).xi) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).xi = (1 : ℝ) * ((1 : ℝ) * (x t).x + (-1 : ℝ) * (u t).x_ref)
      linear_combination (1 : ℝ) * e0 + (1 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).x + (-1 : ℝ) * (u s).x_ref) _ (Ici t) t
      refine (((hd0.const_mul (1 : ℝ))).add (hrd0.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).x + (-1 : ℝ) * (u t).v_ref = (1 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref)
      linear_combination (1 : ℝ) * e5
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).v + (-1 : ℝ) * (u s).v_ref) _ (Ici t) t
      refine (((hd1.const_mul (1 : ℝ))).add (hrd1.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).v + (-1 : ℝ) * (u t).a_ref = (-1/50 : ℝ) * ((1 : ℝ) * (x t).xi) + (-1/5 : ℝ) * ((1 : ℝ) * (x t).x + (-1 : ℝ) * (u t).x_ref) + (-203/200 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref) + (1/400 : ℝ) * ((u t).F_grade)
      linear_combination (-1/5 : ℝ) * e0 + (-1 : ℝ) * e1 + (1/400 : ℝ) * e2 + (1/400 : ℝ) * e3 + (1/400 : ℝ) * e6

