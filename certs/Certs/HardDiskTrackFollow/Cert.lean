    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hc3, hc4, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).y) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).v) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).q) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).qd) (Icc 0 T)
      exact (continuousOn_const.mul hc3)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).xi) (Icc 0 T)
      exact (continuousOn_const.mul hc4)
  · obtain ⟨hd0, hd1, hd2, hd3, hd4, ⟨e0, e1, e2, e3, e4, e5⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3 e4 e5
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).y) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).y = (1 : ℝ) * ((1 : ℝ) * (x t).v)
      linear_combination (1 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).v) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).v = (-27 : ℝ) * ((1 : ℝ) * (x t).y) + (-9 : ℝ) * ((1 : ℝ) * (x t).v) + (-27 : ℝ) * ((1 : ℝ) * (x t).q) + (-9 : ℝ) * ((1 : ℝ) * (x t).qd) + (-27 : ℝ) * ((1 : ℝ) * (x t).xi) + (1 : ℝ) * ((u t).a_ro) + (1 : ℝ) * ((u t).a_w)
      linear_combination (1 : ℝ) * e0 + (1 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).q) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).q = (1 : ℝ) * ((1 : ℝ) * (x t).qd)
      linear_combination (1 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).qd) _ (Ici t) t
      refine ((hd3.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).qd = (-81/10 : ℝ) * ((1 : ℝ) * (x t).y) + (-27/10 : ℝ) * ((1 : ℝ) * (x t).v) + (-49703/50 : ℝ) * ((1 : ℝ) * (x t).q) + (-989/250 : ℝ) * ((1 : ℝ) * (x t).qd) + (-81/10 : ℝ) * ((1 : ℝ) * (x t).xi)
      linear_combination (3/10 : ℝ) * e0 + (1 : ℝ) * e5
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).xi) _ (Ici t) t
      refine ((hd4.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).xi = (1 : ℝ) * ((1 : ℝ) * (x t).y) + (1 : ℝ) * ((1 : ℝ) * (x t).q)
      linear_combination (1 : ℝ) * e1

