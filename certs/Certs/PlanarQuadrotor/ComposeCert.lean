/-- **Tube.** Every certified ellipsoid `{V_k ≤ c_k}` is invariant: the trajectory never
reaches the boundary of the region on which the sector bounds were proved (Lemma 1). -/
theorem tube : ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ), p.Bound → IsSolutionOn p u x y T → Spec.Admissible u T →
    Spec.References u T → Spec.ReferenceStart u → Initial p (x 0) →
    ∀ k : Fin 4, ∀ t ∈ Icc 0 T, vs x k t ≤ (levels k : ℝ) := by
  intro p u x y T hp h hu hr hr0 h0
  obtain ⟨hcont, hder⟩ := link hp h
  refine region_invariant (v := vs x) (v' := vs' x y u) (α := fun k => (αs k : ℝ))
    (c := fun k => (levels k : ℝ)) (b := fun k => (outers k : ℝ)) ?_ ?_ ?_ ?_ ?_ ?_
  · intro k; fin_cases k <;> norm_num [αs, ComposeM0.α, ComposeM1.α, ComposeM2.α, ComposeM3.α]
  · intro k; fin_cases k <;> norm_num [levels, outers, ComposeM0.level, ComposeM0.outer, ComposeM1.level, ComposeM1.outer, ComposeM2.level, ComposeM2.outer, ComposeM3.level, ComposeM3.outer]
  · intro k; fin_cases k
    · exact (((quad_continuous _).comp_continuousOn (sel_continuousOn ComposeM0.idx0 hcont)).add ((quad_continuous _).comp_continuousOn (sel_continuousOn ComposeM0.idx1 hcont)))
    · exact (((quad_continuous _).comp_continuousOn (sel_continuousOn ComposeM1.idx0 hcont)).add ((quad_continuous _).comp_continuousOn (sel_continuousOn ComposeM1.idx1 hcont)))
    · exact (((quad_continuous _).comp_continuousOn (sel_continuousOn ComposeM2.idx0 hcont)).add ((quad_continuous _).comp_continuousOn (sel_continuousOn ComposeM2.idx1 hcont)))
    · exact (((quad_continuous _).comp_continuousOn (sel_continuousOn ComposeM3.idx0 hcont)).add ((quad_continuous _).comp_continuousOn (sel_continuousOn ComposeM3.idx1 hcont)))
  · intro k t ht; fin_cases k
    · exact ((quad_hasDirDeriv _ _ _ _ _ (sel_hasDerivWithinAt ComposeM0.idx0 (hder t ht))).add (quad_hasDirDeriv _ _ _ _ _ (sel_hasDerivWithinAt ComposeM0.idx1 (hder t ht))))
    · exact ((quad_hasDirDeriv _ _ _ _ _ (sel_hasDerivWithinAt ComposeM1.idx0 (hder t ht))).add (quad_hasDirDeriv _ _ _ _ _ (sel_hasDerivWithinAt ComposeM1.idx1 (hder t ht))))
    · exact ((quad_hasDirDeriv _ _ _ _ _ (sel_hasDerivWithinAt ComposeM2.idx0 (hder t ht))).add (quad_hasDirDeriv _ _ _ _ _ (sel_hasDerivWithinAt ComposeM2.idx1 (hder t ht))))
    · exact ((quad_hasDirDeriv _ _ _ _ _ (sel_hasDerivWithinAt ComposeM3.idx0 (hder t ht))).add (quad_hasDirDeriv _ _ _ _ _ (sel_hasDerivWithinAt ComposeM3.idx1 (hder t ht))))
  · intro k; fin_cases k <;> simp [vs, levels, init hp h0, ComposeM0.V, ComposeM0.level, ComposeM1.V, ComposeM1.level, ComposeM2.V, ComposeM2.level, ComposeM3.V, ComposeM3.level] <;> norm_num
  · intro t ht hall
    obtain ⟨ds, hE⟩ := eqs_at h ht
    have hv0 : ComposeM0.V (ComposeLink.vec (x t)) ≤ (ComposeM0.outer : ℝ) := hall 0
    have hv1 : ComposeM1.V (ComposeLink.vec (x t)) ≤ (ComposeM1.outer : ℝ) := hall 1
    have hv2 : ComposeM2.V (ComposeLink.vec (x t)) ≤ (ComposeM2.outer : ℝ) := hall 2
    have hv3 : ComposeM3.V (ComposeLink.vec (x t)) ≤ (ComposeM3.outer : ℝ) := hall 3
    have hR0 : |(y t).s_x| ≤ (13333/9203 : ℝ) := by
      rw [coord0 hp hE]; exact ComposeM2.boxR0_le hv2
    have hR1 : |(y t).s_z| ≤ (6254/9189 : ℝ) := by
      rw [coord1 hp hE]; exact ComposeM3.boxR1_le hv3
    have hR2 : |(x t).theta| ≤ (1383/9416 : ℝ) := by
      rw [coord2 hp hE]; exact ComposeM1.boxR2_le hv1
