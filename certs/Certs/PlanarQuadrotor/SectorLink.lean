/-- **Rigorous residual bounds.** On the region box, every channel satisfies its
sector or peak bound (lemmas of `Dynacert/Sector/Atoms.lean`). -/
theorem facts {p : Params} (hp : p.Bound) {t : ℝ} {v : Inputs} {s ds : States}
    {a : Algebraics} (hE : Equations t p v s ds a)
    (hR : |a.s_x| ≤ (2347/1620 : ℝ) ∧ |a.s_z| ≤ (6531/9596 : ℝ) ∧ |s.theta| ≤ (1049/7142 : ℝ))
    (hw : |v.w_x| ≤ (1/4 : ℝ) ∧ |v.w_z| ≤ (1/4 : ℝ) ∧ |v.w_q| ≤ (5/4 : ℝ)) :
    Facts (vec s) (sig s a v) := by
  obtain ⟨pv0, pv1, pv2, pv3, pv4, pv5, pv6⟩ := pvals hp
  obtain ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9⟩ := hE
  try simp only [pv0, pv1, pv2, pv3, pv4, pv5, pv6] at e0 e1 e2 e3 e4 e5 e6 e7 e8 e9
  obtain ⟨hR0, hR1, hR2⟩ := hR
  obtain ⟨hw0, hw1, hw2⟩ := hw
  have hA2L : |s.theta| ≤ (1049/7142 : ℝ) := abs_le.mpr ⟨by linarith [(abs_le.mp hR2).1, (abs_le.mp hR2).2], by linarith [(abs_le.mp hR2).1, (abs_le.mp hR2).2]⟩
  have hdef_f_norm : a.f_norm = (Real.sqrt ((a.s_x ^ 2) + (((981/100 : ℝ) + ((-1 : ℝ) * a.s_z)) ^ 2))) := by
    rw [e2]; try ring_nf
  have hA0s : |a.s_x| ≤ (2347/1620 : ℝ) := abs_le.mpr ⟨by linarith [(abs_le.mp hR0).1, (abs_le.mp hR0).2], by linarith [(abs_le.mp hR0).1, (abs_le.mp hR0).2]⟩
  have hA0h : ((981/100 : ℝ) + ((-1 : ℝ) * a.s_z)) ∈ Icc (547536/59975 : ℝ) (1258347/119950 : ℝ) := ⟨by linarith [(abs_le.mp hR1).1, (abs_le.mp hR1).2], by linarith [(abs_le.mp hR1).1, (abs_le.mp hR1).2]⟩
  have hA3L : |s.theta| ≤ (1049/7142 : ℝ) := abs_le.mpr ⟨by linarith [(abs_le.mp hR2).1, (abs_le.mp hR2).2], by linarith [(abs_le.mp hR2).1, (abs_le.mp hR2).2]⟩
  have hdef_theta_d : a.theta_d = (Rumoca.atan2 ((-1 : ℝ) * a.s_x) ((981/100 : ℝ) + ((-1 : ℝ) * a.s_z))) := by
    rw [e3]; try ring_nf
  have hA1y : |((-1 : ℝ) * a.s_x)| ≤ (2347/1620 : ℝ) := abs_le.mpr ⟨by linarith [(abs_le.mp hR0).1, (abs_le.mp hR0).2], by linarith [(abs_le.mp hR0).1, (abs_le.mp hR0).2]⟩
  have hA1h : ((981/100 : ℝ) + ((-1 : ℝ) * a.s_z)) ∈ Icc (547536/59975 : ℝ) (1258347/119950 : ℝ) := ⟨by linarith [(abs_le.mp hR1).1, (abs_le.mp hR1).2], by linarith [(abs_le.mp hR1).1, (abs_le.mp hR1).2]⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · obtain ⟨δ, hδ, hk⟩ := sin_sub_self_gain (lo := (-899/250000 : ℝ)) (hi := (0 : ℝ)) hA2L (by norm_num) (by norm_num)
    refine ⟨δ, hδ, ?_⟩
    simp only [sig, ch0, Q0 , vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
    linear_combination hk
  · have hδ : Real.sin s.theta ∈ Icc (-73439/500000 : ℝ) (73439/500000 : ℝ) := gain_of_abs (abs_sin_le_of hA2L) (by norm_num) (by norm_num)
    refine ⟨Real.sin s.theta, hδ, ?_⟩
    simp only [sig, ch1, Q1 , vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
    linear_combination (((-1 : ℝ) * (Real.sin s.theta))) * e1
  · have hf0 : |a.f_norm - ((981/100 : ℝ) + ((-1 : ℝ) * a.s_z))| ≤ (57477/500000 : ℝ) := (by rw [hdef_f_norm]; exact (abs_sqrt_sub_le (b := (2347/1620 : ℝ)) (h0 := (547536/59975 : ℝ)) (by norm_num) hA0h.1 hA0s).trans (by norm_num))
    have hf1 : |Real.sin s.theta| ≤ (73439/500000 : ℝ) := ((abs_sin_le_of hA2L).trans (by norm_num))
    have heq : sig s a v 2 = (a.f_norm - ((981/100 : ℝ) + ((-1 : ℝ) * a.s_z))) * (Real.sin s.theta) := by
      simp only [sig, ch2, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
      ring
    rw [heq]
    exact (abs_mul_le_of hf0 hf1).trans (by norm_num)
  · have hf0 : |a.f_norm - ((981/100 : ℝ) + ((-1 : ℝ) * a.s_z))| ≤ (57477/500000 : ℝ) := (by rw [hdef_f_norm]; exact (abs_sqrt_sub_le (b := (2347/1620 : ℝ)) (h0 := (547536/59975 : ℝ)) (by norm_num) hA0h.1 hA0s).trans (by norm_num))
    have heq : sig s a v 3 = (a.f_norm - ((981/100 : ℝ) + ((-1 : ℝ) * a.s_z))) := by
      simp only [sig, ch3, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
      ring
    rw [heq]
    exact hf0.trans (by norm_num)
  · have hf0 : |a.f_norm| ≤ (212111/20000 : ℝ) := (by rw [hdef_f_norm]; exact (abs_sqrt_le (b := (2347/1620 : ℝ)) (h0 := (547536/59975 : ℝ)) (h1 := (1258347/119950 : ℝ)) (by norm_num) hA0h hA0s).trans (by norm_num))
    have hf1 : |Real.cos s.theta - 1| ≤ (10787/1000000 : ℝ) := ((abs_cos_sub_one_le hA3L).trans (by norm_num))
    have heq : sig s a v 4 = (a.f_norm) * (Real.cos s.theta - 1) := by
      simp only [sig, ch4, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
      ring
    rw [heq]
    exact (abs_mul_le_of hf0 hf1).trans (by norm_num)
  · obtain ⟨δ, hδ, hk⟩ := atan2_sub_gain (h0 := (547536/59975 : ℝ)) (h1 := (1258347/119950 : ℝ)) (b := (2347/1620 : ℝ)) (k := (100/981 : ℝ)) (lo := (-3707/500000 : ℝ)) (hi := (19/2500 : ℝ)) (by norm_num) hA1h hA1y (by norm_num) (by norm_num) (by norm_num)
    refine ⟨δ, hδ, ?_⟩
    simp only [sig, ch5, Q2 , vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
    linear_combination hk + (((-1 : ℝ) * δ)) * e0 + ((1 : ℝ)) * hdef_theta_d
  · simpa [sig] using hw0
  · simpa [sig] using hw1
  · simpa [sig] using hw2

