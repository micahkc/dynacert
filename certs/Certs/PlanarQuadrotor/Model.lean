/-
Generated by Rumoca - Lean 4 / Mathlib specification of `PlanarQuadrotor`
from the checked DAE IR.

* `Equations t p u x dx y` : the continuous equations at one instant
  (`dx` holds the time derivatives of the states).
* `IsSolution p u x y`     : trajectories `x`, `y` satisfy the model under input `u`.
* `IsSolutionOn p u x y T` : the same on `[0, T]`, with continuity on `[0, T]`
  and right derivatives on `[0, T)` (admits step inputs).
* `paramNames`, `inputNames`, `stateNames`, `algebraicNames` : Modelica names.
* `Params.Bound p`         : the parameter values bound in the model.
* `Initial p x₀`           : the `fixed = true` start values.

Arrays are `Fin n → ℝ` / `Matrix (Fin m) (Fin n) ℝ`; Modelica `v[k]` is `v (k-1)`.
-/
import Rumoca.Prelude

set_option linter.unusedVariables false

namespace PlanarQuadrotor
open Matrix

/-- Parameters and constants. -/
structure Params where
  /-- Gravity [m/s2] -/
  g : ℝ
  /-- Outer-loop position gain [1/s2] -/
  Kp : ℝ
  /-- Outer-loop velocity gain [1/s] -/
  Kv : ℝ
  /-- Inner-loop natural frequency [rad/s] -/
  wn : ℝ
  /-- Pitch gain [1/s2] -/
  k_theta : ℝ
  /-- Pitch-rate gain [1/s] -/
  k_q : ℝ
  /-- Gust bound [m/s2] (1 = the paper's full level) -/
  wbar : ℝ

/-- Inputs. -/
structure Inputs where
  /-- Lateral gust [m/s2] -/
  w_x : ℝ
  /-- Vertical gust [m/s2] -/
  w_z : ℝ
  /-- Pitch torque disturbance [rad/s2] -/
  w_q : ℝ

/-- Differentiated variables (also used for their derivatives). -/
structure States where
  /-- Lateral position error [m] -/
  e_x : ℝ
  /-- Vertical position error [m] -/
  e_z : ℝ
  /-- Lateral velocity error [m/s] -/
  v_x : ℝ
  /-- Vertical velocity error [m/s] -/
  v_z : ℝ
  /-- Pitch [rad] -/
  theta : ℝ
  /-- Pitch rate [rad/s] -/
  q : ℝ

/-- Algebraic (non-differentiated) variables. -/
structure Algebraics where
  /-- Outer-loop command, lateral [m/s2] -/
  s_x : ℝ
  /-- Outer-loop command, vertical [m/s2] -/
  s_z : ℝ
  /-- Thrust acceleration |f| [m/s2] -/
  f_norm : ℝ
  /-- Commanded pitch [rad] -/
  theta_d : ℝ

/-- Modelica names of the parameters and constants, in declaration order. -/
def paramNames : List String := ["g", "Kp", "Kv", "wn", "k_theta", "k_q", "wbar"]

/-- Modelica names of the inputs, in declaration order. -/
def inputNames : List String := ["w_x", "w_z", "w_q"]

/-- Modelica names of the states, in declaration order. -/
def stateNames : List String := ["e_x", "e_z", "v_x", "v_z", "theta", "q"]

/-- Modelica names of the algebraic variables and outputs, in declaration order. -/
def algebraicNames : List String := ["s_x", "s_z", "f_norm", "theta_d"]

/-- The parameter bindings of the model. -/
def Params.Bound (p : Params) : Prop :=
  p.g = 9.81
  ∧ p.Kp = 4.0
  ∧ p.Kv = 4.0
  ∧ p.wn = 10.0
  ∧ p.k_theta = p.wn ^ 2
  ∧ p.k_q = 2 * p.wn
  ∧ p.wbar = 0.25

/-- Initial conditions: the `fixed = true` start values of the states. -/
def Initial (p : Params) (x : States) : Prop :=
  x.e_x = 0
  ∧ x.e_z = 0
  ∧ x.v_x = 0
  ∧ x.v_z = 0
  ∧ x.theta = 0
  ∧ x.q = 0

/-- The continuous equations of `PlanarQuadrotor` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.s_x = p.Kp * x.e_x + p.Kv * x.v_x
  ∧ y.s_z = p.Kp * x.e_z + p.Kv * x.v_z
  ∧ y.f_norm = Real.sqrt (y.s_x ^ 2 + (p.g - y.s_z) ^ 2)
  ∧ y.theta_d = Rumoca.atan2 (-y.s_x) (p.g - y.s_z)
  ∧ dx.e_x = x.v_x
  ∧ dx.e_z = x.v_z
  ∧ dx.v_x = y.f_norm * Real.sin x.theta + u.w_x
  ∧ dx.v_z = y.f_norm * Real.cos x.theta - p.g + u.w_z
  ∧ dx.theta = x.q
  ∧ dx.q = -(p.k_theta * (x.theta - y.theta_d)) - p.k_q * x.q + u.w_q

/-- `x`, `y` is a solution of `PlanarQuadrotor` under input `u`: every state
component has derivative `dx t` at every `t`, and the equations hold. -/
def IsSolution (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) : Prop :=
  ∃ dx : ℝ → States, ∀ t : ℝ,
    HasDerivAt (fun s => (x s).e_x) (dx t).e_x t ∧
    HasDerivAt (fun s => (x s).e_z) (dx t).e_z t ∧
    HasDerivAt (fun s => (x s).v_x) (dx t).v_x t ∧
    HasDerivAt (fun s => (x s).v_z) (dx t).v_z t ∧
    HasDerivAt (fun s => (x s).theta) (dx t).theta t ∧
    HasDerivAt (fun s => (x s).q) (dx t).q t ∧
    Equations t p (u t) (x t) (dx t) (y t)

/-- `x`, `y` is a solution of `PlanarQuadrotor` on `[0, T]` under input `u`:
every state component is continuous on `[0, T]` and has right derivative
`dx t` at every `t ∈ [0, T)`, where the equations hold. Right derivatives
admit piecewise-continuous, right-continuous inputs (steps, zero-order hold). -/
def IsSolutionOn (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ) : Prop :=
  ∃ dx : ℝ → States,
    ContinuousOn (fun s => (x s).e_x) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).e_z) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).v_x) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).v_z) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).theta) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).q) (Set.Icc 0 T) ∧
    ∀ t ∈ Set.Ico 0 T,
      HasDerivWithinAt (fun s => (x s).e_x) (dx t).e_x (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).e_z) (dx t).e_z (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).v_x) (dx t).v_x (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).v_z) (dx t).v_z (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).theta) (dx t).theta (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).q) (dx t).q (Set.Ici t) t ∧
      Equations t p (u t) (x t) (dx t) (y t)

/-- A solution on all of `ℝ` is a solution on every `[0, T]`. -/
theorem IsSolution.isSolutionOn {p : Params} {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} (h : IsSolution p u x y) (T : ℝ) : IsSolutionOn p u x y T := by
  obtain ⟨dx, hdx⟩ := h
  exact ⟨dx,
    fun s _ => ((hdx s).1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.2.1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.2.2.1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.2.2.2.1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.2.2.2.2.1).continuousAt.continuousWithinAt,
    fun t _ => ⟨
      ((hdx t).1).hasDerivWithinAt,
      ((hdx t).2.1).hasDerivWithinAt,
      ((hdx t).2.2.1).hasDerivWithinAt,
      ((hdx t).2.2.2.1).hasDerivWithinAt,
      ((hdx t).2.2.2.2.1).hasDerivWithinAt,
      ((hdx t).2.2.2.2.2.1).hasDerivWithinAt,
      (hdx t).2.2.2.2.2.2⟩⟩

end PlanarQuadrotor
