    Spec.References u T → Spec.ReferenceStart u → Initial p (x 0) →
    ∀ k : Fin 4, ∀ t ∈ Icc 0 T, vs x k t ≤ (levels k : ℝ) := by
  intro p u x y T hp h hu hr hr0 h0
  obtain ⟨hcont, hder⟩ := link hp h
  refine region_invariant (v := vs x) (v' := vs' x y u) (α := fun k => (αs k : ℝ))
    (c := fun k => (levels k : ℝ)) (b := fun k => (outers k : ℝ)) ?_ ?_ ?_ ?_ ?_ ?_
  · intro k; fin_cases k <;> norm_num [αs, SectorM0.α, SectorM1.α, SectorM2.α, SectorM3.α]
  · intro k; fin_cases k <;> norm_num [levels, outers, SectorM0.level, SectorM0.outer, SectorM1.level, SectorM1.outer, SectorM2.level, SectorM2.outer, SectorM3.level, SectorM3.outer]
  · intro k; fin_cases k
    · exact ((quad_continuous _).comp_continuousOn (sel_continuousOn SectorM0.idx0 hcont))
    · exact ((quad_continuous _).comp_continuousOn (sel_continuousOn SectorM1.idx0 hcont))
    · exact ((quad_continuous _).comp_continuousOn (sel_continuousOn SectorM2.idx0 hcont))
    · exact ((quad_continuous _).comp_continuousOn (sel_continuousOn SectorM3.idx0 hcont))
  · intro k t ht; fin_cases k
    · exact (quad_hasDirDeriv _ _ _ _ _ (sel_hasDerivWithinAt SectorM0.idx0 (hder t ht)))
    · exact (quad_hasDirDeriv _ _ _ _ _ (sel_hasDerivWithinAt SectorM1.idx0 (hder t ht)))
    · exact (quad_hasDirDeriv _ _ _ _ _ (sel_hasDerivWithinAt SectorM2.idx0 (hder t ht)))
    · exact (quad_hasDirDeriv _ _ _ _ _ (sel_hasDerivWithinAt SectorM3.idx0 (hder t ht)))
  · intro k; fin_cases k <;> simp [vs, levels, init hp h0, SectorM0.V, SectorM0.level, SectorM1.V, SectorM1.level, SectorM2.V, SectorM2.level, SectorM3.V, SectorM3.level] <;> norm_num
  · intro t ht hall
    obtain ⟨ds, hE⟩ := eqs_at h ht
    have hv0 : SectorM0.V (SectorLink.vec (x t)) ≤ (SectorM0.outer : ℝ) := hall 0
    have hv1 : SectorM1.V (SectorLink.vec (x t)) ≤ (SectorM1.outer : ℝ) := hall 1
    have hv2 : SectorM2.V (SectorLink.vec (x t)) ≤ (SectorM2.outer : ℝ) := hall 2
    have hv3 : SectorM3.V (SectorLink.vec (x t)) ≤ (SectorM3.outer : ℝ) := hall 3
    have hR0 : |(y t).sx| ≤ (626/8403 : ℝ) := by
      rw [coord0 hp hE]; exact SectorM2.boxR0_le hv2
    have hR1 : |(y t).sz| ≤ (78/2309 : ℝ) := by
      rw [coord1 hp hE]; exact SectorM3.boxR1_le hv3
    have hR2 : |(x t).th| ≤ (441/9707 : ℝ) := by
      rw [coord2 hp hE]; exact SectorM1.boxR2_le hv1
    have hF := facts hp hE ⟨hR0, hR1, hR2⟩ (hu t ht)
    intro k; fin_cases k
    · exact SectorM0.diss _ _ hF
    · exact SectorM1.diss _ _ hF
    · exact SectorM2.diss _ _ hF
    · exact SectorM3.diss _ _ hF

