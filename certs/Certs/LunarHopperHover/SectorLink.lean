/-- **Rigorous residual bounds.** On the region box, every channel satisfies its
sector or peak bound (lemmas of `Dynacert/Sector/Atoms.lean`). -/
theorem facts {p : Params} (hp : p.Bound) {t : ℝ} {v : Inputs} {s ds : States}
    {a : Algebraics} (hE : Equations t p v s ds a)
    (hR : |a.sx| ≤ (626/8403 : ℝ) ∧ |a.sz| ≤ (78/2309 : ℝ) ∧ |s.th| ≤ (441/9707 : ℝ))
    (hw : |v.wx| ≤ (1/50 : ℝ) ∧ |v.wz| ≤ (1/50 : ℝ) ∧ |v.wq| ≤ (1/10 : ℝ)) :
    Facts (vec s) (sig s a v) := by
  obtain ⟨pv0, pv1, pv2, pv3, pv4⟩ := pvals hp
  obtain ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9⟩ := hE
  try simp only [pv0, pv1, pv2, pv3, pv4] at e0 e1 e2 e3 e4 e5 e6 e7 e8 e9
  obtain ⟨hR0, hR1, hR2⟩ := hR
  obtain ⟨hw0, hw1, hw2⟩ := hw
  have hA2L : |s.th| ≤ (441/9707 : ℝ) := abs_le.mpr ⟨by linarith [(abs_le.mp hR2).1, (abs_le.mp hR2).2], by linarith [(abs_le.mp hR2).1, (abs_le.mp hR2).2]⟩
  have hdef_f : a.f = (Real.sqrt ((a.sx ^ 2) + (((81/50 : ℝ) + ((-1 : ℝ) * a.sz)) ^ 2))) := by
    rw [e2]; try ring_nf
  have hA0s : |a.sx| ≤ (626/8403 : ℝ) := abs_le.mpr ⟨by linarith [(abs_le.mp hR0).1, (abs_le.mp hR0).2], by linarith [(abs_le.mp hR0).1, (abs_le.mp hR0).2]⟩
  have hA0h : ((81/50 : ℝ) + ((-1 : ℝ) * a.sz)) ∈ Icc (183129/115450 : ℝ) (190929/115450 : ℝ) := ⟨by linarith [(abs_le.mp hR1).1, (abs_le.mp hR1).2], by linarith [(abs_le.mp hR1).1, (abs_le.mp hR1).2]⟩
  have hA3L : |s.th| ≤ (441/9707 : ℝ) := abs_le.mpr ⟨by linarith [(abs_le.mp hR2).1, (abs_le.mp hR2).2], by linarith [(abs_le.mp hR2).1, (abs_le.mp hR2).2]⟩
  have hdef_th_d : a.th_d = (Rumoca.atan2 ((-1 : ℝ) * a.sx) ((81/50 : ℝ) + ((-1 : ℝ) * a.sz))) := by
    rw [e3]; try ring_nf
  have hA1y : |((-1 : ℝ) * a.sx)| ≤ (626/8403 : ℝ) := abs_le.mpr ⟨by linarith [(abs_le.mp hR0).1, (abs_le.mp hR0).2], by linarith [(abs_le.mp hR0).1, (abs_le.mp hR0).2]⟩
  have hA1h : ((81/50 : ℝ) + ((-1 : ℝ) * a.sz)) ∈ Icc (183129/115450 : ℝ) (190929/115450 : ℝ) := ⟨by linarith [(abs_le.mp hR1).1, (abs_le.mp hR1).2], by linarith [(abs_le.mp hR1).1, (abs_le.mp hR1).2]⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · obtain ⟨δ, hδ, hk⟩ := sin_sub_self_gain (lo := (-43/125000 : ℝ)) (hi := (0 : ℝ)) hA2L (by norm_num) (by norm_num)
    refine ⟨δ, hδ, ?_⟩
    simp only [sig, ch0, Q0 , vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
    linear_combination hk
  · have hδ : Real.sin s.th ∈ Icc (-5679/125000 : ℝ) (5679/125000 : ℝ) := gain_of_abs (abs_sin_le_of hA2L) (by norm_num) (by norm_num)
    refine ⟨Real.sin s.th, hδ, ?_⟩
    simp only [sig, ch1, Q1 , vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
    linear_combination (((-1 : ℝ) * (Real.sin s.th))) * e1
  · have hf0 : |a.f - ((81/50 : ℝ) + ((-1 : ℝ) * a.sz))| ≤ (7/4000 : ℝ) := (by rw [hdef_f]; exact (abs_sqrt_sub_le (b := (626/8403 : ℝ)) (h0 := (183129/115450 : ℝ)) (by norm_num) hA0h.1 hA0s).trans (by norm_num))
    have hf1 : |Real.sin s.th| ≤ (5679/125000 : ℝ) := ((abs_sin_le_of hA2L).trans (by norm_num))
    have heq : sig s a v 2 = (a.f - ((81/50 : ℝ) + ((-1 : ℝ) * a.sz))) * (Real.sin s.th) := by
      simp only [sig, ch2, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
      ring
    rw [heq]
    exact (abs_mul_le_of hf0 hf1).trans (by norm_num)
  · have hf0 : |a.f - ((81/50 : ℝ) + ((-1 : ℝ) * a.sz))| ≤ (7/4000 : ℝ) := (by rw [hdef_f]; exact (abs_sqrt_sub_le (b := (626/8403 : ℝ)) (h0 := (183129/115450 : ℝ)) (by norm_num) hA0h.1 hA0s).trans (by norm_num))
    have heq : sig s a v 3 = (a.f - ((81/50 : ℝ) + ((-1 : ℝ) * a.sz))) := by
      simp only [sig, ch3, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
      ring
    rw [heq]
    exact hf0.trans (by norm_num)
  · have hf0 : |a.f| ≤ (1655531/1000000 : ℝ) := (by rw [hdef_f]; exact (abs_sqrt_le (b := (626/8403 : ℝ)) (h0 := (183129/115450 : ℝ)) (h1 := (190929/115450 : ℝ)) (by norm_num) hA0h hA0s).trans (by norm_num))
    have hf1 : |Real.cos s.th - 1| ≤ (129/125000 : ℝ) := ((abs_cos_sub_one_le hA3L).trans (by norm_num))
    have heq : sig s a v 4 = (a.f) * (Real.cos s.th - 1) := by
      simp only [sig, ch4, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
      ring
    rw [heq]
    exact (abs_mul_le_of hf0 hf1).trans (by norm_num)
  · obtain ⟨δ, hδ, hk⟩ := atan2_sub_gain (h0 := (183129/115450 : ℝ)) (h1 := (190929/115450 : ℝ)) (b := (626/8403 : ℝ)) (k := (50/81 : ℝ)) (lo := (-6527/500000 : ℝ)) (hi := (6573/500000 : ℝ)) (by norm_num) hA1h hA1y (by norm_num) (by norm_num) (by norm_num)
    refine ⟨δ, hδ, ?_⟩
    simp only [sig, ch5, Q2 , vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
    linear_combination hk + (((-1 : ℝ) * δ)) * e0 + ((1 : ℝ)) * hdef_th_d
  · simpa [sig] using hw0
  · simpa [sig] using hw1
  · simpa [sig] using hw2

