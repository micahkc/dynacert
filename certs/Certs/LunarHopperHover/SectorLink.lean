theorem coord2 {p : Params} (hp : p.Bound) {t : ℝ} {v : Inputs}
    {s ds : States} {a : Algebraics} (hE : Equations t p v s ds a) :
    s.th = (1 : ℝ) * vec s 4 := by
  obtain ⟨pv0, pv1, pv2, pv3, pv4⟩ := pvals hp
  obtain ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9⟩ := hE
  try simp only [pv0, pv1, pv2, pv3, pv4] at e0 e1 e2 e3 e4 e5 e6 e7 e8 e9
  simp only [vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val]
