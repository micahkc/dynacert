/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `e`, `ev`. -/
def vec (s : States) (v : Inputs) : Fin 2 → ℝ :=
  ![(1 : ℝ) * s.x + (-1 : ℝ) * v.x_ref, (1 : ℝ) * s.v + (-1 : ℝ) * v.v_ref]
/-- Disturbance channels: `d`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.d]

/-- Vertex matrices of the polytope of systems (corners of the parameter box). -/
def As : Fin 2 → Matrix (Fin 2) (Fin 2) ℚ :=
  ![!![0, 1; -3, -9/10],
    !![0, 1; -3, -11/10]]
def Bm : Matrix (Fin 2) (Fin 1) ℚ := !![0; 1]

/-- Interpolation weights of the actual parameters. -/
noncomputable def weights (p : Params) : Fin 2 → ℝ :=
  ![(((3/10 : ℝ) - p.c) / (1/5 : ℝ)), ((p.c - (1/10 : ℝ)) / (1/5 : ℝ))]

theorem f_apply (wt : Fin 2 → ℝ) (z : Fin 2 → ℝ) (w : Fin 1 → ℝ) :
    (∑ i, wt i • toReal (As i)) *ᵥ z + toReal Bm *ᵥ w = ![wt 0 * ((1 : ℝ) * (z 1)) + wt 1 * ((1 : ℝ) * (z 1)), wt 0 * ((-3 : ℝ) * (z 0) + (-9/10 : ℝ) * (z 1)) + wt 1 * ((-3 : ℝ) * (z 0) + (-11/10 : ℝ) * (z 1)) + (1 : ℝ) * (w 0)] := by
  funext i
  fin_cases i <;>
    simp [As, Bm, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (1.0 : ℝ) = 1 := by norm_num
theorem lit1 : (0.2 : ℝ) = 1/5 := by norm_num
theorem lit2 : (2.0 : ℝ) = 2 := by norm_num
theorem lit3 : (0.8 : ℝ) = 4/5 := by norm_num

theorem weights_nonneg {p : Params} (hp : Spec.ParamsOK p) : ∀ i, 0 ≤ weights p i := by
  obtain ⟨hb0, hl1, hh1, hb2, hb3, hb4⟩ := hp
  intro i
  fin_cases i
  · show (0 : ℝ) ≤ (((3/10 : ℝ) - p.c) / (1/5 : ℝ))
    exact (div_nonneg (by linarith) (by norm_num))
  · show (0 : ℝ) ≤ ((p.c - (1/10 : ℝ)) / (1/5 : ℝ))
    exact (div_nonneg (by linarith) (by norm_num))

theorem weights_sum (p : Params) : ∑ i, weights p i = 1 := by
  simp [weights, Fin.sum_univ_succ]
  ring

theorem link {p : Params} (hp : Spec.ParamsOK p) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    ContinuousOn (fun t => vec (x t) (u t)) (Icc 0 T) ∧ ∀ t ∈ Ico 0 T,
      HasDerivWithinAt (fun t => vec (x t) (u t))
        ((∑ i, weights p i • toReal (As i)) *ᵥ vec (x t) (u t) + toReal Bm *ᵥ dist (u t))
        (Ici t) t := by
  obtain ⟨hb0, hl1, hh1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hc0, hc1, hder⟩ := h
  obtain ⟨hrc0, hrc1, hrder⟩ := hr
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).x + (-1 : ℝ) * (u s).x_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc0)).add (continuousOn_const.mul hrc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).v + (-1 : ℝ) * (u s).v_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc1)).add (continuousOn_const.mul hrc1)
  · obtain ⟨hd0, hd1, ⟨e0, e1, e2, e3, e4, e5⟩⟩ := hder t ht
    obtain ⟨hrd0, hrd1⟩ := hrder t ht
    try simp only [hb0, hb2, hb3, hb4, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).x + (-1 : ℝ) * (u s).x_ref) _ (Ici t) t
      refine (((hd0.const_mul (1 : ℝ))).add (hrd0.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).x + (-1 : ℝ) * (u t).v_ref = ((((3/10 : ℝ) - p.c) / (1/5 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref)) + (((p.c - (1/10 : ℝ)) / (1/5 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref))
      linear_combination (1 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).v + (-1 : ℝ) * (u s).v_ref) _ (Ici t) t
      refine (((hd1.const_mul (1 : ℝ))).add (hrd1.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).v + (-1 : ℝ) * (u t).a_ref = ((((3/10 : ℝ) - p.c) / (1/5 : ℝ))) * ((-3 : ℝ) * ((1 : ℝ) * (x t).x + (-1 : ℝ) * (u t).x_ref) + (-9/10 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref)) + (((p.c - (1/10 : ℝ)) / (1/5 : ℝ))) * ((-3 : ℝ) * ((1 : ℝ) * (x t).x + (-1 : ℝ) * (u t).x_ref) + (-11/10 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref)) + (1 : ℝ) * ((u t).d)
      linear_combination (-2 : ℝ) * e0 + (-4/5 : ℝ) * e1 + (1 : ℝ) * e2 + (1 : ℝ) * e3 + (1 : ℝ) * e5

