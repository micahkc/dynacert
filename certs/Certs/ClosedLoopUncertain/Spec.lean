namespace ClosedLoopUncertain.Spec

open Set ClosedLoopUncertain

/-- Admissible disturbances: componentwise peak bounds. -/
def Admissible (u : ℝ → Inputs) (T : ℝ) : Prop :=
  ∀ t ∈ Ico 0 T, |(u t).d| ≤ (1 : ℝ)

/-- Reference signals: continuous on `[0, T]` with the declared right
derivatives on `[0, T)`. -/
def References (u : ℝ → Inputs) (T : ℝ) : Prop :=
  ContinuousOn (fun s => (u s).x_ref) (Icc 0 T) ∧
  ContinuousOn (fun s => (u s).v_ref) (Icc 0 T) ∧
  ∀ t ∈ Ico 0 T, HasDerivWithinAt (fun s => (u s).x_ref) (u t).v_ref (Ici t) t ∧
    HasDerivWithinAt (fun s => (u s).v_ref) (u t).a_ref (Ici t) t

/-- Reference values at `t = 0`. -/
def ReferenceStart (u : ℝ → Inputs) : Prop :=
  (u 0).x_ref = (0 : ℝ) ∧ (u 0).v_ref = (0 : ℝ)

/-- Parameter values: the model's bindings, with the uncertain parameters
ranging over their annotated intervals. -/
def ParamsOK (p : Params) : Prop :=
  p.m = (1 : ℝ) ∧
  (1/10 : ℝ) ≤ p.c ∧ p.c ≤ (3/10 : ℝ) ∧
  p.k = (1 : ℝ) ∧
  p.kp = (2 : ℝ) ∧
  p.kd = (4/5 : ℝ)

/-- **The claim.** Every solution with admissible parameter values, admissible
disturbances, the declared references, and the model's initial condition keeps
`e`, `ev` within the bounds `b`. -/
def Claim (b : Fin 2 → ℚ) : Prop :=
  ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) (T : ℝ),
    ParamsOK p → IsSolutionOn p u x y T → Admissible u T → References u T →
    ReferenceStart u → Initial p (x 0) →
    (∀ t ∈ Ico 0 T, |(y t).e| ≤ (b 0 : ℝ) ∧ |(y t).ev| ≤ (b 1 : ℝ))

end ClosedLoopUncertain.Spec
