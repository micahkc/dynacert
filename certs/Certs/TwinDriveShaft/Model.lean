/-- The continuous equations of `TwinDriveShaft` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  dx.«a.th» = x.«a.w»
  ∧ dx.«a.w» = -(p.«a.k» * x.«a.th») - p.«a.c» * x.«a.w» + y.«a.T»
  ∧ dx.«b.th» = x.«b.w»
  ∧ dx.«b.w» = -(p.«b.k» * x.«b.th») - p.«b.c» * x.«b.w» + y.«b.T»
