/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `a.th`, `a.w`, `b.th`, `b.w`. -/
def vec (s : States) (v : Inputs) : Fin 4 → ℝ :=
  ![(1 : ℝ) * s.«a.th», (1 : ℝ) * s.«a.w», (1 : ℝ) * s.«b.th», (1 : ℝ) * s.«b.w»]
/-- Disturbance channels: `d1`, `d2`. -/
def dist (v : Inputs) : Fin 2 → ℝ := ![v.d1, v.d2]

def model : LTIModel 4 2 where
  A := !![0, 1, 0, 0; -43/10, -3, 3/10, 0; 0, 0, 0, 1; 3/10, 0, -93/10, -5]
  B := !![0, 0; 1, 0; 0, 0; 0, 1]

theorem f_apply (z : Fin 4 → ℝ) (w : Fin 2 → ℝ) :
    model.toSystem.f z w = ![(1 : ℝ) * (z 1), (-43/10 : ℝ) * (z 0) + (-3 : ℝ) * (z 1) + (3/10 : ℝ) * (z 2) + (1 : ℝ) * (w 0), (1 : ℝ) * (z 3), (3/10 : ℝ) * (z 0) + (-93/10 : ℝ) * (z 2) + (-5 : ℝ) * (z 3) + (1 : ℝ) * (w 1)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (0.3 : ℝ) = 3/10 := by norm_num
theorem lit1 : (4.0 : ℝ) = 4 := by norm_num
theorem lit2 : (3.0 : ℝ) = 3 := by norm_num
theorem lit3 : (9.0 : ℝ) = 9 := by norm_num
theorem lit4 : (5.0 : ℝ) = 5 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hc3, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«a.th») (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«a.w») (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«b.th») (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«b.w») (Icc 0 T)
      exact (continuousOn_const.mul hc3)
  · obtain ⟨hd0, hd1, hd2, hd3, ⟨e0, e1, e2, e3, e4, e5⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3 e4 e5
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«a.th») _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«a.th» = (1 : ℝ) * ((1 : ℝ) * (x t).«a.w»)
      linear_combination (1 : ℝ) * e0
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«a.w») _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«a.w» = (-43/10 : ℝ) * ((1 : ℝ) * (x t).«a.th») + (-3 : ℝ) * ((1 : ℝ) * (x t).«a.w») + (3/10 : ℝ) * ((1 : ℝ) * (x t).«b.th») + (1 : ℝ) * ((u t).d1)
      linear_combination (1 : ℝ) * e1 + (1 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«b.th») _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«b.th» = (1 : ℝ) * ((1 : ℝ) * (x t).«b.w»)
      linear_combination (1 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«b.w») _ (Ici t) t
      refine ((hd3.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«b.w» = (3/10 : ℝ) * ((1 : ℝ) * (x t).«a.th») + (-93/10 : ℝ) * ((1 : ℝ) * (x t).«b.th») + (-5 : ℝ) * ((1 : ℝ) * (x t).«b.w») + (1 : ℝ) * ((u t).d2)
      linear_combination (1 : ℝ) * e3 + (1 : ℝ) * e5

