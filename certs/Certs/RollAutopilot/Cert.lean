/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `phi`, `p`, `da`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.phi, (1 : ℝ) * s.p, (1 : ℝ) * s.da]
/-- Disturbance channels: `L_dist`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.L_dist]

/-- Vertex matrices of the polytope of systems (corners of the parameter box). -/
def As : Fin 2 → Matrix (Fin 3) (Fin 3) ℚ :=
  ![!![0, 1, 0; 0, -5/2, 8; -25, -15/2, -25/2],
    !![0, 1, 0; 0, -4/5, 8; -25, -15/2, -25/2]]
def Bm : Matrix (Fin 3) (Fin 1) ℚ := !![0; 1; 0]

/-- Interpolation weights of the actual parameters. -/
noncomputable def weights (p : Params) : Fin 2 → ℝ :=
  ![(((-4/5 : ℝ) - p.L_p) / (17/10 : ℝ)), ((p.L_p - (-5/2 : ℝ)) / (17/10 : ℝ))]

theorem f_apply (wt : Fin 2 → ℝ) (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    (∑ i, wt i • toReal (As i)) *ᵥ z + toReal Bm *ᵥ w = ![wt 0 * ((1 : ℝ) * (z 1)) + wt 1 * ((1 : ℝ) * (z 1)), wt 0 * ((-5/2 : ℝ) * (z 1) + (8 : ℝ) * (z 2)) + wt 1 * ((-4/5 : ℝ) * (z 1) + (8 : ℝ) * (z 2)) + (1 : ℝ) * (w 0), wt 0 * ((-25 : ℝ) * (z 0) + (-15/2 : ℝ) * (z 1) + (-25/2 : ℝ) * (z 2)) + wt 1 * ((-25 : ℝ) * (z 0) + (-15/2 : ℝ) * (z 1) + (-25/2 : ℝ) * (z 2))] := by
  funext i
  fin_cases i <;>
    simp [As, Bm, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (1.5 : ℝ) = 3/2 := by norm_num
theorem lit1 : (8.0 : ℝ) = 8 := by norm_num
theorem lit2 : (0.08 : ℝ) = 2/25 := by norm_num
theorem lit3 : (2.0 : ℝ) = 2 := by norm_num
theorem lit4 : (0.6 : ℝ) = 3/5 := by norm_num

theorem weights_nonneg {p : Params} (hp : Spec.ParamsOK p) : ∀ i, 0 ≤ weights p i := by
  obtain ⟨hl0, hh0, hb1, hb2, hb3, hb4⟩ := hp
  intro i
  fin_cases i
  · show (0 : ℝ) ≤ (((-4/5 : ℝ) - p.L_p) / (17/10 : ℝ))
    exact (div_nonneg (by linarith) (by norm_num))
  · show (0 : ℝ) ≤ ((p.L_p - (-5/2 : ℝ)) / (17/10 : ℝ))
    exact (div_nonneg (by linarith) (by norm_num))

theorem weights_sum (p : Params) : ∑ i, weights p i = 1 := by
  simp [weights, Fin.sum_univ_succ]
  ring

theorem link {p : Params} (hp : Spec.ParamsOK p) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    ContinuousOn (fun t => vec (x t) (u t)) (Icc 0 T) ∧ ∀ t ∈ Ico 0 T,
      HasDerivWithinAt (fun t => vec (x t) (u t))
        ((∑ i, weights p i • toReal (As i)) *ᵥ vec (x t) (u t) + toReal Bm *ᵥ dist (u t))
        (Ici t) t := by
  obtain ⟨hl0, hh0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).phi) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).p) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).da) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3⟩⟩ := hder t ht
    try simp only [hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).phi) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).phi = ((((-4/5 : ℝ) - p.L_p) / (17/10 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).p)) + (((p.L_p - (-5/2 : ℝ)) / (17/10 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).p))
      linear_combination (1 : ℝ) * e1
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).p) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).p = ((((-4/5 : ℝ) - p.L_p) / (17/10 : ℝ))) * ((-5/2 : ℝ) * ((1 : ℝ) * (x t).p) + (8 : ℝ) * ((1 : ℝ) * (x t).da)) + (((p.L_p - (-5/2 : ℝ)) / (17/10 : ℝ))) * ((-4/5 : ℝ) * ((1 : ℝ) * (x t).p) + (8 : ℝ) * ((1 : ℝ) * (x t).da)) + (1 : ℝ) * ((u t).L_dist)
      linear_combination (1 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).da) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).da = ((((-4/5 : ℝ) - p.L_p) / (17/10 : ℝ))) * ((-25 : ℝ) * ((1 : ℝ) * (x t).phi) + (-15/2 : ℝ) * ((1 : ℝ) * (x t).p) + (-25/2 : ℝ) * ((1 : ℝ) * (x t).da)) + (((p.L_p - (-5/2 : ℝ)) / (17/10 : ℝ))) * ((-25 : ℝ) * ((1 : ℝ) * (x t).phi) + (-15/2 : ℝ) * ((1 : ℝ) * (x t).p) + (-25/2 : ℝ) * ((1 : ℝ) * (x t).da))
      linear_combination (25/2 : ℝ) * e0 + (25/2 : ℝ) * e3

