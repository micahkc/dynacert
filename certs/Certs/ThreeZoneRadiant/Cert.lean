/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `z1.T`, `z2.T`, `z3.T`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.«z1.T», (1 : ℝ) * s.«z2.T», (1 : ℝ) * s.«z3.T»]
/-- Disturbance channels: `d1`, `d2`, `d3`. -/
def dist (v : Inputs) : Fin 3 → ℝ := ![v.d1, v.d2, v.d3]

def model : LTIModel 3 3 where
  A := !![-27/20, 3/20, 0; 3/20, -9/5, 3/20; 0, 3/20, -23/20]
  B := !![1, 0, 0; 0, 1, 0; 0, 0, 1]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 3 → ℝ) :
    model.toSystem.f z w = ![(-27/20 : ℝ) * (z 0) + (3/20 : ℝ) * (z 1) + (1 : ℝ) * (w 0), (3/20 : ℝ) * (z 0) + (-9/5 : ℝ) * (z 1) + (3/20 : ℝ) * (z 2) + (1 : ℝ) * (w 1), (3/20 : ℝ) * (z 1) + (-23/20 : ℝ) * (z 2) + (1 : ℝ) * (w 2)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (0.15 : ℝ) = 3/20 := by norm_num
theorem lit1 : (1.2 : ℝ) = 6/5 := by norm_num
theorem lit2 : (1.5 : ℝ) = 3/2 := by norm_num
theorem lit3 : (1.0 : ℝ) = 1 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«z1.T») (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«z2.T») (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«z3.T») (Icc 0 T)
      exact (continuousOn_const.mul hc2)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3, e4, e5⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«z1.T») _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«z1.T» = (-27/20 : ℝ) * ((1 : ℝ) * (x t).«z1.T») + (3/20 : ℝ) * ((1 : ℝ) * (x t).«z2.T») + (1 : ℝ) * ((u t).d1)
      linear_combination (1 : ℝ) * e0 + (1 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«z2.T») _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«z2.T» = (3/20 : ℝ) * ((1 : ℝ) * (x t).«z1.T») + (-9/5 : ℝ) * ((1 : ℝ) * (x t).«z2.T») + (3/20 : ℝ) * ((1 : ℝ) * (x t).«z3.T») + (1 : ℝ) * ((u t).d2)
      linear_combination (1 : ℝ) * e1 + (1 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«z3.T») _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«z3.T» = (3/20 : ℝ) * ((1 : ℝ) * (x t).«z2.T») + (-23/20 : ℝ) * ((1 : ℝ) * (x t).«z3.T») + (1 : ℝ) * ((u t).d3)
      linear_combination (1 : ℝ) * e2 + (1 : ℝ) * e5

