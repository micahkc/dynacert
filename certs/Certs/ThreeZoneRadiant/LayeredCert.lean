  A := !![-27/20]
  B := !![1, 3/20]

theorem f_apply0 (z : Fin 1 → ℝ) (w : Fin 2 → ℝ) :
    model0.toSystem.f z w = ![(-27/20 : ℝ) * (z 0) + (1 : ℝ) * (w 0) + (3/20 : ℝ) * (w 1)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model0, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem link0 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) :
    model0.toSystem.IsSolution (fun t => vec0 (x t)) (fun t => dist0 (x t) (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · exact hc0
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3, e4, e5⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (x s).«z1.T») _ (Ici t) t
      refine hd0.congr_deriv ?_
      rw [f_apply0]
      show (dx t).«z1.T» = (-27/20 : ℝ) * ((x t).«z1.T») + (1 : ℝ) * ((u t).d1) + (3/20 : ℝ) * ((x t).«z2.T»)
      linear_combination (1 : ℝ) * e0 + (1 : ℝ) * e3

