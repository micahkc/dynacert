/-! ### Composition -/

/-- Every layer's guarantee, as one statement over the coupling signals. -/
theorem guarantee {p : Params} {u : ℝ → Inputs} {x : ℝ → States} {y : ℝ → Algebraics}
    {T : ℝ} (hp : p.Bound) (h : IsSolutionOn p u x y T) (hu : Spec.Admissible u T)
    (h0 : Initial p (x 0)) :
    ∀ τ ∈ Icc 0 T, (∀ j, ∀ t ∈ Ico 0 τ, sig (x t) j ≤ (Bsig j : ℝ)) →
      ∀ i, ∀ t ∈ Icc 0 τ, sig (x t) i ≤ (Csig i : ℝ) := by
  intro τ hτ hA i t ht
  fin_cases i
  · have hb := box0_0.abs_le (guar0 hp h hu h0 hτ.2 hA t ht)
    simp only [vec0, dotProduct, Fin.sum_univ_succ, Fin.sum_univ_zero] at hb
    simp only [sig, Csig]
    norm_num at hb ⊢
    linarith
  · have hb := box1_0.abs_le (guar1 hp h hu h0 hτ.2 hA t ht)
    simp only [vec1, dotProduct, Fin.sum_univ_succ, Fin.sum_univ_zero] at hb
    simp only [sig, Csig]
    norm_num at hb ⊢
    linarith
  · have hb := box2_0.abs_le (guar2 hp h hu h0 hτ.2 hA t ht)
    simp only [vec2, dotProduct, Fin.sum_univ_succ, Fin.sum_univ_zero] at hb
    simp only [sig, Csig]
    norm_num at hb ⊢
    linarith

/-- **Mutual first exit.** The coupling signals stay within `Csig` on all of `[0, T]`. -/
theorem signals {p : Params} {u : ℝ → Inputs} {x : ℝ → States} {y : ℝ → Algebraics}
    {T : ℝ} (hp : p.Bound) (h : IsSolutionOn p u x y T) (hu : Spec.Admissible u T)
    (h0 : Initial p (x 0)) : ∀ i, ∀ t ∈ Icc 0 T, sig (x t) i ≤ (Csig i : ℝ) := by
  have hcont : ∀ i, ContinuousOn (fun t => sig (x t) i) (Icc 0 T) := by
    obtain ⟨dx, hc0, hc1, hc2, -⟩ := h
    intro i
    fin_cases i
    · exact continuous_abs.comp_continuousOn hc0
    · exact continuous_abs.comp_continuousOn hc1
    · exact continuous_abs.comp_continuousOn hc2
  exact assume_guarantee (s := fun i t => sig (x t) i) hcont
    (fun i => by exact_mod_cast Csig_lt i) (guarantee hp h hu h0)

/-- **Certified (layered).** The claim of `Spec.lean` holds with the bounds `![4421/5607, 857/2090, 7456/9911]`. -/
theorem certified : Spec.Claim ![4421/5607, 857/2090, 7456/9911] := by
  intro p u x y T hp h hu hr hr0 h0
  have hS := signals hp h hu h0
  have hA : ∀ j, ∀ t ∈ Ico 0 T, sig (x t) j ≤ (Bsig j : ℝ) := fun j t ht =>
    (hS j t ⟨ht.1, ht.2.le⟩).trans (by exact_mod_cast (Csig_lt j).le)
  have hV0 := guar0 hp h hu h0 le_rfl hA
  have hV1 := guar1 hp h hu h0 le_rfl hA
  have hV2 := guar2 hp h hu h0 le_rfl hA
  intro t ht
  refine ⟨?_, ?_, ?_⟩
  · have hb := box0_0.abs_le (hV0 t ht)
    simp only [vec0, dotProduct, Fin.sum_univ_succ, Fin.sum_univ_zero] at hb
    try simp only [Matrix.cons_val]
    norm_num at hb ⊢
    linarith
  · have hb := box1_0.abs_le (hV1 t ht)
    simp only [vec1, dotProduct, Fin.sum_univ_succ, Fin.sum_univ_zero] at hb
    try simp only [Matrix.cons_val]
    norm_num at hb ⊢
    linarith
  · have hb := box2_0.abs_le (hV2 t ht)
    simp only [vec2, dotProduct, Fin.sum_univ_succ, Fin.sum_univ_zero] at hb
    try simp only [Matrix.cons_val]
    norm_num at hb ⊢
    linarith

end ThreeZoneRadiant.LayeredCert
