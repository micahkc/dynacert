/-- Layer 0 guarantee: if the coupling signals respect `Bsig` on `[0, τ)`, the
layer stays in its invariant set on `[0, τ]`. -/
theorem guar0 {p : Params} {u : ℝ → Inputs} {x : ℝ → States} {y : ℝ → Algebraics}
    {T : ℝ} (hp : p.Bound) (h : IsSolutionOn p u x y T) (hu : Spec.Admissible u T)
    (h0 : Initial p (x 0)) {τ : ℝ} (hτ : τ ≤ T)
    (hA : ∀ j, ∀ t ∈ Ico 0 τ, sig (x t) j ≤ (Bsig j : ℝ)) :
    ∀ t ∈ Icc 0 τ, quad (toReal P0) (vec0 (x t)) ≤ (level0 : ℝ) := by
  have hx := (link0 hp h).mono hτ
  have hw : ∀ t ∈ Ico 0 τ, cert0.energy (dist0 (x t) (u t)) ≤
      ∑ j, (γ0 j : ℝ) * ((δ0 j : ℝ) * (δ0 j : ℝ)) := by
    intro t ht
    have hut := hu t ⟨ht.1, ht.2.trans_le hτ⟩
    have ha1 := hA 1 t ht
    simp only [sig, Bsig] at ha1
    refine cert0.energy_le_of_abs_le (δ := δ0) fun j => ?_
    fin_cases j <;> simp [dist0, δ0] <;> simp_all
  have h0' : quad (toReal cert0.P) (vec0 (x 0)) ≤ (level0 : ℝ) := by
    rw [init0 hp h0]; exact init_le0
  exact cert0.invariant hx hw h0' budget_le0

