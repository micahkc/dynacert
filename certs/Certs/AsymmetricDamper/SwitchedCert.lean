namespace AsymmetricDamper.SwitchedCert

open Matrix Set Dynacert Dynacert.Linear AsymmetricDamper

/-! ### Modes

The if-expressions of `Equations`, grouped into switches by their condition chain; a mode
picks one branch of every switch. In mode `m` the model, in coordinates `z`, is
`ż = A_m z + B w`:

* mode 0: `x.v > 0`
* mode 1: `¬(x.v > 0)`
-/

/-- Coordinates: `x`, `v`. -/
def vec (s : States) (v : Inputs) : Fin 2 → ℝ :=
  ![(1 : ℝ) * s.x, (1 : ℝ) * s.v]
/-- Disturbance channels: `f`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.f]

/-- Mode matrices `A_m`. -/
def As : Fin 2 → Matrix (Fin 2) (Fin 2) ℚ :=
  ![!![0, 1; -4, -2],
    !![0, 1; -4, -4/5]]
def Bm : Matrix (Fin 2) (Fin 1) ℚ := !![0; 1]

/-- Indicator of the active mode, written with the model's own conditions (verbatim
from `Equations`, same binders). -/
noncomputable def weights (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Fin 2 → ℝ :=
  ![(if x.v > 0 then (1 : ℝ) else (0 : ℝ)),
    (if x.v > 0 then (0 : ℝ) else (1 : ℝ))]

theorem weights_nonneg (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : ∀ i, 0 ≤ weights t p u x dx y i := by
  intro i
  fin_cases i
  · show (0 : ℝ) ≤ (if x.v > 0 then (1 : ℝ) else (0 : ℝ))
    split_ifs <;> norm_num
  · show (0 : ℝ) ≤ (if x.v > 0 then (0 : ℝ) else (1 : ℝ))
    split_ifs <;> norm_num

theorem weights_sum (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : ∑ i, weights t p u x dx y i = 1 := by
  have h : (if x.v > 0 then (1 : ℝ) else (0 : ℝ)) + (if x.v > 0 then (0 : ℝ) else (1 : ℝ)) = 1 := by
    split_ifs <;> norm_num
  simpa [weights, Fin.sum_univ_succ, add_assoc] using h

theorem f_apply (wt : Fin 2 → ℝ) (z : Fin 2 → ℝ) (w : Fin 1 → ℝ) :
    (∑ i, wt i • toReal (As i)) *ᵥ z + toReal Bm *ᵥ w = ![wt 0 * ((1 : ℝ) * (z 1)) + wt 1 * ((1 : ℝ) * (z 1)), wt 0 * ((-4 : ℝ) * (z 0) + (-2 : ℝ) * (z 1)) + wt 1 * ((-4 : ℝ) * (z 0) + (-4/5 : ℝ) * (z 1)) + (1 : ℝ) * (w 0)] := by
  funext i
  fin_cases i <;>
    simp [As, Bm, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (1.0 : ℝ) = 1 := by norm_num
theorem lit1 : (4.0 : ℝ) = 4 := by norm_num
theorem lit2 : (0.8 : ℝ) = 4/5 := by norm_num
theorem lit3 : (2.0 : ℝ) = 2 := by norm_num

/-- **Pointwise link.** At one instant, the model's equations give each coordinate
derivative as the active mode's linear right-hand side. The `if`-expressions of the
equations and of `weights` are split together. -/
theorem step {t : ℝ} {p : Params} {u : Inputs} {x dx : States} {y : Algebraics} (hp : p.Bound)
    (h : Equations t p u x dx y) :
    (1 : ℝ) * dx.x = (weights t p u x dx y 0) * ((1 : ℝ) * ((1 : ℝ) * x.v)) + (weights t p u x dx y 1) * ((1 : ℝ) * ((1 : ℝ) * x.v)) ∧
    (1 : ℝ) * dx.v = (weights t p u x dx y 0) * ((-4 : ℝ) * ((1 : ℝ) * x.x) + (-2 : ℝ) * ((1 : ℝ) * x.v)) + (weights t p u x dx y 1) * ((-4 : ℝ) * ((1 : ℝ) * x.x) + (-4/5 : ℝ) * ((1 : ℝ) * x.v)) + (1 : ℝ) * (u.f) := by
  obtain ⟨hb0, hb1, hb2, hb3⟩ := hp
  obtain ⟨e0, e1⟩ := h
  show (1 : ℝ) * dx.x = ((if x.v > 0 then (1 : ℝ) else (0 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * x.v)) + ((if x.v > 0 then (0 : ℝ) else (1 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * x.v)) ∧
    (1 : ℝ) * dx.v = ((if x.v > 0 then (1 : ℝ) else (0 : ℝ))) * ((-4 : ℝ) * ((1 : ℝ) * x.x) + (-2 : ℝ) * ((1 : ℝ) * x.v)) + ((if x.v > 0 then (0 : ℝ) else (1 : ℝ))) * ((-4 : ℝ) * ((1 : ℝ) * x.x) + (-4/5 : ℝ) * ((1 : ℝ) * x.v)) + (1 : ℝ) * (u.f)
  split_ifs at e1 ⊢ <;>
    (try simp only [hb0, hb1, hb2, hb3, lit0, lit1, lit2, lit3] at e0 e1) <;>
    exact ⟨by first | linear_combination (1 : ℝ) * e0,
      by first | linear_combination (1 : ℝ) * e1⟩

/-- **Link.** Along a solution, the coordinates obey `ż = Σ_m wt t m • (A_m z + B w)`
with `wt t` the indicator of the mode active at `t`. -/
theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    ∃ wt : ℝ → Fin 2 → ℝ, (∀ t ∈ Ico 0 T, ∀ i, 0 ≤ wt t i) ∧
      (∀ t ∈ Ico 0 T, ∑ i, wt t i = 1) ∧
      ContinuousOn (fun t => vec (x t) (u t)) (Icc 0 T) ∧ ∀ t ∈ Ico 0 T,
        HasDerivWithinAt (fun t => vec (x t) (u t))
          ((∑ i, wt t i • toReal (As i)) *ᵥ vec (x t) (u t) + toReal Bm *ᵥ dist (u t))
          (Ici t) t := by
  obtain ⟨dx, hc0, hc1, hder⟩ := h
  refine ⟨fun t => weights t p (u t) (x t) (dx t) (y t), fun t _ => weights_nonneg t p (u t) (x t) (dx t) (y t),
    fun t _ => weights_sum t p (u t) (x t) (dx t) (y t), ?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).x) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).v) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
  · obtain ⟨hd0, hd1, hE⟩ := hder t ht
    obtain ⟨s0, s1⟩ := step hp hE
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).x) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).x = (weights t p (u t) (x t) (dx t) (y t) 0) * ((1 : ℝ) * ((1 : ℝ) * (x t).v)) + (weights t p (u t) (x t) (dx t) (y t) 1) * ((1 : ℝ) * ((1 : ℝ) * (x t).v))
      exact s0
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).v) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).v = (weights t p (u t) (x t) (dx t) (y t) 0) * ((-4 : ℝ) * ((1 : ℝ) * (x t).x) + (-2 : ℝ) * ((1 : ℝ) * (x t).v)) + (weights t p (u t) (x t) (dx t) (y t) 1) * ((-4 : ℝ) * ((1 : ℝ) * (x t).x) + (-4/5 : ℝ) * ((1 : ℝ) * (x t).v)) + (1 : ℝ) * ((u t).f)
      exact s1

