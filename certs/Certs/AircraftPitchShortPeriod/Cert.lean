/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `alpha`, `q`, `theta`, `de`. -/
def vec (s : States) (v : Inputs) : Fin 4 → ℝ :=
  ![(1 : ℝ) * s.alpha, (1 : ℝ) * s.q, (1 : ℝ) * s.theta, (1 : ℝ) * s.de]
/-- Disturbance channels: `alpha_g`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.alpha_g]

def model : LTIModel 4 1 where
  A := !![-1, 1, 0, -1/10; -4, -3/2, 0, -6; 0, 1, 0, 0; 0, 16, 40, -20]
  B := !![-1; -4; 0; 0]

theorem f_apply (z : Fin 4 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(-1 : ℝ) * (z 0) + (1 : ℝ) * (z 1) + (-1/10 : ℝ) * (z 3) + (-1 : ℝ) * (w 0), (-4 : ℝ) * (z 0) + (-3/2 : ℝ) * (z 1) + (-6 : ℝ) * (z 3) + (-4 : ℝ) * (w 0), (1 : ℝ) * (z 1), (16 : ℝ) * (z 1) + (40 : ℝ) * (z 2) + (-20 : ℝ) * (z 3)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

