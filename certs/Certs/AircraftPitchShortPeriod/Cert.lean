theorem init {p : Params} (hp : p.Bound) {s : States} {v : Inputs} (h0 : Initial p s)
    (hr0 : True) :
    vec s v = fun i => (((![0, 0, 0, 0] : Fin 4 → ℚ) i : ℚ) : ℝ) := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7⟩ := hp
  obtain ⟨i0, i1, i2, i3⟩ := h0
  funext i
  fin_cases i <;>
    simp [vec, hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7, lit0, lit1, lit2, lit3, lit4, lit5, lit6, lit7, i0, i1, i2, i3] <;> norm_num

