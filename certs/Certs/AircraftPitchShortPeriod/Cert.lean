theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hc3, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).alpha) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).q) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).theta) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).de) (Icc 0 T)
      exact (continuousOn_const.mul hc3)
  · obtain ⟨hd0, hd1, hd2, hd3, ⟨e0, e1, e2, e3, e4⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7, lit0, lit1, lit2, lit3, lit4, lit5, lit6, lit7] at e0 e1 e2 e3 e4
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).alpha) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).alpha = (-1 : ℝ) * ((1 : ℝ) * (x t).alpha) + (1 : ℝ) * ((1 : ℝ) * (x t).q) + (-1/10 : ℝ) * ((1 : ℝ) * (x t).de) + (-1 : ℝ) * ((u t).alpha_g)
      linear_combination (1 : ℝ) * e1
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).q) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).q = (-4 : ℝ) * ((1 : ℝ) * (x t).alpha) + (-3/2 : ℝ) * ((1 : ℝ) * (x t).q) + (-6 : ℝ) * ((1 : ℝ) * (x t).de) + (-4 : ℝ) * ((u t).alpha_g)
      linear_combination (1 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).theta) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).theta = (1 : ℝ) * ((1 : ℝ) * (x t).q)
      linear_combination (1 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).de) _ (Ici t) t
      refine ((hd3.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).de = (16 : ℝ) * ((1 : ℝ) * (x t).q) + (40 : ℝ) * ((1 : ℝ) * (x t).theta) + (-20 : ℝ) * ((1 : ℝ) * (x t).de)
      linear_combination (20 : ℝ) * e0 + (20 : ℝ) * e4

