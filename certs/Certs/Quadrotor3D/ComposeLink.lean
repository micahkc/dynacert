theorem pvals {p : Params} (hp : p.Bound) :
    p.g = (981/100 : ℝ) ∧ p.Kp = (4 : ℝ) ∧ p.Kv = (4 : ℝ) ∧ p.wn = (10 : ℝ) ∧ p.kw = (20 : ℝ) ∧ p.kR = (5 : ℝ) ∧ p.kpsi = (5 : ℝ) := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5, hb6⟩ := hp
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> norm_num [hb0, hb1, hb2, hb3, hb4, hb5, hb6]

