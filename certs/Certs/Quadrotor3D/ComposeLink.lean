    ContinuousOn (fun t => vec (x t)) (Icc 0 T) ∧
    ∀ t ∈ Ico 0 T, HasDerivWithinAt (fun t => vec (x t))
      (toReal A *ᵥ vec (x t) + toReal B *ᵥ sig (x t) (y t) (u t)) (Ici t) t := by
