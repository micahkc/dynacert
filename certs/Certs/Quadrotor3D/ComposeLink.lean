theorem eqs_at {p : Params} {u : ℝ → Inputs} {x : ℝ → States} {y : ℝ → Algebraics}
    {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ} (ht : t ∈ Ico 0 T) :
    ∃ ds : States, Equations t p (u t) (x t) ds (y t) := by
  obtain ⟨dx, hc0, hc1, hc2, hc3, hc4, hc5, hc6, hc7, hc8, hc9, hc10, hc11, hder⟩ := h
  obtain ⟨hd0, hd1, hd2, hd3, hd4, hd5, hd6, hd7, hd8, hd9, hd10, hd11, hE⟩ := hder t ht
  exact ⟨dx t, hE⟩

theorem init {p : Params} (hp : p.Bound) {s : States} (h0 : Initial p s) :
    vec s = 0 := by
  obtain ⟨pv0, pv1, pv2, pv3, pv4, pv5, pv6⟩ := pvals hp
  obtain ⟨i0, i1, i2, i3, i4, i5, i6, i7, i8, i9, i10, i11⟩ := h0
  funext i
  fin_cases i <;> simp [vec, i0, i1, i2, i3, i4, i5, i6, i7, i8, i9, i10, i11]

