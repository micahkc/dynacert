/-- **Rigorous residual bounds.** On the region box, every channel satisfies its
sector or peak bound (lemmas of `Dynacert/Sector/Atoms.lean`). -/
theorem facts {p : Params} (hp : p.Bound) {t : ℝ} {v : Inputs} {s ds : States}
    {a : Algebraics} (hE : Equations t p v s ds a)
    (hR : |s.qx| ≤ (46/1775 : ℝ) ∧ |s.qy| ≤ (187/7207 : ℝ) ∧ |s.qz| ≤ (89/8310 : ℝ) ∧ |a.s_x| ≤ (3003/5930 : ℝ) ∧ |a.s_z| ≤ (2554/9989 : ℝ) ∧ |a.s_y| ≤ (4387/8666 : ℝ) ∧ |s.p| ≤ (1073/3925 : ℝ) ∧ |s.r| ≤ (1085/9743 : ℝ) ∧ |s.q| ≤ (2342/8567 : ℝ))
    (hw : |v.w_ax| ≤ (1/10 : ℝ) ∧ |v.w_ay| ≤ (1/10 : ℝ) ∧ |v.w_az| ≤ (1/10 : ℝ) ∧ |v.w_p| ≤ (1/2 : ℝ) ∧ |v.w_q| ≤ (1/2 : ℝ) ∧ |v.w_r| ≤ (1/2 : ℝ)) :
    Facts (vec s) (sig s a v) := by
  obtain ⟨pv0, pv1, pv2, pv3, pv4, pv5, pv6⟩ := pvals hp
  obtain ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15, e16, e17, e18, e19, e20, e21⟩ := hE
  try simp only [pv0, pv1, pv2, pv3, pv4, pv5, pv6] at e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14 e15 e16 e17 e18 e19 e20 e21
  obtain ⟨hR0, hR1, hR2, hR3, hR4, hR5, hR6, hR7, hR8⟩ := hR
  obtain ⟨hw0, hw1, hw2, hw3, hw4, hw5⟩ := hw
  have hdef_q0 : a.q0 = (Real.sqrt ((1 : ℝ) + ((-1 : ℝ) * (s.qx ^ 2)) + ((-1 : ℝ) * (s.qy ^ 2)) + ((-1 : ℝ) * (s.qz ^ 2)))) := by
    rw [e0]; try ring_nf
  have hU0 : |a.q0 - 1| ≤ (731/1000000 : ℝ) := by
    rw [hdef_q0, show ((1 : ℝ) + ((-1 : ℝ) * (s.qx ^ 2)) + ((-1 : ℝ) * (s.qy ^ 2)) + ((-1 : ℝ) * (s.qz ^ 2))) = 1 - (s.qx ^ 2 + s.qy ^ 2 + s.qz ^ 2) by ring]
    exact (sqrt_one_sub_sub_one_le (X := (659767180247009821/452030561102807122500 : ℝ)) (by positivity) (by linarith [sq_le_of_abs_le hR0, sq_le_of_abs_le hR1, sq_le_of_abs_le hR2]) (by norm_num)).trans (by norm_num)
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · have habs := (abs_mul_le_of (abs_le.mpr ⟨by norm_num, by norm_num⟩ : |(1 : ℝ)| ≤ (1 : ℝ)) hR0)
    refine ⟨((1 : ℝ) * (s.qx)), gain_of_abs habs (by norm_num) (by norm_num), ?_⟩
    simp only [sig, ch0, Q0, vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
    linear_combination 0
  · have habs := (abs_mul_le_of (abs_le.mpr ⟨by norm_num, by norm_num⟩ : |(-2 : ℝ)| ≤ (2 : ℝ)) hR4)
    refine ⟨((-2 : ℝ) * (a.s_z)), gain_of_abs habs (by norm_num) (by norm_num), ?_⟩
    simp only [sig, ch1, Q1, vec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, Fin.isValue]
    linear_combination 0
  · have habs := (abs_mul_le_of (abs_le.mpr ⟨by norm_num, by norm_num⟩ : |(1 : ℝ)| ≤ (1 : ℝ)) hR1)
    refine ⟨((1 : ℝ) * (s.qy)), gain_of_abs habs (by norm_num) (by norm_num), ?_⟩
