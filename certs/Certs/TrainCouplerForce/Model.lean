def IsSolutionOn (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ) : Prop :=
  ∃ dx : ℝ → States,
    ContinuousOn (fun s => (x s).dv_loco) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).dv_car) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).s) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).xi) (Set.Icc 0 T) ∧
    ∀ t ∈ Set.Ico 0 T,
      HasDerivWithinAt (fun s => (x s).dv_loco) (dx t).dv_loco (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).dv_car) (dx t).dv_car (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).s) (dx t).s (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).xi) (dx t).xi (Set.Ici t) t ∧
