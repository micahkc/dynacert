def IsSolution (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) : Prop :=
  ∃ dx : ℝ → States, ∀ t : ℝ,
    HasDerivAt (fun s => (x s).dv_loco) (dx t).dv_loco t ∧
    HasDerivAt (fun s => (x s).dv_car) (dx t).dv_car t ∧
    HasDerivAt (fun s => (x s).s) (dx t).s t ∧
    HasDerivAt (fun s => (x s).xi) (dx t).xi t ∧
