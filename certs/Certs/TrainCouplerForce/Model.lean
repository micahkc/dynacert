/-- The parameter bindings of the model. -/
def Params.Bound (p : Params) : Prop :=
  p.M_loco = 120.0
  ∧ p.M_car = 100.0
  ∧ p.k_c = 5000.0
  ∧ p.c_c = 50.0
  ∧ p.kv = 400.0
  ∧ p.ki = 40.0

/-- Initial conditions: the `fixed = true` start values of the states. -/
def Initial (p : Params) (x : States) : Prop :=
  x.dv_loco = 0
  ∧ x.dv_car = 0
  ∧ x.s = 0
  ∧ x.xi = 0

/-- The continuous equations of `TrainCouplerForce` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.F_trac = -(p.kv * x.dv_loco) - p.ki * x.xi
  ∧ y.F_c = p.k_c * x.s + p.c_c * (x.dv_loco - x.dv_car)
  ∧ dx.xi = x.dv_loco
  ∧ dx.s = x.dv_loco - x.dv_car
  ∧ p.M_loco * dx.dv_loco = y.F_trac - y.F_c + u.F_g1
  ∧ p.M_car * dx.dv_car = y.F_c + u.F_g2

/-- `x`, `y` is a solution of `TrainCouplerForce` under input `u`: every state
