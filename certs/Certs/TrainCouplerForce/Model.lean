structure Inputs where
  /-- Grade/wind perturbation on locomotive [kN] -/
  F_g1 : ℝ
  /-- Grade/wind perturbation on car [kN] -/
  F_g2 : ℝ

/-- Differentiated variables (also used for their derivatives). -/
structure States where
  /-- Locomotive speed deviation [m/s] -/
  dv_loco : ℝ
  /-- Car speed deviation [m/s] -/
  dv_car : ℝ
  /-- Coupler stretch deviation [m] -/
  s : ℝ
  /-- Integral of locomotive speed deviation [m] -/
  xi : ℝ

/-- Algebraic (non-differentiated) variables. -/
structure Algebraics where
  /-- Coupler force deviation [kN] -/
  F_c : ℝ
  /-- Traction force deviation [kN] -/
