/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `dv_loco`, `dv_car`, `s`, `xi`. -/
def vec (s : States) (v : Inputs) : Fin 4 → ℝ :=
  ![(1 : ℝ) * s.dv_loco, (1 : ℝ) * s.dv_car, (1 : ℝ) * s.s, (1 : ℝ) * s.xi]
/-- Disturbance channels: `F_g1`, `F_g2`. -/
def dist (v : Inputs) : Fin 2 → ℝ := ![v.F_g1, v.F_g2]

def model : LTIModel 4 2 where
  A := !![-15/4, 5/12, -125/3, -1/3; 1/2, -1/2, 50, 0; 1, -1, 0, 0; 1, 0, 0, 0]
  B := !![1/120, 0; 0, 1/100; 0, 0; 0, 0]

theorem f_apply (z : Fin 4 → ℝ) (w : Fin 2 → ℝ) :
    model.toSystem.f z w = ![(-15/4 : ℝ) * (z 0) + (5/12 : ℝ) * (z 1) + (-125/3 : ℝ) * (z 2) + (-1/3 : ℝ) * (z 3) + (1/120 : ℝ) * (w 0), (1/2 : ℝ) * (z 0) + (-1/2 : ℝ) * (z 1) + (50 : ℝ) * (z 2) + (1/100 : ℝ) * (w 1), (1 : ℝ) * (z 0) + (-1 : ℝ) * (z 1), (1 : ℝ) * (z 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

