    (y t).F_c = (fun i => ((![50, -50, 5000, 0] : Fin 4 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![50, -50, 5000, 0] : Fin 4 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (50 : ℝ) * ((1 : ℝ) * (x t).dv_loco) + (-50 : ℝ) * ((1 : ℝ) * (x t).dv_car) + (5000 : ℝ) * ((1 : ℝ) * (x t).s) := by
