theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hc3, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dv_loco) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dv_car) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).s) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).xi) (Icc 0 T)
      exact (continuousOn_const.mul hc3)
  · obtain ⟨hd0, hd1, hd2, hd3, ⟨e0, e1, e2, e3, e4, e5⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, lit0, lit1, lit2, lit3, lit4, lit5] at e0 e1 e2 e3 e4 e5
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dv_loco) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dv_loco = (-15/4 : ℝ) * ((1 : ℝ) * (x t).dv_loco) + (5/12 : ℝ) * ((1 : ℝ) * (x t).dv_car) + (-125/3 : ℝ) * ((1 : ℝ) * (x t).s) + (-1/3 : ℝ) * ((1 : ℝ) * (x t).xi) + (1/120 : ℝ) * ((u t).F_g1)
      linear_combination (1/120 : ℝ) * e0 + (-1/120 : ℝ) * e1 + (1/120 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dv_car) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dv_car = (1/2 : ℝ) * ((1 : ℝ) * (x t).dv_loco) + (-1/2 : ℝ) * ((1 : ℝ) * (x t).dv_car) + (50 : ℝ) * ((1 : ℝ) * (x t).s) + (1/100 : ℝ) * ((u t).F_g2)
      linear_combination (1/100 : ℝ) * e1 + (1/100 : ℝ) * e5
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).s) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).s = (1 : ℝ) * ((1 : ℝ) * (x t).dv_loco) + (-1 : ℝ) * ((1 : ℝ) * (x t).dv_car)
      linear_combination (1 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).xi) _ (Ici t) t
      refine ((hd3.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).xi = (1 : ℝ) * ((1 : ℝ) * (x t).dv_loco)
      linear_combination (1 : ℝ) * e2

