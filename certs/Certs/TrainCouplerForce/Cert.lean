theorem init {p : Params} (hp : p.Bound) {s : States} {v : Inputs} (h0 : Initial p s)
    (hr0 : True) :
    vec s v = fun i => (((![0, 0, 0, 0] : Fin 4 → ℚ) i : ℚ) : ℝ) := by
