namespace VentilatorPressure.Spec

open Set VentilatorPressure

/-- Admissible disturbances: componentwise peak bounds. -/
def Admissible (u : ℝ → Inputs) (T : ℝ) : Prop :=
  ∀ t ∈ Ico 0 T, |(u t).q_leak| ≤ (1/20 : ℝ)

/-- Reference signals: continuous on `[0, T]` with the declared right
derivatives on `[0, T)`. -/
def References (u : ℝ → Inputs) (T : ℝ) : Prop :=
  ContinuousOn (fun s => (u s).P_ref) (Icc 0 T) ∧
  ContinuousOn (fun s => (u s).dP_ref) (Icc 0 T) ∧
  ∀ t ∈ Ico 0 T, HasDerivWithinAt (fun s => (u s).P_ref) (u t).dP_ref (Ici t) t ∧
    HasDerivWithinAt (fun s => (u s).dP_ref) (u t).ddP_ref (Ici t) t

/-- Reference values at `t = 0`. -/
def ReferenceStart (u : ℝ → Inputs) : Prop :=
  (u 0).P_ref = (0 : ℝ) ∧ (u 0).dP_ref = (0 : ℝ)

/-- **The claim.** Every solution with admissible parameter values, admissible
disturbances, the declared references, and the model's initial condition keeps
`e`, `el`, `ei` within the bounds `b`. -/
def Claim (b : Fin 3 → ℚ) : Prop :=
  ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) (T : ℝ),
    p.Bound → IsSolutionOn p u x y T → Admissible u T → References u T →
    ReferenceStart u → Initial p (x 0) →
    (∀ t ∈ Ico 0 T, |(y t).e| ≤ (b 0 : ℝ) ∧ |(y t).el| ≤ (b 1 : ℝ) ∧ |(y t).ei| ≤ (b 2 : ℝ))

end VentilatorPressure.Spec
