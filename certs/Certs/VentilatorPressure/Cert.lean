/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `e`, `el`, `ei`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.Paw + (-1 : ℝ) * v.P_ref + (-1 : ℝ) * v.dP_ref, (1 : ℝ) * s.Pl + (-1 : ℝ) * v.P_ref, (1 : ℝ) * s.xi]
/-- Disturbance channels: `q_leak`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.q_leak]

def model : LTIModel 3 1 where
  A := !![-50, 25, -250; 1, -1, 0; 1, 0, 0]
  B := !![-500; 0; 0]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(-50 : ℝ) * (z 0) + (25 : ℝ) * (z 1) + (-250 : ℝ) * (z 2) + (-500 : ℝ) * (w 0), (1 : ℝ) * (z 0) + (-1 : ℝ) * (z 1), (1 : ℝ) * (z 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (20.0 : ℝ) = 20 := by norm_num
theorem lit1 : (0.05 : ℝ) = 1/20 := by norm_num
theorem lit2 : (0.002 : ℝ) = 1/500 := by norm_num
theorem lit3 : (0.5 : ℝ) = 1/2 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  obtain ⟨hrc0, hrc1, hrder⟩ := hr
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).Paw + (-1 : ℝ) * (u s).P_ref + (-1 : ℝ) * (u s).dP_ref) (Icc 0 T)
      exact (((continuousOn_const.mul hc0)).add (continuousOn_const.mul hrc0)).add (continuousOn_const.mul hrc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).Pl + (-1 : ℝ) * (u s).P_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc1)).add (continuousOn_const.mul hrc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).xi) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8⟩⟩ := hder t ht
    obtain ⟨hrd0, hrd1⟩ := hrder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5 e6 e7 e8
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).Paw + (-1 : ℝ) * (u s).P_ref + (-1 : ℝ) * (u s).dP_ref) _ (Ici t) t
      refine ((((hd0.const_mul (1 : ℝ))).add (hrd0.const_mul (-1 : ℝ))).add (hrd1.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).Paw + (-1 : ℝ) * (u t).dP_ref + (-1 : ℝ) * (u t).ddP_ref = (-50 : ℝ) * ((1 : ℝ) * (x t).Paw + (-1 : ℝ) * (u t).P_ref + (-1 : ℝ) * (u t).dP_ref) + (25 : ℝ) * ((1 : ℝ) * (x t).Pl + (-1 : ℝ) * (u t).P_ref) + (-250 : ℝ) * ((1 : ℝ) * (x t).xi) + (-500 : ℝ) * ((u t).q_leak)
      linear_combination (25 : ℝ) * e0 + (500 : ℝ) * e1 + (-25 : ℝ) * e2 + (500 : ℝ) * e5 + (500 : ℝ) * e7
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).Pl + (-1 : ℝ) * (u s).P_ref) _ (Ici t) t
      refine (((hd1.const_mul (1 : ℝ))).add (hrd0.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).Pl + (-1 : ℝ) * (u t).dP_ref = (1 : ℝ) * ((1 : ℝ) * (x t).Paw + (-1 : ℝ) * (u t).P_ref + (-1 : ℝ) * (u t).dP_ref) + (-1 : ℝ) * ((1 : ℝ) * (x t).Pl + (-1 : ℝ) * (u t).P_ref)
      linear_combination (20 : ℝ) * e8
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).xi) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).xi = (1 : ℝ) * ((1 : ℝ) * (x t).Paw + (-1 : ℝ) * (u t).P_ref + (-1 : ℝ) * (u t).dP_ref)
      linear_combination (-1 : ℝ) * e0 + (1 : ℝ) * e2 + (1 : ℝ) * e6

