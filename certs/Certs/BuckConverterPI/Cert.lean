/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `z`, `e`, `ei`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.z, (1 : ℝ) * s.v + (-1 : ℝ) * v.v_ref, (1 : ℝ) * s.i + (-1 : ℝ) * v.v_ref + (-1 : ℝ) * v.dv_ref]
/-- Disturbance channels: `i_load`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.i_load]

def model : LTIModel 3 1 where
  A := !![0, 1, 0; 0, -1, 1; -100, -60, -5]
  B := !![0; -1; 0]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(1 : ℝ) * (z 1), (-1 : ℝ) * (z 1) + (1 : ℝ) * (z 2) + (-1 : ℝ) * (w 0), (-100 : ℝ) * (z 0) + (-60 : ℝ) * (z 1) + (-5 : ℝ) * (z 2)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (12.0 : ℝ) = 12 := by norm_num
theorem lit1 : (0.1 : ℝ) = 1/10 := by norm_num
theorem lit2 : (1.0 : ℝ) = 1 := by norm_num
theorem lit3 : (0.5 : ℝ) = 1/2 := by norm_num
