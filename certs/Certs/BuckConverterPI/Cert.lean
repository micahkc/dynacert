theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5, hb6⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  obtain ⟨hrc0, hrc1, hrder⟩ := hr
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).z) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).v + (-1 : ℝ) * (u s).v_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc1)).add (continuousOn_const.mul hrc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).i + (-1 : ℝ) * (u s).v_ref + (-1 : ℝ) * (u s).dv_ref) (Icc 0 T)
      exact (((continuousOn_const.mul hc0)).add (continuousOn_const.mul hrc0)).add (continuousOn_const.mul hrc1)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3, e4, e5, e6, e7⟩⟩ := hder t ht
    obtain ⟨hrd0, hrd1⟩ := hrder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, hb6, lit0, lit1, lit2, lit3, lit4, lit5] at e0 e1 e2 e3 e4 e5 e6 e7
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).z) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).z = (1 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref)
      linear_combination (1 : ℝ) * e2 + (1 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).v + (-1 : ℝ) * (u s).v_ref) _ (Ici t) t
      refine (((hd1.const_mul (1 : ℝ))).add (hrd0.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).v + (-1 : ℝ) * (u t).dv_ref = (-1 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref) + (1 : ℝ) * ((1 : ℝ) * (x t).i + (-1 : ℝ) * (u t).v_ref + (-1 : ℝ) * (u t).dv_ref) + (-1 : ℝ) * ((u t).i_load)
      linear_combination (1 : ℝ) * e7
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).i + (-1 : ℝ) * (u s).v_ref + (-1 : ℝ) * (u s).dv_ref) _ (Ici t) t
      refine ((((hd0.const_mul (1 : ℝ))).add (hrd0.const_mul (-1 : ℝ))).add (hrd1.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).i + (-1 : ℝ) * (u t).dv_ref + (-1 : ℝ) * (u t).ddv_ref = (-100 : ℝ) * ((1 : ℝ) * (x t).z) + (-60 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref) + (-5 : ℝ) * ((1 : ℝ) * (x t).i + (-1 : ℝ) * (u t).v_ref + (-1 : ℝ) * (u t).dv_ref)
      linear_combination (5 : ℝ) * e0 + (1 : ℝ) * e1 + (-50 : ℝ) * e2 + (-5 : ℝ) * e3 + (10 : ℝ) * e5 + (10 : ℝ) * e6

