def IsSolutionOn (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ) : Prop :=
  ∃ dx : ℝ → States,
    ContinuousOn (fun s => (x s).th_hub) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).w_hub) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).th_arr) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).w_arr) (Set.Icc 0 T) ∧
    ∀ t ∈ Set.Ico 0 T,
      HasDerivWithinAt (fun s => (x s).th_hub) (dx t).th_hub (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).w_hub) (dx t).w_hub (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).th_arr) (dx t).th_arr (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).w_arr) (dx t).w_arr (Set.Ici t) t ∧
