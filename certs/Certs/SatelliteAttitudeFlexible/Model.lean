  ∧ x.w_hub = 0
  ∧ x.th_arr = 0
  ∧ x.w_arr = 0

/-- The continuous equations of `SatelliteAttitudeFlexible` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.u = -(p.kp * x.th_hub) - p.kd * x.w_hub
  ∧ y.twist = x.th_hub - x.th_arr
  ∧ y.tau_f = p.k_f * y.twist + p.c_f * (x.w_hub - x.w_arr)
  ∧ dx.th_hub = x.w_hub
  ∧ dx.th_arr = x.w_arr
  ∧ p.J_hub * dx.w_hub = y.u + u.tau_d - y.tau_f
  ∧ p.J_arr * dx.w_arr = y.tau_f

/-- `x`, `y` is a solution of `SatelliteAttitudeFlexible` under input `u`: every state
