def IsSolution (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) : Prop :=
  ∃ dx : ℝ → States, ∀ t : ℝ,
    HasDerivAt (fun s => (x s).th_hub) (dx t).th_hub t ∧
    HasDerivAt (fun s => (x s).w_hub) (dx t).w_hub t ∧
    HasDerivAt (fun s => (x s).th_arr) (dx t).th_arr t ∧
    HasDerivAt (fun s => (x s).w_arr) (dx t).w_arr t ∧
