/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `th_hub`, `w_hub`, `th_arr`, `w_arr`. -/
def vec (s : States) (v : Inputs) : Fin 4 → ℝ :=
  ![(1 : ℝ) * s.th_hub, (1 : ℝ) * s.w_hub, (1 : ℝ) * s.th_arr, (1 : ℝ) * s.w_arr]
/-- Disturbance channels: `tau_d`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.tau_d]

def model : LTIModel 4 1 where
  A := !![0, 1, 0, 0; -12/5, -61/25, 8/5, 1/25; 0, 0, 0, 1; 16/3, 2/15, -16/3, -2/15]
  B := !![0; 1/500; 0; 0]

theorem f_apply (z : Fin 4 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(1 : ℝ) * (z 1), (-12/5 : ℝ) * (z 0) + (-61/25 : ℝ) * (z 1) + (8/5 : ℝ) * (z 2) + (1/25 : ℝ) * (z 3) + (1/500 : ℝ) * (w 0), (1 : ℝ) * (z 3), (16/3 : ℝ) * (z 0) + (2/15 : ℝ) * (z 1) + (-16/3 : ℝ) * (z 2) + (-2/15 : ℝ) * (z 3)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

