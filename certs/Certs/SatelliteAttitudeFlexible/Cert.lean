theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hc3, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).th_hub) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).w_hub) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).th_arr) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).w_arr) (Icc 0 T)
      exact (continuousOn_const.mul hc3)
  · obtain ⟨hd0, hd1, hd2, hd3, ⟨e0, e1, e2, e3, e4, e5, e6⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, lit0, lit1, lit2, lit3, lit4, lit5] at e0 e1 e2 e3 e4 e5 e6
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).th_hub) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).th_hub = (1 : ℝ) * ((1 : ℝ) * (x t).w_hub)
      linear_combination (1 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).w_hub) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).w_hub = (-12/5 : ℝ) * ((1 : ℝ) * (x t).th_hub) + (-61/25 : ℝ) * ((1 : ℝ) * (x t).w_hub) + (8/5 : ℝ) * ((1 : ℝ) * (x t).th_arr) + (1/25 : ℝ) * ((1 : ℝ) * (x t).w_arr) + (1/500 : ℝ) * ((u t).tau_d)
      linear_combination (1/500 : ℝ) * e0 + (-8/5 : ℝ) * e1 + (-1/500 : ℝ) * e2 + (1/500 : ℝ) * e5
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).th_arr) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).th_arr = (1 : ℝ) * ((1 : ℝ) * (x t).w_arr)
      linear_combination (1 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).w_arr) _ (Ici t) t
      refine ((hd3.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).w_arr = (16/3 : ℝ) * ((1 : ℝ) * (x t).th_hub) + (2/15 : ℝ) * ((1 : ℝ) * (x t).w_hub) + (-16/3 : ℝ) * ((1 : ℝ) * (x t).th_arr) + (-2/15 : ℝ) * ((1 : ℝ) * (x t).w_arr)
      linear_combination (16/3 : ℝ) * e1 + (1/150 : ℝ) * e2 + (1/150 : ℝ) * e6

