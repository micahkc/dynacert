  /-- main spring stiffness -/
  k : ℝ
  /-- bump-stop stiffness added beyond the free travel -/
  kStop : ℝ
  /-- free travel before the bump stop engages -/
  xFree : ℝ
  /-- velocity above which the high-speed valves open -/
  vKnee : ℝ
  /-- high-speed rebound damping -/
  cReb : ℝ
  /-- high-speed compression damping -/
  cComp : ℝ
  /-- low-speed bleed damping -/
  cBleed : ℝ

/-- Inputs. -/
structure Inputs where
  /-- road / load force -/
