/-- **Pointwise link.** At one instant, the model's equations give each coordinate
derivative as the active mode's linear right-hand side. The `if`-expressions of the
equations and of `weights` are split together. -/
theorem step {t : ℝ} {p : Params} {u : Inputs} {x dx : States} {y : Algebraics} (hp : p.Bound)
    (h : Equations t p u x dx y) :
    (1 : ℝ) * dx.x = (weights t p u x dx y 0) * ((1 : ℝ) * ((1 : ℝ) * x.v)) + (weights t p u x dx y 1) * ((1 : ℝ) * ((1 : ℝ) * x.v)) + (weights t p u x dx y 2) * ((1 : ℝ) * ((1 : ℝ) * x.v)) + (weights t p u x dx y 3) * ((1 : ℝ) * ((1 : ℝ) * x.v)) + (weights t p u x dx y 4) * ((1 : ℝ) * ((1 : ℝ) * x.v)) + (weights t p u x dx y 5) * ((1 : ℝ) * ((1 : ℝ) * x.v)) ∧
    (1 : ℝ) * dx.v = (weights t p u x dx y 0) * ((-8 : ℝ) * ((1 : ℝ) * x.x) + (-2 : ℝ) * ((1 : ℝ) * x.v)) + (weights t p u x dx y 1) * ((-4 : ℝ) * ((1 : ℝ) * x.x) + (-2 : ℝ) * ((1 : ℝ) * x.v)) + (weights t p u x dx y 2) * ((-8 : ℝ) * ((1 : ℝ) * x.x) + (-6/5 : ℝ) * ((1 : ℝ) * x.v)) + (weights t p u x dx y 3) * ((-4 : ℝ) * ((1 : ℝ) * x.x) + (-6/5 : ℝ) * ((1 : ℝ) * x.v)) + (weights t p u x dx y 4) * ((-8 : ℝ) * ((1 : ℝ) * x.x) + (-3 : ℝ) * ((1 : ℝ) * x.v)) + (weights t p u x dx y 5) * ((-4 : ℝ) * ((1 : ℝ) * x.x) + (-3 : ℝ) * ((1 : ℝ) * x.v)) + (1 : ℝ) * (u.f) := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7⟩ := hp
  obtain ⟨e0, e1⟩ := h
  show (1 : ℝ) * dx.x = ((if x.v > p.vKnee then (1 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * x.v)) + ((if x.v > p.vKnee then (1 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * x.v)) + ((if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (1 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * x.v)) + ((if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (1 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * x.v)) + ((if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (1 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * x.v)) + ((if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (1 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * x.v)) ∧
    (1 : ℝ) * dx.v = ((if x.v > p.vKnee then (1 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ))) * ((-8 : ℝ) * ((1 : ℝ) * x.x) + (-2 : ℝ) * ((1 : ℝ) * x.v)) + ((if x.v > p.vKnee then (1 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ))) * ((-4 : ℝ) * ((1 : ℝ) * x.x) + (-2 : ℝ) * ((1 : ℝ) * x.v)) + ((if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (1 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ))) * ((-8 : ℝ) * ((1 : ℝ) * x.x) + (-6/5 : ℝ) * ((1 : ℝ) * x.v)) + ((if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (1 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ))) * ((-4 : ℝ) * ((1 : ℝ) * x.x) + (-6/5 : ℝ) * ((1 : ℝ) * x.v)) + ((if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (1 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ))) * ((-8 : ℝ) * ((1 : ℝ) * x.x) + (-3 : ℝ) * ((1 : ℝ) * x.v)) + ((if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (1 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ))) * ((-4 : ℝ) * ((1 : ℝ) * x.x) + (-3 : ℝ) * ((1 : ℝ) * x.v)) + (1 : ℝ) * (u.f)
  split_ifs at e1 ⊢ <;>
    (try simp only [hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7, lit0, lit1, lit2, lit3, lit4, lit5, lit6] at e0 e1) <;>
    exact ⟨by first | linear_combination (1 : ℝ) * e0,
      by first | linear_combination (1 : ℝ) * e1⟩

/-- **Link.** Along a solution, the coordinates obey `ż = Σ_m wt t m • (A_m z + B w)`
with `wt t` the indicator of the mode active at `t`. -/
theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    ∃ wt : ℝ → Fin 6 → ℝ, (∀ t ∈ Ico 0 T, ∀ i, 0 ≤ wt t i) ∧
      (∀ t ∈ Ico 0 T, ∑ i, wt t i = 1) ∧
      ContinuousOn (fun t => vec (x t) (u t)) (Icc 0 T) ∧ ∀ t ∈ Ico 0 T,
        HasDerivWithinAt (fun t => vec (x t) (u t))
          ((∑ i, wt t i • toReal (As i)) *ᵥ vec (x t) (u t) + toReal Bm *ᵥ dist (u t))
          (Ici t) t := by
  obtain ⟨dx, hc0, hc1, hder⟩ := h
  refine ⟨fun t => weights t p (u t) (x t) (dx t) (y t), fun t _ => weights_nonneg t p (u t) (x t) (dx t) (y t),
    fun t _ => weights_sum t p (u t) (x t) (dx t) (y t), ?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).x) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).v) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
  · obtain ⟨hd0, hd1, hE⟩ := hder t ht
    obtain ⟨s0, s1⟩ := step hp hE
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).x) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).x = (weights t p (u t) (x t) (dx t) (y t) 0) * ((1 : ℝ) * ((1 : ℝ) * (x t).v)) + (weights t p (u t) (x t) (dx t) (y t) 1) * ((1 : ℝ) * ((1 : ℝ) * (x t).v)) + (weights t p (u t) (x t) (dx t) (y t) 2) * ((1 : ℝ) * ((1 : ℝ) * (x t).v)) + (weights t p (u t) (x t) (dx t) (y t) 3) * ((1 : ℝ) * ((1 : ℝ) * (x t).v)) + (weights t p (u t) (x t) (dx t) (y t) 4) * ((1 : ℝ) * ((1 : ℝ) * (x t).v)) + (weights t p (u t) (x t) (dx t) (y t) 5) * ((1 : ℝ) * ((1 : ℝ) * (x t).v))
      exact s0
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).v) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).v = (weights t p (u t) (x t) (dx t) (y t) 0) * ((-8 : ℝ) * ((1 : ℝ) * (x t).x) + (-2 : ℝ) * ((1 : ℝ) * (x t).v)) + (weights t p (u t) (x t) (dx t) (y t) 1) * ((-4 : ℝ) * ((1 : ℝ) * (x t).x) + (-2 : ℝ) * ((1 : ℝ) * (x t).v)) + (weights t p (u t) (x t) (dx t) (y t) 2) * ((-8 : ℝ) * ((1 : ℝ) * (x t).x) + (-6/5 : ℝ) * ((1 : ℝ) * (x t).v)) + (weights t p (u t) (x t) (dx t) (y t) 3) * ((-4 : ℝ) * ((1 : ℝ) * (x t).x) + (-6/5 : ℝ) * ((1 : ℝ) * (x t).v)) + (weights t p (u t) (x t) (dx t) (y t) 4) * ((-8 : ℝ) * ((1 : ℝ) * (x t).x) + (-3 : ℝ) * ((1 : ℝ) * (x t).v)) + (weights t p (u t) (x t) (dx t) (y t) 5) * ((-4 : ℝ) * ((1 : ℝ) * (x t).x) + (-3 : ℝ) * ((1 : ℝ) * (x t).v)) + (1 : ℝ) * ((u t).f)
      exact s1

