/-! ### Modes

The if-expressions of `Equations`, grouped into switches by their condition chain; a mode
picks one branch of every switch. In mode `m` the model, in coordinates `z`, is
`ż = A_m z + B w`:

* mode 0: `x.v > p.vKnee ∧ |x.x| > p.xFree`
* mode 1: `x.v > p.vKnee ∧ ¬(|x.x| > p.xFree)`
* mode 2: `¬(x.v > p.vKnee) ∧ x.v < -p.vKnee ∧ |x.x| > p.xFree`
* mode 3: `¬(x.v > p.vKnee) ∧ x.v < -p.vKnee ∧ ¬(|x.x| > p.xFree)`
* mode 4: `¬(x.v > p.vKnee) ∧ ¬(x.v < -p.vKnee) ∧ |x.x| > p.xFree`
* mode 5: `¬(x.v > p.vKnee) ∧ ¬(x.v < -p.vKnee) ∧ ¬(|x.x| > p.xFree)`
-/

/-- Coordinates: `x`, `v`. -/
def vec (s : States) (v : Inputs) : Fin 2 → ℝ :=
  ![(1 : ℝ) * s.x, (1 : ℝ) * s.v]
/-- Disturbance channels: `f`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.f]

/-- Mode matrices `A_m`. -/
def As : Fin 6 → Matrix (Fin 2) (Fin 2) ℚ :=
  ![!![0, 1; -8, -2],
    !![0, 1; -4, -2],
    !![0, 1; -8, -6/5],
    !![0, 1; -4, -6/5],
    !![0, 1; -8, -3],
    !![0, 1; -4, -3]]
def Bm : Matrix (Fin 2) (Fin 1) ℚ := !![0; 1]

/-- Indicator of the active mode, written with the model's own conditions (verbatim
from `Equations`, same binders). -/
noncomputable def weights (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Fin 6 → ℝ :=
  ![(if x.v > p.vKnee then (1 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ)),
    (if x.v > p.vKnee then (1 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ)),
    (if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (1 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ)),
    (if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (1 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ)),
    (if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (1 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ)),
    (if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (1 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ))]

theorem weights_nonneg (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : ∀ i, 0 ≤ weights t p u x dx y i := by
  intro i
  fin_cases i
  · show (0 : ℝ) ≤ (if x.v > p.vKnee then (1 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ))
    split_ifs <;> norm_num
  · show (0 : ℝ) ≤ (if x.v > p.vKnee then (1 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ))
    split_ifs <;> norm_num
  · show (0 : ℝ) ≤ (if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (1 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ))
    split_ifs <;> norm_num
  · show (0 : ℝ) ≤ (if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (1 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ))
    split_ifs <;> norm_num
  · show (0 : ℝ) ≤ (if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (1 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ))
    split_ifs <;> norm_num
  · show (0 : ℝ) ≤ (if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (1 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ))
    split_ifs <;> norm_num

theorem weights_sum (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : ∑ i, weights t p u x dx y i = 1 := by
  have h : (if x.v > p.vKnee then (1 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ)) + (if x.v > p.vKnee then (1 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ)) + (if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (1 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ)) + (if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (1 : ℝ) else (0 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ)) + (if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (1 : ℝ)) * (if |x.x| > p.xFree then (1 : ℝ) else (0 : ℝ)) + (if x.v > p.vKnee then (0 : ℝ) else if x.v < -p.vKnee then (0 : ℝ) else (1 : ℝ)) * (if |x.x| > p.xFree then (0 : ℝ) else (1 : ℝ)) = 1 := by
    split_ifs <;> norm_num
  simpa [weights, Fin.sum_univ_succ, add_assoc] using h

theorem f_apply (wt : Fin 6 → ℝ) (z : Fin 2 → ℝ) (w : Fin 1 → ℝ) :
    (∑ i, wt i • toReal (As i)) *ᵥ z + toReal Bm *ᵥ w = ![wt 0 * ((1 : ℝ) * (z 1)) + wt 1 * ((1 : ℝ) * (z 1)) + wt 2 * ((1 : ℝ) * (z 1)) + wt 3 * ((1 : ℝ) * (z 1)) + wt 4 * ((1 : ℝ) * (z 1)) + wt 5 * ((1 : ℝ) * (z 1)), wt 0 * ((-8 : ℝ) * (z 0) + (-2 : ℝ) * (z 1)) + wt 1 * ((-4 : ℝ) * (z 0) + (-2 : ℝ) * (z 1)) + wt 2 * ((-8 : ℝ) * (z 0) + (-6/5 : ℝ) * (z 1)) + wt 3 * ((-4 : ℝ) * (z 0) + (-6/5 : ℝ) * (z 1)) + wt 4 * ((-8 : ℝ) * (z 0) + (-3 : ℝ) * (z 1)) + wt 5 * ((-4 : ℝ) * (z 0) + (-3 : ℝ) * (z 1)) + (1 : ℝ) * (w 0)] := by
  funext i
  fin_cases i <;>
    simp [As, Bm, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

