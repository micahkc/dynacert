/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `e`, `ev`. -/
def vec (s : States) (v : Inputs) : Fin 2 → ℝ :=
  ![(1 : ℝ) * s.«plant.x» + (-1 : ℝ) * v.x_ref, (1 : ℝ) * s.«plant.v» + (-1 : ℝ) * v.v_ref]
/-- Disturbance channels: `d`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.d]

def model : LTIModel 2 1 where
  A := !![0, 1; -11, -11/5]
  B := !![0; 1]

theorem f_apply (z : Fin 2 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(1 : ℝ) * (z 1), (-11 : ℝ) * (z 0) + (-11/5 : ℝ) * (z 1) + (1 : ℝ) * (w 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (1.0 : ℝ) = 1 := by norm_num
theorem lit1 : (0.2 : ℝ) = 1/5 := by norm_num
theorem lit2 : (10.0 : ℝ) = 10 := by norm_num
theorem lit3 : (2.0 : ℝ) = 2 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hc0, hc1, hder⟩ := h
  obtain ⟨hrc0, hrc1, hrder⟩ := hr
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«plant.x» + (-1 : ℝ) * (u s).x_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc0)).add (continuousOn_const.mul hrc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).«plant.v» + (-1 : ℝ) * (u s).v_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc1)).add (continuousOn_const.mul hrc1)
  · obtain ⟨hd0, hd1, ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15, e16⟩⟩ := hder t ht
    obtain ⟨hrd0, hrd1⟩ := hrder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14 e15 e16
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«plant.x» + (-1 : ℝ) * (u s).x_ref) _ (Ici t) t
      refine (((hd0.const_mul (1 : ℝ))).add (hrd0.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«plant.x» + (-1 : ℝ) * (u t).v_ref = (1 : ℝ) * ((1 : ℝ) * (x t).«plant.v» + (-1 : ℝ) * (u t).v_ref)
      linear_combination (1 : ℝ) * e0
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).«plant.v» + (-1 : ℝ) * (u s).v_ref) _ (Ici t) t
      refine (((hd1.const_mul (1 : ℝ))).add (hrd1.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).«plant.v» + (-1 : ℝ) * (u t).a_ref = (-11 : ℝ) * ((1 : ℝ) * (x t).«plant.x» + (-1 : ℝ) * (u t).x_ref) + (-11/5 : ℝ) * ((1 : ℝ) * (x t).«plant.v» + (-1 : ℝ) * (u t).v_ref) + (1 : ℝ) * ((u t).d)
      linear_combination (1 : ℝ) * e1 + (-10 : ℝ) * e2 + (-2 : ℝ) * e3 + (-10 : ℝ) * e4 + (-2 : ℝ) * e5 + (1 : ℝ) * e6 + (-10 : ℝ) * e7 + (-2 : ℝ) * e8 + (1 : ℝ) * e9 + (10 : ℝ) * e10 + (2 : ℝ) * e11 + (1 : ℝ) * e12 + (1 : ℝ) * e13 + (1 : ℝ) * e14

