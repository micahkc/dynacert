theorem init {p : Params} (hp : p.Bound) {s : States} {v : Inputs} (h0 : Initial p s)
    (hr0 : v.x_ref = (0 : ℝ) ∧ v.v_ref = (0 : ℝ)) :
    vec s v = fun i => (((![0, 0] : Fin 2 → ℚ) i : ℚ) : ℝ) := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨i0, i1⟩ := h0
  obtain ⟨r0, r1⟩ := hr0
  funext i
  fin_cases i <;>
    simp [vec, hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3, i0, i1, r0, r1] <;> norm_num

theorem init_le :
    quad (toReal P) (fun i => (((![0, 0] : Fin 2 → ℚ) i : ℚ) : ℝ)) ≤ (level : ℝ) := by
  rw [quad_toReal_cast]
  exact_mod_cast (by decide +kernel : quad P ![0, 0] ≤ level)

theorem out0 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Ico 0 T) :
    (y t).e = (fun i => ((![1, 0] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![1, 0] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).«plant.x» + (-1 : ℝ) * (u t).x_ref) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hder⟩ := h
  have hE := (hder.2.2 t ht).2.2
  obtain ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15, e16⟩ := hE
  try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14 e15 e16
  linear_combination (1 : ℝ) * e2 + (1 : ℝ) * e4 + (1 : ℝ) * e7 + (-1 : ℝ) * e10 + (1 : ℝ) * e15

theorem out1 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Ico 0 T) :
    (y t).ev = (fun i => ((![0, 1] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![0, 1] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).«plant.v» + (-1 : ℝ) * (u t).v_ref) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hder⟩ := h
  have hE := (hder.2.2 t ht).2.2
  obtain ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15, e16⟩ := hE
  try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14 e15 e16
  linear_combination (1 : ℝ) * e3 + (1 : ℝ) * e5 + (1 : ℝ) * e8 + (-1 : ℝ) * e11 + (1 : ℝ) * e16

/-- **Tube.** Under the hypotheses of `Spec.Claim`, the error-frame state
`z = vec (x t) (u t)` (coordinates `e`, `ev`) stays in the certified ellipsoid
`zᵀ P z ≤ level` on `[0, T]`. With a reference trajectory this is a tube around it:
the physical state lies in the reference plus this ellipsoid. -/
theorem tube : ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ), p.Bound → IsSolutionOn p u x y T → Spec.Admissible u T →
    Spec.References u T → Spec.ReferenceStart u → Initial p (x 0) →
    ∀ t ∈ Icc 0 T, quad (toReal P) (vec (x t) (u t)) ≤ (level : ℝ) := by
  intro p u x y T hp h hu hr hr0 h0
  have hx := link hp h hr
  have hw : ∀ t ∈ Ico 0 T, cert.energy (dist (u t)) ≤
      ∑ j, (γ j : ℝ) * ((δ j : ℝ) * (δ j : ℝ)) := by
    intro t ht
    have hut := hu t ht
    refine cert.energy_le_of_abs_le (δ := δ) fun j => ?_
    fin_cases j <;> simp [dist, δ] <;> simp_all
  have h0' : quad (toReal cert.P) (vec (x 0) (u 0)) ≤ (level : ℝ) := by
    rw [init hp h0 hr0]; exact init_le
  exact cert.invariant hx hw h0' budget_le

/-- **Certified.** The claim of `Spec.lean` holds with the bounds `![17/84, 1185/1816]`. -/
theorem certified : Spec.Claim ![17/84, 1185/1816] := by
  intro p u x y T hp h hu hr hr0 h0
  have hV := tube p u x y T hp h hu hr hr0 h0
  intro t ht
  refine ⟨?_, ?_⟩
  · rw [out0 hp h ht]; exact box0.abs_le (hV t ⟨ht.1, ht.2.le⟩)
  · rw [out1 hp h ht]; exact box1.abs_le (hV t ⟨ht.1, ht.2.le⟩)

