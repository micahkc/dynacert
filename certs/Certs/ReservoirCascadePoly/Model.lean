  ∧ x.h2 = 0

/-- The continuous equations of `ReservoirCascadePoly` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  dx.h1 = -(p.a1 * x.h1) + u.q1
  ∧ dx.h2 = p.a1 * x.h1 - p.a2 * x.h2 + u.q2

/-- `x`, `y` is a solution of `ReservoirCascadePoly` under input `u`: every state
