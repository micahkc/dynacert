import Rumoca.Prelude

set_option linter.unusedVariables false

namespace GridFrequencyDroopAGC
open Matrix

/-- Parameters and constants. -/
structure Params where
  /-- Inertia constant [s] (illustrative) -/
  H : ℝ
  /-- Load damping [pu power / pu frequency] (illustrative) -/
