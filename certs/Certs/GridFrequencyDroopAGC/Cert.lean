theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).df) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dPm) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dPc) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, lit0, lit1, lit2, lit3, lit4, lit5] at e0 e1 e2 e3
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).df) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).df = (-1/10 : ℝ) * ((1 : ℝ) * (x t).df) + (1/10 : ℝ) * ((1 : ℝ) * (x t).dPm) + (-1/10 : ℝ) * ((u t).dPL)
      linear_combination (1/10 : ℝ) * e1
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dPm) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dPm = (-40 : ℝ) * ((1 : ℝ) * (x t).df) + (-2 : ℝ) * ((1 : ℝ) * (x t).dPm) + (2 : ℝ) * ((1 : ℝ) * (x t).dPc)
      linear_combination (2 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dPc) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dPc = (-63/10 : ℝ) * ((1 : ℝ) * (x t).df)
      linear_combination (-3/10 : ℝ) * e0 + (1 : ℝ) * e3

