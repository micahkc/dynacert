def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.df, (1 : ℝ) * s.dPm, (1 : ℝ) * s.dPc]
/-- Disturbance channels: `dPL`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.dPL]

def model : LTIModel 3 1 where
  A := !![-1/10, 1/10, 0; -40, -2, 2; -63/10, 0, 0]
  B := !![-1/10; 0; 0]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(-1/10 : ℝ) * (z 0) + (1/10 : ℝ) * (z 1) + (-1/10 : ℝ) * (w 0), (-40 : ℝ) * (z 0) + (-2 : ℝ) * (z 1) + (2 : ℝ) * (z 2), (-63/10 : ℝ) * (z 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

