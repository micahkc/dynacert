theorem out2 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Ico 0 T) :
    (y t).dqp = (fun i => ((![0, -1, -3/10] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![0, -1, -3/10] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (-1 : ℝ) * ((1 : ℝ) * (x t).dh2) + (-3/10 : ℝ) * ((1 : ℝ) * (x t).z) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  obtain ⟨dx, hder⟩ := h
  have hE := (hder.2.2.2 t ht).2.2.2
  obtain ⟨e0, e1, e2, e3⟩ := hE
  try simp only [hb0, hb1, hb2, hb3, hb4, hb5, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3
