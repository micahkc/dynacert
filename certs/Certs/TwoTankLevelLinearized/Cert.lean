/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `dh1`, `dh2`, `z`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.dh1, (1 : ℝ) * s.dh2, (1 : ℝ) * s.z]
/-- Disturbance channels: `dqd`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.dqd]

def model : LTIModel 3 1 where
  A := !![-2971/5000, -2, -3/5; 2971/5000, -2407/5000, 0; 0, 1, 0]
  B := !![2; 0; 0]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(-2971/5000 : ℝ) * (z 0) + (-2 : ℝ) * (z 1) + (-3/5 : ℝ) * (z 2) + (2 : ℝ) * (w 0), (2971/5000 : ℝ) * (z 0) + (-2407/5000 : ℝ) * (z 1), (1 : ℝ) * (z 1)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (0.5 : ℝ) = 1/2 := by norm_num
theorem lit1 : (0.2971 : ℝ) = 2971/10000 := by norm_num
theorem lit2 : (0.2407 : ℝ) = 2407/10000 := by norm_num
theorem lit3 : (1.0 : ℝ) = 1 := by norm_num
theorem lit4 : (0.3 : ℝ) = 3/10 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dh1) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dh2) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).z) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dh1) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dh1 = (-2971/5000 : ℝ) * ((1 : ℝ) * (x t).dh1) + (-2 : ℝ) * ((1 : ℝ) * (x t).dh2) + (-3/5 : ℝ) * ((1 : ℝ) * (x t).z) + (2 : ℝ) * ((u t).dqd)
      linear_combination (2 : ℝ) * e0 + (2 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dh2) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dh2 = (2971/5000 : ℝ) * ((1 : ℝ) * (x t).dh1) + (-2407/5000 : ℝ) * ((1 : ℝ) * (x t).dh2)
      linear_combination (2 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).z) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).z = (1 : ℝ) * ((1 : ℝ) * (x t).dh2)
      linear_combination (1 : ℝ) * e1

