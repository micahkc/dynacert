def Initial (p : Params) (x : States) : Prop :=
  x.dh1 = 0
  ∧ x.dh2 = 0
  ∧ x.z = 0

/-- The continuous equations of `TwoTankLevelLinearized` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.dqp = -(p.kp * x.dh2) - p.ki * x.z
  ∧ dx.z = x.dh2
  ∧ p.A1 * dx.dh1 = y.dqp + u.dqd - p.k1 * x.dh1
  ∧ p.A2 * dx.dh2 = p.k1 * x.dh1 - p.k2 * x.dh2

/-- `x`, `y` is a solution of `TwoTankLevelLinearized` under input `u`: every state
component has derivative `dx t` at every `t`, and the equations hold. -/
def IsSolution (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) : Prop :=
  ∃ dx : ℝ → States, ∀ t : ℝ,
    HasDerivAt (fun s => (x s).dh1) (dx t).dh1 t ∧
    HasDerivAt (fun s => (x s).dh2) (dx t).dh2 t ∧
    HasDerivAt (fun s => (x s).z) (dx t).z t ∧
