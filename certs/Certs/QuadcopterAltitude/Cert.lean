/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `xi`, `e_z`, `e_w`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.xi, (1 : ℝ) * s.z + (-1 : ℝ) * v.z_ref, (1 : ℝ) * s.w + (-1 : ℝ) * v.w_ref]
/-- Disturbance channels: `F_d`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.F_d]

def model : LTIModel 3 1 where
  A := !![0, 1, 0; 0, 0, 1; -8/3, -8, -73/15]
  B := !![0; 0; 2/3]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(1 : ℝ) * (z 1), (1 : ℝ) * (z 2), (-8/3 : ℝ) * (z 0) + (-8 : ℝ) * (z 1) + (-73/15 : ℝ) * (z 2) + (2/3 : ℝ) * (w 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (1.5 : ℝ) = 3/2 := by norm_num
theorem lit1 : (9.81 : ℝ) = 981/100 := by norm_num
theorem lit2 : (0.3 : ℝ) = 3/10 := by norm_num
theorem lit3 : (12.0 : ℝ) = 12 := by norm_num
theorem lit4 : (7.0 : ℝ) = 7 := by norm_num
theorem lit5 : (4.0 : ℝ) = 4 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  obtain ⟨hrc0, hrc1, hrder⟩ := hr
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).xi) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).z + (-1 : ℝ) * (u s).z_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc0)).add (continuousOn_const.mul hrc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).w + (-1 : ℝ) * (u s).w_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc1)).add (continuousOn_const.mul hrc1)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3, e4, e5, e6⟩⟩ := hder t ht
    obtain ⟨hrd0, hrd1⟩ := hrder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, lit0, lit1, lit2, lit3, lit4, lit5] at e0 e1 e2 e3 e4 e5 e6
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).xi) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).xi = (1 : ℝ) * ((1 : ℝ) * (x t).z + (-1 : ℝ) * (u t).z_ref)
      linear_combination (1 : ℝ) * e0 + (1 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).z + (-1 : ℝ) * (u s).z_ref) _ (Ici t) t
      refine (((hd0.const_mul (1 : ℝ))).add (hrd0.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).z + (-1 : ℝ) * (u t).w_ref = (1 : ℝ) * ((1 : ℝ) * (x t).w + (-1 : ℝ) * (u t).w_ref)
      linear_combination (1 : ℝ) * e5
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).w + (-1 : ℝ) * (u s).w_ref) _ (Ici t) t
      refine (((hd1.const_mul (1 : ℝ))).add (hrd1.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).w + (-1 : ℝ) * (u t).a_ref = (-8/3 : ℝ) * ((1 : ℝ) * (x t).xi) + (-8 : ℝ) * ((1 : ℝ) * (x t).z + (-1 : ℝ) * (u t).z_ref) + (-73/15 : ℝ) * ((1 : ℝ) * (x t).w + (-1 : ℝ) * (u t).w_ref) + (2/3 : ℝ) * ((u t).F_d)
      linear_combination (-8 : ℝ) * e0 + (-14/3 : ℝ) * e1 + (2/3 : ℝ) * e2 + (2/3 : ℝ) * e3 + (2/3 : ℝ) * e6

