theorem init {p : Params} (hp : p.Bound) {s : States} {v : Inputs} (h0 : Initial p s)
    (hr0 : True) :
    vec s v = fun i => (((![0, 0] : Fin 2 → ℚ) i : ℚ) : ℝ) := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  obtain ⟨i0, i1⟩ := h0
  funext i
  fin_cases i <;>
    simp [vec, hb0, hb1, hb2, hb3, hb4, hb5, lit0, lit1, lit2, lit3, lit4, lit5, i0, i1] <;> norm_num

theorem init_le :
    quad (toReal P) (fun i => (((![0, 0] : Fin 2 → ℚ) i : ℚ) : ℝ)) ≤ (level : ℝ) := by
  rw [quad_toReal_cast]
  exact_mod_cast (by decide +kernel : quad P ![0, 0] ≤ level)

theorem out0 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Icc 0 T) :
    (x t).w = (fun i => ((![1, 0] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![1, 0] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).w) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  ring

theorem out1 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Icc 0 T) :
    (x t).z = (fun i => ((![0, 1] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![0, 1] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).z) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  ring

/-- `|u| ≤ 11984/9581` on the ellipsoid: in every mode `u` is that mode's
linear function of the coordinates, each bounded by its own box certificate. -/
theorem out2 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Ico 0 T) (hV : quad (toReal P) (vec (x t) (u t)) ≤ (level : ℝ)) :
    |(y t).u| ≤ ((11984/9581 : ℚ) : ℝ) := by
  have ob0 := box2_0.abs_le hV
  have od0 : (fun i => ((![-4, -2] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (-4 : ℝ) * ((1 : ℝ) * (x t).w) + (-2 : ℝ) * ((1 : ℝ) * (x t).z) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [od0] at ob0
  have ob1 := box2_1.abs_le hV
  have od1 : (fun i => ((![-3/2, -2] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (-3/2 : ℝ) * ((1 : ℝ) * (x t).w) + (-2 : ℝ) * ((1 : ℝ) * (x t).z) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [od1] at ob1
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  obtain ⟨dx, hder⟩ := h
  have hE := (hder.2.2 t ht).2.2
  obtain ⟨e0, e1, e2⟩ := hE
  split_ifs at e0 <;>
    (try simp only [hb0, hb1, hb2, hb3, hb4, hb5, lit0, lit1, lit2, lit3, lit4, lit5] at e0 e1 e2) <;>
    first
    | (rw [show (y t).u = (-4 : ℝ) * ((1 : ℝ) * (x t).w) + (-2 : ℝ) * ((1 : ℝ) * (x t).z) by linear_combination (1 : ℝ) * e0]; exact ob0)
    | (rw [show (y t).u = (-3/2 : ℝ) * ((1 : ℝ) * (x t).w) + (-2 : ℝ) * ((1 : ℝ) * (x t).z) by linear_combination (1 : ℝ) * e0]; exact ob1)

/-- **Tube.** Under the hypotheses of `Spec.Claim`, the error-frame state
`z = vec (x t) (u t)` (coordinates `w`, `z`) stays in the certified ellipsoid
`zᵀ P z ≤ level` on `[0, T]`, whatever the switching. -/
theorem tube : ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ), p.Bound → IsSolutionOn p u x y T → Spec.Admissible u T →
    Spec.References u T → Spec.ReferenceStart u → Initial p (x 0) →
    ∀ t ∈ Icc 0 T, quad (toReal P) (vec (x t) (u t)) ≤ (level : ℝ) := by
  intro p u x y T hp h hu hr hr0 h0
  obtain ⟨wt, hwt, hsum, hc, hx⟩ := link hp h hr
  have hw : ∀ t ∈ Ico 0 T, cert.energy (dist (u t)) ≤
      ∑ j, (γ j : ℝ) * ((δ j : ℝ) * (δ j : ℝ)) := by
    intro t ht
    have hut := hu t ht
    refine cert.energy_le_of_abs_le (δ := δ) fun j => ?_
    fin_cases j <;> simp [dist, δ] <;> simp_all
  have h0' : quad (toReal cert.P) (vec (x 0) (u 0)) ≤ (level : ℝ) := by
    rw [init hp h0 hr0]; exact init_le
  exact cert.invariant (wt := wt) hc hx hwt hsum hw h0' budget_le

/-- **Certified.** The claim of `Spec.lean` holds with the bounds `![2617/8076, 1185/6157, 11984/9581]`. -/
theorem certified : Spec.Claim ![2617/8076, 1185/6157, 11984/9581] := by
  intro p u x y T hp h hu hr hr0 h0
  have hV := tube p u x y T hp h hu hr hr0 h0
  refine ⟨?_, ?_⟩
  · intro t ht
    refine ⟨?_, ?_⟩
    · rw [out0 hp h ht]; exact box0.abs_le (hV t ht)
    · rw [out1 hp h ht]; exact box1.abs_le (hV t ht)
  · intro t ht
    exact out2 hp h ht (hV t ⟨ht.1, ht.2.le⟩)

