/-- The continuous equations of `PayloadLiftUncertain` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  dx.z = x.w
  ∧ dx.w = -(p.kp * x.z) - p.kd * x.w - p.im * p.c * x.w + u.d

/-- `x`, `y` is a solution of `PayloadLiftUncertain` under input `u`: every state
