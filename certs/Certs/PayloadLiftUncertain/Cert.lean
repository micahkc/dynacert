    (∑ i, wt i • toReal (As i)) *ᵥ z + toReal Bm *ᵥ w = ![wt 0 * ((1 : ℝ) * (z 1)) + wt 1 * ((1 : ℝ) * (z 1)) + wt 2 * ((1 : ℝ) * (z 1)) + wt 3 * ((1 : ℝ) * (z 1)), wt 0 * ((-16 : ℝ) * (z 0) + (-163/20 : ℝ) * (z 1)) + wt 1 * ((-16 : ℝ) * (z 0) + (-43/5 : ℝ) * (z 1)) + wt 2 * ((-16 : ℝ) * (z 0) + (-167/20 : ℝ) * (z 1)) + wt 3 * ((-16 : ℝ) * (z 0) + (-47/5 : ℝ) * (z 1)) + (1 : ℝ) * (w 0)] := by
  funext i
