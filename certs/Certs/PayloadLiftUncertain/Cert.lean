  intro i
  fin_cases i
  · show (0 : ℝ) ≤ (((7/10 : ℝ) - p.im) / (2/5 : ℝ)) * (((2 : ℝ) - p.c) / (3/2 : ℝ))
    exact (mul_nonneg (div_nonneg (by linarith) (by norm_num)) (div_nonneg (by linarith) (by norm_num)))
  · show (0 : ℝ) ≤ (((7/10 : ℝ) - p.im) / (2/5 : ℝ)) * ((p.c - (1/2 : ℝ)) / (3/2 : ℝ))
    exact (mul_nonneg (div_nonneg (by linarith) (by norm_num)) (div_nonneg (by linarith) (by norm_num)))
  · show (0 : ℝ) ≤ ((p.im - (3/10 : ℝ)) / (2/5 : ℝ)) * (((2 : ℝ) - p.c) / (3/2 : ℝ))
    exact (mul_nonneg (div_nonneg (by linarith) (by norm_num)) (div_nonneg (by linarith) (by norm_num)))
  · show (0 : ℝ) ≤ ((p.im - (3/10 : ℝ)) / (2/5 : ℝ)) * ((p.c - (1/2 : ℝ)) / (3/2 : ℝ))
    exact (mul_nonneg (div_nonneg (by linarith) (by norm_num)) (div_nonneg (by linarith) (by norm_num)))

theorem weights_sum (p : Params) : ∑ i, weights p i = 1 := by
  simp [weights, Fin.sum_univ_succ]
  ring

theorem link {p : Params} (hp : Spec.ParamsOK p) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
