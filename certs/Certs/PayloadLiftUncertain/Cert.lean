  obtain ⟨dx, hc0, hc1, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).z) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).w) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
  · obtain ⟨hd0, hd1, ⟨e0, e1⟩⟩ := hder t ht
    try simp only [hb2, hb3, lit0, lit1, lit2, lit3] at e0 e1
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).z) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).z = ((((7/10 : ℝ) - p.im) / (2/5 : ℝ)) * (((2 : ℝ) - p.c) / (3/2 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).w)) + ((((7/10 : ℝ) - p.im) / (2/5 : ℝ)) * ((p.c - (1/2 : ℝ)) / (3/2 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).w)) + (((p.im - (3/10 : ℝ)) / (2/5 : ℝ)) * (((2 : ℝ) - p.c) / (3/2 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).w)) + (((p.im - (3/10 : ℝ)) / (2/5 : ℝ)) * ((p.c - (1/2 : ℝ)) / (3/2 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).w))
      linear_combination (1 : ℝ) * e0
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).w) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).w = ((((7/10 : ℝ) - p.im) / (2/5 : ℝ)) * (((2 : ℝ) - p.c) / (3/2 : ℝ))) * ((-16 : ℝ) * ((1 : ℝ) * (x t).z) + (-163/20 : ℝ) * ((1 : ℝ) * (x t).w)) + ((((7/10 : ℝ) - p.im) / (2/5 : ℝ)) * ((p.c - (1/2 : ℝ)) / (3/2 : ℝ))) * ((-16 : ℝ) * ((1 : ℝ) * (x t).z) + (-43/5 : ℝ) * ((1 : ℝ) * (x t).w)) + (((p.im - (3/10 : ℝ)) / (2/5 : ℝ)) * (((2 : ℝ) - p.c) / (3/2 : ℝ))) * ((-16 : ℝ) * ((1 : ℝ) * (x t).z) + (-167/20 : ℝ) * ((1 : ℝ) * (x t).w)) + (((p.im - (3/10 : ℝ)) / (2/5 : ℝ)) * ((p.c - (1/2 : ℝ)) / (3/2 : ℝ))) * ((-16 : ℝ) * ((1 : ℝ) * (x t).z) + (-47/5 : ℝ) * ((1 : ℝ) * (x t).w)) + (1 : ℝ) * ((u t).d)
      linear_combination (1 : ℝ) * e1

