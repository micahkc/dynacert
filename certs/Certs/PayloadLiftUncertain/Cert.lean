    !![0, 1; -16, -43/5],
    !![0, 1; -16, -167/20],
    !![0, 1; -16, -47/5]]
def Bm : Matrix (Fin 2) (Fin 1) ℚ := !![0; 1]

/-- Interpolation weights of the actual parameters. -/
noncomputable def weights (p : Params) : Fin 4 → ℝ :=
  ![(((7/10 : ℝ) - p.im) / (2/5 : ℝ)) * (((2 : ℝ) - p.c) / (3/2 : ℝ)), (((7/10 : ℝ) - p.im) / (2/5 : ℝ)) * ((p.c - (1/2 : ℝ)) / (3/2 : ℝ)), ((p.im - (3/10 : ℝ)) / (2/5 : ℝ)) * (((2 : ℝ) - p.c) / (3/2 : ℝ)), ((p.im - (3/10 : ℝ)) / (2/5 : ℝ)) * ((p.c - (1/2 : ℝ)) / (3/2 : ℝ))]

