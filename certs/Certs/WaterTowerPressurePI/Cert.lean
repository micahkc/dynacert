/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `dh`, `dn`, `z`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.dh, (1 : ℝ) * s.dn, (1 : ℝ) * s.z]
/-- Disturbance channels: `dqdem`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.dqdem]

def model : LTIModel 3 1 where
  A := !![-1/100, 3/2000, 0; -981/10, -5, -1; 981/100, 0, 0]
  B := !![-1/200; 0; 0]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(-1/100 : ℝ) * (z 0) + (3/2000 : ℝ) * (z 1) + (-1/200 : ℝ) * (w 0), (-981/10 : ℝ) * (z 0) + (-5 : ℝ) * (z 1) + (-1 : ℝ) * (z 2), (981/100 : ℝ) * (z 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (200.0 : ℝ) = 200 := by norm_num
theorem lit1 : (0.3 : ℝ) = 3/10 := by norm_num
theorem lit2 : (2.0 : ℝ) = 2 := by norm_num
theorem lit3 : (0.2 : ℝ) = 1/5 := by norm_num
theorem lit4 : (9.81 : ℝ) = 981/100 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5, hb6⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dh) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dn) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).z) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3, e4⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, hb6, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3 e4
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dh) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dh = (-1/100 : ℝ) * ((1 : ℝ) * (x t).dh) + (3/2000 : ℝ) * ((1 : ℝ) * (x t).dn) + (-1/200 : ℝ) * ((u t).dqdem)
      linear_combination (1/200 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dn) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dn = (-981/10 : ℝ) * ((1 : ℝ) * (x t).dh) + (-5 : ℝ) * ((1 : ℝ) * (x t).dn) + (-1 : ℝ) * ((1 : ℝ) * (x t).z)
      linear_combination (-10 : ℝ) * e0 + (5 : ℝ) * e1 + (5 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).z) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).z = (981/100 : ℝ) * ((1 : ℝ) * (x t).dh)
      linear_combination (1 : ℝ) * e0 + (1 : ℝ) * e2

