/-- The continuous equations of `WaterTowerPressurePI` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.dp = p.rhog * x.dh
  ∧ y.dncmd = -(p.kp * y.dp) - p.ki * x.z
  ∧ dx.z = y.dp
  ∧ p.tvfd * dx.dn = y.dncmd - x.dn
  ∧ p.At * dx.dh = p.kn * x.dn - p.kh * x.dh - u.dqdem

