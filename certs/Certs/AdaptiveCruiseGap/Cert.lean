theorem init {p : Params} (hp : Spec.ParamsOK p) {s : States} {v : Inputs} (h0 : Initial p s)
    (hr0 : True) :
    vec s v = fun i => (((![0, 0, 0] : Fin 3 → ℚ) i : ℚ) : ℝ) := by
  obtain ⟨hb0, hb1, hb2, hl3, hh3⟩ := hp
