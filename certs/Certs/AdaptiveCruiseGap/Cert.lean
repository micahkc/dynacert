/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `e`, `dv`, `a_ego`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.e, (1 : ℝ) * s.dv, (1 : ℝ) * s.a_ego]
/-- Disturbance channels: `a_lead`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.a_lead]

/-- Vertex matrices of the polytope of systems (corners of the parameter box). -/
def As : Fin 2 → Matrix (Fin 3) (Fin 3) ℚ :=
  ![!![0, 1, -3/2; 0, 0, -1; 4/5, 9/5, -2],
    !![0, 1, -3/2; 0, 0, -1; 2, 9/2, -5]]
def Bm : Matrix (Fin 3) (Fin 1) ℚ := !![0; 1; 0]

/-- Interpolation weights of the actual parameters. -/
noncomputable def weights (p : Params) : Fin 2 → ℝ :=
  ![(((5 : ℝ) - p.w_pt) / (3 : ℝ)), ((p.w_pt - (2 : ℝ)) / (3 : ℝ))]

theorem f_apply (wt : Fin 2 → ℝ) (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    (∑ i, wt i • toReal (As i)) *ᵥ z + toReal Bm *ᵥ w = ![wt 0 * ((1 : ℝ) * (z 1) + (-3/2 : ℝ) * (z 2)) + wt 1 * ((1 : ℝ) * (z 1) + (-3/2 : ℝ) * (z 2)), wt 0 * ((-1 : ℝ) * (z 2)) + wt 1 * ((-1 : ℝ) * (z 2)) + (1 : ℝ) * (w 0), wt 0 * ((4/5 : ℝ) * (z 0) + (9/5 : ℝ) * (z 1) + (-2 : ℝ) * (z 2)) + wt 1 * ((2 : ℝ) * (z 0) + (9/2 : ℝ) * (z 1) + (-5 : ℝ) * (z 2))] := by
  funext i
  fin_cases i <;>
    simp [As, Bm, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (1.5 : ℝ) = 3/2 := by norm_num
theorem lit1 : (0.4 : ℝ) = 2/5 := by norm_num
theorem lit2 : (0.9 : ℝ) = 9/10 := by norm_num
theorem lit3 : (3.0 : ℝ) = 3 := by norm_num

theorem weights_nonneg {p : Params} (hp : Spec.ParamsOK p) : ∀ i, 0 ≤ weights p i := by
  obtain ⟨hb0, hb1, hb2, hl3, hh3⟩ := hp
  intro i
  fin_cases i
  · show (0 : ℝ) ≤ (((5 : ℝ) - p.w_pt) / (3 : ℝ))
    exact (div_nonneg (by linarith) (by norm_num))
  · show (0 : ℝ) ≤ ((p.w_pt - (2 : ℝ)) / (3 : ℝ))
    exact (div_nonneg (by linarith) (by norm_num))

theorem weights_sum (p : Params) : ∑ i, weights p i = 1 := by
  simp [weights, Fin.sum_univ_succ]
  ring

theorem link {p : Params} (hp : Spec.ParamsOK p) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    ContinuousOn (fun t => vec (x t) (u t)) (Icc 0 T) ∧ ∀ t ∈ Ico 0 T,
      HasDerivWithinAt (fun t => vec (x t) (u t))
        ((∑ i, weights p i • toReal (As i)) *ᵥ vec (x t) (u t) + toReal Bm *ᵥ dist (u t))
        (Ici t) t := by
  obtain ⟨hb0, hb1, hb2, hl3, hh3⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).e) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dv) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).a_ego) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, lit0, lit1, lit2, lit3] at e0 e1 e2 e3
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).e) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).e = ((((5 : ℝ) - p.w_pt) / (3 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).dv) + (-3/2 : ℝ) * ((1 : ℝ) * (x t).a_ego)) + (((p.w_pt - (2 : ℝ)) / (3 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).dv) + (-3/2 : ℝ) * ((1 : ℝ) * (x t).a_ego))
      linear_combination (1 : ℝ) * e1
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dv) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dv = ((((5 : ℝ) - p.w_pt) / (3 : ℝ))) * ((-1 : ℝ) * ((1 : ℝ) * (x t).a_ego)) + (((p.w_pt - (2 : ℝ)) / (3 : ℝ))) * ((-1 : ℝ) * ((1 : ℝ) * (x t).a_ego)) + (1 : ℝ) * ((u t).a_lead)
      linear_combination (1 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).a_ego) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).a_ego = ((((5 : ℝ) - p.w_pt) / (3 : ℝ))) * ((4/5 : ℝ) * ((1 : ℝ) * (x t).e) + (9/5 : ℝ) * ((1 : ℝ) * (x t).dv) + (-2 : ℝ) * ((1 : ℝ) * (x t).a_ego)) + (((p.w_pt - (2 : ℝ)) / (3 : ℝ))) * ((2 : ℝ) * ((1 : ℝ) * (x t).e) + (9/2 : ℝ) * ((1 : ℝ) * (x t).dv) + (-5 : ℝ) * ((1 : ℝ) * (x t).a_ego))
      linear_combination (1 : ℝ) * e3

