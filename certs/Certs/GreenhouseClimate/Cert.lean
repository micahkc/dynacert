/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `Ta`, `Ts`, `xi`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.Ta, (1 : ℝ) * s.Ts, (1 : ℝ) * s.xi]
/-- Disturbance channels: `To`, `Qsun`. -/
def dist (v : Inputs) : Fin 2 → ℝ := ![v.To, v.Qsun]

/-- Vertex matrices of the polytope of systems (corners of the parameter box). -/
def As : Fin 2 → Matrix (Fin 3) (Fin 3) ℚ :=
  ![!![-5200/133, 300/133, -8000/133; 3/20, -3/20, 0; 1, 0, 0],
    !![-800/19, 100/19, -8000/133; 7/20, -7/20, 0; 1, 0, 0]]
def Bm : Matrix (Fin 3) (Fin 2) ℚ := !![900/133, 100/133; 0, 0; 0, 0]

/-- Interpolation weights of the actual parameters. -/
noncomputable def weights (p : Params) : Fin 2 → ℝ :=
  ![(((7 : ℝ) - p.h) / (4 : ℝ)), ((p.h - (3 : ℝ)) / (4 : ℝ))]

theorem f_apply (wt : Fin 2 → ℝ) (z : Fin 3 → ℝ) (w : Fin 2 → ℝ) :
    (∑ i, wt i • toReal (As i)) *ᵥ z + toReal Bm *ᵥ w = ![wt 0 * ((-5200/133 : ℝ) * (z 0) + (300/133 : ℝ) * (z 1) + (-8000/133 : ℝ) * (z 2)) + wt 1 * ((-800/19 : ℝ) * (z 0) + (100/19 : ℝ) * (z 1) + (-8000/133 : ℝ) * (z 2)) + (900/133 : ℝ) * (w 0) + (100/133 : ℝ) * (w 1), wt 0 * ((3/20 : ℝ) * (z 0) + (-3/20 : ℝ) * (z 1)) + wt 1 * ((7/20 : ℝ) * (z 0) + (-7/20 : ℝ) * (z 1)), wt 0 * ((1 : ℝ) * (z 0)) + wt 1 * ((1 : ℝ) * (z 0))] := by
  funext i
  fin_cases i <;>
    simp [As, Bm, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

