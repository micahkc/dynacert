theorem init {p : Params} (hp : Spec.ParamsOK p) {s : States} {v : Inputs} (h0 : Initial p s)
    (hr0 : True) :
    vec s v = fun i => (((![0, 0, 0] : Fin 3 → ℚ) i : ℚ) : ℝ) := by
  obtain ⟨hb0, hb1, hb2, hl3, hh3, hb4, hb5⟩ := hp
  obtain ⟨i0, i1, i2⟩ := h0
  funext i
  fin_cases i <;>
    simp [vec, hb0, hb1, hb2, hb4, hb5, lit0, lit1, lit2, lit3, lit4, lit5, i0, i1, i2] <;> norm_num

