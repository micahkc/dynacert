/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `T`, `v_f`, `xi`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.T, (1 : ℝ) * s.v_f, (1 : ℝ) * s.xi]
/-- Disturbance channels: `v_lead`, `F_d`. -/
def dist (v : Inputs) : Fin 2 → ℝ := ![v.v_lead, v.F_d]

def model : LTIModel 3 2 where
  A := !![-2, 5000, 0; -3/5, -302/5, -4; 1, 0, 0]
  B := !![-5000, 0; 0, 1/5; 0, 0]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 2 → ℝ) :
    model.toSystem.f z w = ![(-2 : ℝ) * (z 0) + (5000 : ℝ) * (z 1) + (-5000 : ℝ) * (w 0), (-3/5 : ℝ) * (z 0) + (-302/5 : ℝ) * (z 1) + (-4 : ℝ) * (z 2) + (1/5 : ℝ) * (w 1), (1 : ℝ) * (z 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (5000.0 : ℝ) = 5000 := by norm_num
theorem lit1 : (1.0 : ℝ) = 1 := by norm_num
theorem lit2 : (2.0 : ℝ) = 2 := by norm_num
theorem lit3 : (5.0 : ℝ) = 5 := by norm_num
theorem lit4 : (20.0 : ℝ) = 20 := by norm_num
theorem lit5 : (300.0 : ℝ) = 300 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).T) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).v_f) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).xi) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7, lit0, lit1, lit2, lit3, lit4, lit5] at e0 e1 e2 e3
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).T) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).T = (-2 : ℝ) * ((1 : ℝ) * (x t).T) + (5000 : ℝ) * ((1 : ℝ) * (x t).v_f) + (-5000 : ℝ) * ((u t).v_lead)
      linear_combination (1 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).v_f) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).v_f = (-3/5 : ℝ) * ((1 : ℝ) * (x t).T) + (-302/5 : ℝ) * ((1 : ℝ) * (x t).v_f) + (-4 : ℝ) * ((1 : ℝ) * (x t).xi) + (1/5 : ℝ) * ((u t).F_d)
      linear_combination (1/5 : ℝ) * e0 + (1/5 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).xi) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).xi = (1 : ℝ) * ((1 : ℝ) * (x t).T)
      linear_combination (1 : ℝ) * e1

