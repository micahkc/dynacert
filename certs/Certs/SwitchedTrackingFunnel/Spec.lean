set_option linter.style.setOption false
set_option linter.style.longLine false

namespace SwitchedTrackingFunnel.Spec

open Set SwitchedTrackingFunnel

/-- Admissible disturbances: componentwise peak bounds. -/
def Admissible (u : ℝ → Inputs) (T : ℝ) : Prop :=
  ∀ t ∈ Ico 0 T, |(u t).d| ≤ (1/5 : ℝ)

/-- Reference signals: continuous on `[0, T]` with the declared right
derivatives on `[0, T)`. -/
def References (u : ℝ → Inputs) (T : ℝ) : Prop :=
  ContinuousOn (fun s => (u s).x_ref) (Icc 0 T) ∧
  ContinuousOn (fun s => (u s).v_ref) (Icc 0 T) ∧
  ∀ t ∈ Ico 0 T, HasDerivWithinAt (fun s => (u s).x_ref) (u t).v_ref (Ici t) t ∧
    HasDerivWithinAt (fun s => (u s).v_ref) (u t).a_ref (Ici t) t

/-- Reference values at `t = 0`. -/
def ReferenceStart (u : ℝ → Inputs) : Prop :=
  (u 0).x_ref = (0 : ℝ) ∧ (u 0).v_ref = (0 : ℝ)

/-- Initial set: `x` start anywhere in their annotated intervals
(`initialSet`); every other state starts as in the model's `Initial`. -/
def InitialSet (p : Params) (s : States) : Prop :=
  (-1/10 : ℝ) ≤ s.x ∧ s.x ≤ (1/10 : ℝ) ∧
  ∃ s₀ : States, Initial p s₀ ∧ s.v = s₀.v ∧ s.xi = s₀.xi

/-- **The claim.** Every solution with admissible parameter values, admissible
disturbances, the declared references, and an initial state in `InitialSet` keeps
`xi`, `e`, `ev` within the bounds `b`. -/
def Claim (b : Fin 3 → ℚ) : Prop :=
  ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) (T : ℝ),
    p.Bound → IsSolutionOn p u x y T → Admissible u T → References u T →
    ReferenceStart u → InitialSet p (x 0) →
    (∀ t ∈ Icc 0 T, |(x t).xi| ≤ (b 0 : ℝ)) ∧
    (∀ t ∈ Ico 0 T, |(y t).e| ≤ (b 1 : ℝ) ∧ |(y t).ev| ≤ (b 2 : ℝ))

end SwitchedTrackingFunnel.Spec
