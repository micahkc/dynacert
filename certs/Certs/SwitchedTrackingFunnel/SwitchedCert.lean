theorem init {p : Params} (hp : p.Bound) {s : States} {v : Inputs}
    (h0 : Spec.InitialSet p s) (hr0 : v.x_ref = (0 : ℝ) ∧ v.v_ref = (0 : ℝ)) :
    ∃ e : Fin 1 → ℝ, (∀ i, |e i| ≤ ((ρ₀ i : ℚ) : ℝ)) ∧
      vec s v = fun i => ((c₀ i : ℚ) : ℝ) + (toReal G₀ *ᵥ e) i := by
  obtain ⟨hb0, hb1, hb2, hb3⟩ := hp
  obtain ⟨l0, u0, s₀, hs₀, q0, q1⟩ := h0
  obtain ⟨i0, i1, i2⟩ := hs₀
  obtain ⟨r0, r1⟩ := hr0
  refine ⟨![s.x - (0 : ℝ)], fun i => ?_, ?_⟩
  · fin_cases i <;> simp [ρ₀] <;> rw [abs_le] <;> constructor <;> linarith
  · funext i
    fin_cases i <;>
      simp [vec, c₀, G₀, toReal, mulVec, dotProduct, Fin.sum_univ_succ, hb0, hb1, hb2, hb3, lit0, lit1, lit2, lit3, lit4, i0, i1, i2, q0, q1, r0, r1] <;> ring

theorem init_V0 {p : Params} (hp : p.Bound) {s : States} {v : Inputs}
    (h0 : Spec.InitialSet p s) (hr0 : v.x_ref = (0 : ℝ) ∧ v.v_ref = (0 : ℝ)) :
    quad (toReal P) (vec s v) ≤ (V0 : ℝ) := by
  obtain ⟨e, he, hz⟩ := init hp h0 hr0
  rw [hz]
  exact quad_le_boxBound P_symm init_box e he

theorem out0 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Icc 0 T) :
    (x t).xi = (fun i => ((![1, 0, 0] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![1, 0, 0] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).xi) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  ring

theorem out1 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Ico 0 T) :
    (y t).e = (fun i => ((![0, 1, 0] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![0, 1, 0] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).x + (-1 : ℝ) * (u t).x_ref) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  obtain ⟨hb0, hb1, hb2, hb3⟩ := hp
  obtain ⟨dx, hder⟩ := h
  have hE := (hder.2.2.2 t ht).2.2.2
  obtain ⟨e0, e1, e2, e3, e4⟩ := hE
  try simp only [hb0, hb1, hb2, hb3, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3 e4
  linear_combination (1 : ℝ) * e0

theorem out2 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Ico 0 T) :
    (y t).ev = (fun i => ((![0, 0, 1] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![0, 0, 1] : Fin 3 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  obtain ⟨hb0, hb1, hb2, hb3⟩ := hp
  obtain ⟨dx, hder⟩ := h
  have hE := (hder.2.2.2 t ht).2.2.2
  obtain ⟨e0, e1, e2, e3, e4⟩ := hE
  try simp only [hb0, hb1, hb2, hb3, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3 e4
  linear_combination (1 : ℝ) * e1

/-- **Tube.** Under the hypotheses of `Spec.Claim`, the error-frame state
`z = vec (x t) (u t)` (coordinates `xi`, `e`, `ev`) stays in the certified ellipsoid
`zᵀ P z ≤ level` on `[0, T]`, whatever the switching. -/
theorem tube : ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ), p.Bound → IsSolutionOn p u x y T → Spec.Admissible u T →
    Spec.References u T → Spec.ReferenceStart u → Spec.InitialSet p (x 0) →
    ∀ t ∈ Icc 0 T, quad (toReal P) (vec (x t) (u t)) ≤ (level : ℝ) := by
  intro p u x y T hp h hu hr hr0 h0
  obtain ⟨wt, hwt, hsum, hc, hx⟩ := link hp h hr
  have hw : ∀ t ∈ Ico 0 T, cert.energy (dist (u t)) ≤
      ∑ j, (γ j : ℝ) * ((δ j : ℝ) * (δ j : ℝ)) := by
    intro t ht
    have hut := hu t ht
    refine cert.energy_le_of_abs_le (δ := δ) fun j => ?_
    fin_cases j <;> simp [dist, δ] <;> simp_all
  have h0' : quad (toReal cert.P) (vec (x 0) (u 0)) ≤ (level : ℝ) := by
    exact (init_V0 hp h0 hr0).trans (by exact_mod_cast V0_le)
  exact cert.invariant (wt := wt) hc hx hwt hsum hw h0' budget_le

/-- **Certified.** The claim of `Spec.lean` holds with the bounds `![2536/9997, 543/4456, 919/5078]`. -/
theorem certified : Spec.Claim ![2536/9997, 543/4456, 919/5078] := by
  intro p u x y T hp h hu hr hr0 h0
  have hV := tube p u x y T hp h hu hr hr0 h0
  refine ⟨?_, ?_⟩
  · intro t ht
    rw [out0 hp h ht]; exact box0.abs_le (hV t ht)
  · intro t ht
    refine ⟨?_, ?_⟩
    · rw [out1 hp h ht]; exact box1.abs_le (hV t ⟨ht.1, ht.2.le⟩)
    · rw [out2 hp h ht]; exact box2.abs_le (hV t ⟨ht.1, ht.2.le⟩)

/-- The disturbance budget `Σⱼ γⱼ δⱼ²`. -/
theorem budget_eq :
    ∑ j, (γ j : ℝ) * ((δ j : ℝ) * (δ j : ℝ)) = ((365158/21919825 : ℚ) : ℝ) := by
  have h : ∑ j, γ j * (δ j * δ j) = 365158/21919825 := by decide +kernel
  exact_mod_cast h

/-- **Funnel.** Under the hypotheses of `Spec.Claim`, the storage of the error-frame
state `z = vec (x t) (u t)` (coordinates `xi`, `e`, `ev`) obeys
`zᵀPz ≤ V₀ e^{-αt} + (γμ/α)(1 - e^{-αt})` on `[0, T]`, whatever the switching. -/
theorem funnel : ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ), p.Bound → IsSolutionOn p u x y T → Spec.Admissible u T →
    Spec.References u T → Spec.ReferenceStart u → Spec.InitialSet p (x 0) →
    ∀ t ∈ Icc 0 T, quad (toReal P) (vec (x t) (u t)) ≤
      ((4379561/79031900 : ℚ) : ℝ) * Real.exp (-((133767/542308 : ℚ) : ℝ) * t) + ((198028104664/2932149230775 : ℚ) : ℝ) * (1 - Real.exp (-((133767/542308 : ℚ) : ℝ) * t)) := by
  intro p u x y T hp h hu hr hr0 h0
  obtain ⟨wt, hwt, hsum, hc, hx⟩ := link hp h hr
  have hw : ∀ t ∈ Ico 0 T, cert.energy (dist (u t)) ≤ ((365158/21919825 : ℚ) : ℝ) := by
    intro t ht
    have hut := hu t ht
    refine (cert.energy_le_of_abs_le (δ := δ) fun j => ?_).trans_eq budget_eq
    fin_cases j <;> simp [dist, δ] <;> simp_all
  exact cert.funnel (wt := wt) hc hx hwt hsum hw (init_V0 hp h0 hr0) (by decide +kernel)

end SwitchedTrackingFunnel.SwitchedCert
