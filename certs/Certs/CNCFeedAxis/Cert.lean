/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `e`, `ev`, `ei`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.x + (-1 : ℝ) * v.x_ref, (1 : ℝ) * s.v + (-1 : ℝ) * v.v_ref, (1 : ℝ) * s.xi]
/-- Disturbance channels: `F_cut`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.F_cut]

def model : LTIModel 3 1 where
  A := !![0, 1, 0; -67500, -454, -3375000; 1, 0, 0]
  B := !![0; 5; 0]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(1 : ℝ) * (z 1), (-67500 : ℝ) * (z 0) + (-454 : ℝ) * (z 1) + (-3375000 : ℝ) * (z 2) + (5 : ℝ) * (w 0), (1 : ℝ) * (z 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

