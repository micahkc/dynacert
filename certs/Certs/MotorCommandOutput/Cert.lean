/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `i`, `w`. -/
def vec (s : States) (v : Inputs) : Fin 2 → ℝ :=
  ![(1 : ℝ) * s.i, (1 : ℝ) * s.w]
/-- Disturbance channels: `n`, `tl`. -/
def dist (v : Inputs) : Fin 2 → ℝ := ![v.n, v.tl]

def model : LTIModel 2 2 where
  A := !![-2, -5; 5, -1]
  B := !![2, 0; 0, -10]

theorem f_apply (z : Fin 2 → ℝ) (w : Fin 2 → ℝ) :
    model.toSystem.f z w = ![(-2 : ℝ) * (z 0) + (-5 : ℝ) * (z 1) + (2 : ℝ) * (w 0), (5 : ℝ) * (z 0) + (-1 : ℝ) * (z 1) + (-10 : ℝ) * (w 1)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (1.0 : ℝ) = 1 := by norm_num
theorem lit1 : (0.5 : ℝ) = 1/2 := by norm_num
theorem lit2 : (0.1 : ℝ) = 1/10 := by norm_num
theorem lit3 : (2.0 : ℝ) = 2 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  obtain ⟨dx, hc0, hc1, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).i) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).w) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
  · obtain ⟨hd0, hd1, ⟨e0, e1, e2⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, lit0, lit1, lit2, lit3] at e0 e1 e2
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).i) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).i = (-2 : ℝ) * ((1 : ℝ) * (x t).i) + (-5 : ℝ) * ((1 : ℝ) * (x t).w) + (2 : ℝ) * ((u t).n)
      linear_combination (2 : ℝ) * e0 + (2 : ℝ) * e1
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).w) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).w = (5 : ℝ) * ((1 : ℝ) * (x t).i) + (-1 : ℝ) * ((1 : ℝ) * (x t).w) + (-10 : ℝ) * ((u t).tl)
      linear_combination (10 : ℝ) * e2

