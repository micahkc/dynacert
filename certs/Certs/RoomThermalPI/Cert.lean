/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `dTa`, `dTe`, `z`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.dTa, (1 : ℝ) * s.dTe, (1 : ℝ) * s.z]
/-- Disturbance channels: `dTo`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.dTo]

/-- Vertex matrices of the polytope of systems (corners of the parameter box). -/
def As : Fin 2 → Matrix (Fin 3) (Fin 3) ℚ :=
  ![!![-20001/5000, 6667/5000, -6667/2500; 1/4, -5/16, 0; 1, 0, 0],
    !![-12, 4, -8; 1/4, -5/16, 0; 1, 0, 0]]
def Bm : Matrix (Fin 3) (Fin 1) ℚ := !![0; 1/16; 0]

/-- Interpolation weights of the actual parameters. -/
noncomputable def weights (p : Params) : Fin 2 → ℝ :=
  ![(((2 : ℝ) - p.invCa) / (13333/10000 : ℝ)), ((p.invCa - (6667/10000 : ℝ)) / (13333/10000 : ℝ))]

theorem f_apply (wt : Fin 2 → ℝ) (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    (∑ i, wt i • toReal (As i)) *ᵥ z + toReal Bm *ᵥ w = ![wt 0 * ((-20001/5000 : ℝ) * (z 0) + (6667/5000 : ℝ) * (z 1) + (-6667/2500 : ℝ) * (z 2)) + wt 1 * ((-12 : ℝ) * (z 0) + (4 : ℝ) * (z 1) + (-8 : ℝ) * (z 2)), wt 0 * ((1/4 : ℝ) * (z 0) + (-5/16 : ℝ) * (z 1)) + wt 1 * ((1/4 : ℝ) * (z 0) + (-5/16 : ℝ) * (z 1)) + (1/16 : ℝ) * (w 0), wt 0 * ((1 : ℝ) * (z 0)) + wt 1 * ((1 : ℝ) * (z 0))] := by
  funext i
  fin_cases i <;>
    simp [As, Bm, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (1.0 : ℝ) = 1 := by norm_num
theorem lit1 : (8.0 : ℝ) = 8 := by norm_num
theorem lit2 : (0.5 : ℝ) = 1/2 := by norm_num
theorem lit3 : (2.0 : ℝ) = 2 := by norm_num
theorem lit4 : (4.0 : ℝ) = 4 := by norm_num

theorem weights_nonneg {p : Params} (hp : Spec.ParamsOK p) : ∀ i, 0 ≤ weights p i := by
  obtain ⟨hl0, hh0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  intro i
  fin_cases i
  · show (0 : ℝ) ≤ (((2 : ℝ) - p.invCa) / (13333/10000 : ℝ))
    exact (div_nonneg (by linarith) (by norm_num))
  · show (0 : ℝ) ≤ ((p.invCa - (6667/10000 : ℝ)) / (13333/10000 : ℝ))
    exact (div_nonneg (by linarith) (by norm_num))

theorem weights_sum (p : Params) : ∑ i, weights p i = 1 := by
  simp [weights, Fin.sum_univ_succ]
  ring

theorem link {p : Params} (hp : Spec.ParamsOK p) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    ContinuousOn (fun t => vec (x t) (u t)) (Icc 0 T) ∧ ∀ t ∈ Ico 0 T,
      HasDerivWithinAt (fun t => vec (x t) (u t))
        ((∑ i, weights p i • toReal (As i)) *ᵥ vec (x t) (u t) + toReal Bm *ᵥ dist (u t))
        (Ici t) t := by
  obtain ⟨hl0, hh0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dTa) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dTe) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).z) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3⟩⟩ := hder t ht
    try simp only [hb1, hb2, hb3, hb4, hb5, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dTa) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dTa = ((((2 : ℝ) - p.invCa) / (13333/10000 : ℝ))) * ((-20001/5000 : ℝ) * ((1 : ℝ) * (x t).dTa) + (6667/5000 : ℝ) * ((1 : ℝ) * (x t).dTe) + (-6667/2500 : ℝ) * ((1 : ℝ) * (x t).z)) + (((p.invCa - (6667/10000 : ℝ)) / (13333/10000 : ℝ))) * ((-12 : ℝ) * ((1 : ℝ) * (x t).dTa) + (4 : ℝ) * ((1 : ℝ) * (x t).dTe) + (-8 : ℝ) * ((1 : ℝ) * (x t).z))
      linear_combination (1 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dTe) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dTe = ((((2 : ℝ) - p.invCa) / (13333/10000 : ℝ))) * ((1/4 : ℝ) * ((1 : ℝ) * (x t).dTa) + (-5/16 : ℝ) * ((1 : ℝ) * (x t).dTe)) + (((p.invCa - (6667/10000 : ℝ)) / (13333/10000 : ℝ))) * ((1/4 : ℝ) * ((1 : ℝ) * (x t).dTa) + (-5/16 : ℝ) * ((1 : ℝ) * (x t).dTe)) + (1/16 : ℝ) * ((u t).dTo)
      linear_combination (1/8 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).z) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).z = ((((2 : ℝ) - p.invCa) / (13333/10000 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).dTa)) + (((p.invCa - (6667/10000 : ℝ)) / (13333/10000 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).dTa))
      linear_combination (1 : ℝ) * e1

