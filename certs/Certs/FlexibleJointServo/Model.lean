  /-- Link inertia [kg*m2] -/
  Jl : ℝ
  /-- Transmission stiffness [N*m/rad] -/
  k : ℝ
  /-- Motor viscous friction [N*m*s/rad] -/
  bm : ℝ
  /-- Link viscous friction [N*m*s/rad] -/
  bl : ℝ
  /-- Motor position gain [N*m/rad] -/
  kp : ℝ
  /-- Motor velocity gain [N*m*s/rad] -/
  kd : ℝ
  /-- Link velocity damping gain [N*m*s/rad] -/
  kl : ℝ

/-- Inputs. -/
structure Inputs where
  /-- Link angle reference [rad] -/
  q_ref : ℝ
  /-- Link rate reference [rad/s] -/
  w_ref : ℝ
  /-- Link acceleration reference [rad/s2] -/
  a_ref : ℝ
  /-- Link jerk reference [rad/s3] -/
  j_ref : ℝ
  /-- Link snap reference [rad/s4] -/
  s_ref : ℝ
  /-- Load torque on the link [N*m] -/
  tau_load : ℝ
  /-- Motor torque ripple [N*m] -/
  tau_rip : ℝ

/-- Differentiated variables (also used for their derivatives). -/
structure States where
  /-- Link angle [rad] -/
  ql : ℝ
  /-- Link rate [rad/s] -/
  wl : ℝ
  /-- Motor angle (link side) [rad] -/
  qm : ℝ
  /-- Motor rate (link side) [rad/s] -/
  wm : ℝ

/-- Algebraic (non-differentiated) variables. -/
structure Algebraics where
  /-- Motor angle that realises q_ref [rad] -/
  qm_ref : ℝ
  /-- Motor rate that realises q_ref [rad/s] -/
  wm_ref : ℝ
  /-- Motor acceleration that realises q_ref [rad/s2] -/
  am_ref : ℝ
  /-- Feedforward torque [N*m] -/
  tau_ff : ℝ
  /-- Motor torque [N*m] -/
  tau : ℝ
  /-- Link angle error [rad] -/
  e_l : ℝ
  /-- Link rate error [rad/s] -/
  ev_l : ℝ
  /-- Motor angle error [rad] -/
  e_m : ℝ
  /-- Motor rate error [rad/s] -/
  ev_m : ℝ
  /-- Transmission torque error k*(qm - ql) - (Jl*a_ref + bl*w_ref) [N*m] -/
  e_s : ℝ
  /-- Transmission torque rate error [N*m/s] -/
  ev_s : ℝ

/-- Modelica names of the parameters and constants, in declaration order. -/
def paramNames : List String := ["Jm", "Jl", "k", "bm", "bl", "kp", "kd", "kl"]

/-- Modelica names of the inputs, in declaration order. -/
def inputNames : List String := ["q_ref", "w_ref", "a_ref", "j_ref", "s_ref", "tau_load", "tau_rip"]

/-- Modelica names of the states, in declaration order. -/
def stateNames : List String := ["ql", "wl", "qm", "wm"]

/-- Modelica names of the algebraic variables and outputs, in declaration order. -/
def algebraicNames : List String := ["qm_ref", "wm_ref", "am_ref", "tau_ff", "tau", "e_l", "ev_l", "e_m", "ev_m", "e_s", "ev_s"]

/-- The parameter bindings of the model. -/
def Params.Bound (p : Params) : Prop :=
  p.Jm = 0.05
  ∧ p.Jl = 1.0
  ∧ p.k = 200.0
  ∧ p.bm = 0.05
  ∧ p.bl = 1.0
  ∧ p.kp = 100.0
  ∧ p.kd = 6.0
  ∧ p.kl = 10.0

/-- Initial conditions: the `fixed = true` start values of the states. -/
def Initial (p : Params) (x : States) : Prop :=
  x.ql = 0
  ∧ x.wl = 0
  ∧ x.qm = 0
  ∧ x.wm = 0

/-- The continuous equations of `FlexibleJointServo` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.qm_ref = u.q_ref + (p.Jl * u.a_ref + p.bl * u.w_ref) / p.k
  ∧ y.wm_ref = u.w_ref + (p.Jl * u.j_ref + p.bl * u.a_ref) / p.k
  ∧ y.am_ref = u.a_ref + (p.Jl * u.s_ref + p.bl * u.j_ref) / p.k
  ∧ y.tau_ff = p.Jm * y.am_ref + p.bm * y.wm_ref + p.k * (y.qm_ref - u.q_ref)
  ∧ y.e_l = x.ql - u.q_ref
  ∧ y.ev_l = x.wl - u.w_ref
  ∧ y.e_m = x.qm - y.qm_ref
  ∧ y.ev_m = x.wm - y.wm_ref
  ∧ y.e_s = p.k * (x.qm - x.ql) - (p.Jl * u.a_ref + p.bl * u.w_ref)
  ∧ y.ev_s = p.k * (x.wm - x.wl) - (p.Jl * u.j_ref + p.bl * u.a_ref)
  ∧ y.tau = y.tau_ff - p.kp * y.e_m - p.kd * y.ev_m - p.kl * y.ev_l
  ∧ dx.ql = x.wl
  ∧ p.Jl * dx.wl = p.k * (x.qm - x.ql) - p.bl * x.wl + u.tau_load
  ∧ dx.qm = x.wm
  ∧ p.Jm * dx.wm = y.tau + u.tau_rip - p.bm * x.wm - p.k * (x.qm - x.ql)

/-- `x`, `y` is a solution of `FlexibleJointServo` under input `u`: every state
component has derivative `dx t` at every `t`, and the equations hold. -/
def IsSolution (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) : Prop :=
  ∃ dx : ℝ → States, ∀ t : ℝ,
    HasDerivAt (fun s => (x s).ql) (dx t).ql t ∧
    HasDerivAt (fun s => (x s).wl) (dx t).wl t ∧
    HasDerivAt (fun s => (x s).qm) (dx t).qm t ∧
    HasDerivAt (fun s => (x s).wm) (dx t).wm t ∧
    Equations t p (u t) (x t) (dx t) (y t)

/-- `x`, `y` is a solution of `FlexibleJointServo` on `[0, T]` under input `u`:
every state component is continuous on `[0, T]` and has right derivative
`dx t` at every `t ∈ [0, T)`, where the equations hold. Right derivatives
admit piecewise-continuous, right-continuous inputs (steps, zero-order hold). -/
def IsSolutionOn (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ) : Prop :=
  ∃ dx : ℝ → States,
    ContinuousOn (fun s => (x s).ql) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).wl) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).qm) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).wm) (Set.Icc 0 T) ∧
    ∀ t ∈ Set.Ico 0 T,
      HasDerivWithinAt (fun s => (x s).ql) (dx t).ql (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).wl) (dx t).wl (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).qm) (dx t).qm (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).wm) (dx t).wm (Set.Ici t) t ∧
      Equations t p (u t) (x t) (dx t) (y t)

/-- A solution on all of `ℝ` is a solution on every `[0, T]`. -/
theorem IsSolution.isSolutionOn {p : Params} {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} (h : IsSolution p u x y) (T : ℝ) : IsSolutionOn p u x y T := by
  obtain ⟨dx, hdx⟩ := h
  exact ⟨dx,
    fun s _ => ((hdx s).1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.2.1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.2.2.1).continuousAt.continuousWithinAt,
    fun t _ => ⟨
      ((hdx t).1).hasDerivWithinAt,
      ((hdx t).2.1).hasDerivWithinAt,
      ((hdx t).2.2.1).hasDerivWithinAt,
      ((hdx t).2.2.2.1).hasDerivWithinAt,
      (hdx t).2.2.2.2⟩⟩

end FlexibleJointServo
