namespace FlexibleJointServo.Spec

open Set FlexibleJointServo

/-- Admissible disturbances: componentwise peak bounds. -/
def Admissible (u : ℝ → Inputs) (T : ℝ) : Prop :=
  ∀ t ∈ Ico 0 T, |(u t).tau_load| ≤ (2 : ℝ) ∧ |(u t).tau_rip| ≤ (1/2 : ℝ)

/-- Reference signals: continuous on `[0, T]` with the declared right
derivatives on `[0, T)`. -/
def References (u : ℝ → Inputs) (T : ℝ) : Prop :=
  ContinuousOn (fun s => (u s).q_ref) (Icc 0 T) ∧
  ContinuousOn (fun s => (u s).w_ref) (Icc 0 T) ∧
  ContinuousOn (fun s => (u s).a_ref) (Icc 0 T) ∧
  ContinuousOn (fun s => (u s).j_ref) (Icc 0 T) ∧
  ∀ t ∈ Ico 0 T, HasDerivWithinAt (fun s => (u s).q_ref) (u t).w_ref (Ici t) t ∧
    HasDerivWithinAt (fun s => (u s).w_ref) (u t).a_ref (Ici t) t ∧
    HasDerivWithinAt (fun s => (u s).a_ref) (u t).j_ref (Ici t) t ∧
    HasDerivWithinAt (fun s => (u s).j_ref) (u t).s_ref (Ici t) t

/-- Reference values at `t = 0`. -/
def ReferenceStart (u : ℝ → Inputs) : Prop :=
  (u 0).q_ref = (0 : ℝ) ∧ (u 0).w_ref = (0 : ℝ) ∧ (u 0).a_ref = (0 : ℝ) ∧ (u 0).j_ref = (0 : ℝ)

/-- **The claim.** Every solution with admissible parameter values, admissible
disturbances, the declared references, and the model's initial condition keeps
`e_l`, `ev_l`, `e_s`, `ev_s` within the bounds `b`. -/
def Claim (b : Fin 4 → ℚ) : Prop :=
  ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) (T : ℝ),
    p.Bound → IsSolutionOn p u x y T → Admissible u T → References u T →
    ReferenceStart u → Initial p (x 0) →
    (∀ t ∈ Ico 0 T, |(y t).e_l| ≤ (b 0 : ℝ) ∧ |(y t).ev_l| ≤ (b 1 : ℝ) ∧ |(y t).e_s| ≤ (b 2 : ℝ) ∧ |(y t).ev_s| ≤ (b 3 : ℝ))

end FlexibleJointServo.Spec
