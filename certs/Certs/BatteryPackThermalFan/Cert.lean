theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hc3, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dTc) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dTa) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dfan) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).z) (Icc 0 T)
      exact (continuousOn_const.mul hc3)
  · obtain ⟨hd0, hd1, hd2, hd3, ⟨e0, e1, e2, e3, e4⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, hb6, hb7, lit0, lit1, lit2, lit3, lit4, lit5, lit6] at e0 e1 e2 e3 e4
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dTc) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dTc = (-1/20 : ℝ) * ((1 : ℝ) * (x t).dTc) + (1/20 : ℝ) * ((1 : ℝ) * (x t).dTa) + (1/800 : ℝ) * ((u t).dQ)
      linear_combination (1/800 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dTa) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dTa = (2 : ℝ) * ((1 : ℝ) * (x t).dTc) + (-7/2 : ℝ) * ((1 : ℝ) * (x t).dTa) + (-1/2 : ℝ) * ((1 : ℝ) * (x t).dfan) + (3/2 : ℝ) * ((u t).dTamb)
      linear_combination (1/20 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dfan) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dfan = (200 : ℝ) * ((1 : ℝ) * (x t).dTc) + (-10 : ℝ) * ((1 : ℝ) * (x t).dfan) + (20 : ℝ) * ((1 : ℝ) * (x t).z)
      linear_combination (10 : ℝ) * e0 + (10 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).z) _ (Ici t) t
      refine ((hd3.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).z = (1 : ℝ) * ((1 : ℝ) * (x t).dTc)
      linear_combination (1 : ℝ) * e1

