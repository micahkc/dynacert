theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hb5⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hc3, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).susp_defl) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).v_body) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).tire_defl) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).v_wheel) (Icc 0 T)
      exact (continuousOn_const.mul hc3)
  · obtain ⟨hd0, hd1, hd2, hd3, ⟨e0, e1, e2, e3, e4, e5⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, hb5, lit0, lit1, lit2, lit3, lit4, lit5] at e0 e1 e2 e3 e4 e5
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).susp_defl) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).susp_defl = (1 : ℝ) * ((1 : ℝ) * (x t).v_body) + (-1 : ℝ) * ((1 : ℝ) * (x t).v_wheel)
      linear_combination (1 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).v_body) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).v_body = (-160/3 : ℝ) * ((1 : ℝ) * (x t).susp_defl) + (-40/3 : ℝ) * ((1 : ℝ) * (x t).v_body) + (10/3 : ℝ) * ((1 : ℝ) * (x t).v_wheel)
      linear_combination (1/300 : ℝ) * e0 + (1/300 : ℝ) * e1 + (1/300 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).tire_defl) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).tire_defl = (1 : ℝ) * ((1 : ℝ) * (x t).v_wheel) + (-1 : ℝ) * ((u t).w_road)
      linear_combination (1 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).v_wheel) _ (Ici t) t
      refine ((hd3.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).v_wheel = (400 : ℝ) * ((1 : ℝ) * (x t).susp_defl) + (100 : ℝ) * ((1 : ℝ) * (x t).v_body) + (-4750 : ℝ) * ((1 : ℝ) * (x t).tire_defl) + (-25 : ℝ) * ((1 : ℝ) * (x t).v_wheel)
      linear_combination (-1/40 : ℝ) * e0 + (-1/40 : ℝ) * e1 + (1/40 : ℝ) * e5

