/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `susp_defl`, `v_body`, `tire_defl`, `v_wheel`. -/
def vec (s : States) (v : Inputs) : Fin 4 → ℝ :=
  ![(1 : ℝ) * s.susp_defl, (1 : ℝ) * s.v_body, (1 : ℝ) * s.tire_defl, (1 : ℝ) * s.v_wheel]
/-- Disturbance channels: `w_road`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.w_road]

def model : LTIModel 4 1 where
  A := !![0, 1, 0, -1; -160/3, -40/3, 0, 10/3; 0, 0, 0, 1; 400, 100, -4750, -25]
  B := !![0; 0; -1; 0]

theorem f_apply (z : Fin 4 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(1 : ℝ) * (z 1) + (-1 : ℝ) * (z 3), (-160/3 : ℝ) * (z 0) + (-40/3 : ℝ) * (z 1) + (10/3 : ℝ) * (z 3), (1 : ℝ) * (z 3) + (-1 : ℝ) * (w 0), (400 : ℝ) * (z 0) + (100 : ℝ) * (z 1) + (-4750 : ℝ) * (z 2) + (-25 : ℝ) * (z 3)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (300.0 : ℝ) = 300 := by norm_num
theorem lit1 : (40.0 : ℝ) = 40 := by norm_num
theorem lit2 : (16000.0 : ℝ) = 16000 := by norm_num
theorem lit3 : (1000.0 : ℝ) = 1000 := by norm_num
theorem lit4 : (190000.0 : ℝ) = 190000 := by norm_num
