Arrays are `Fin n → ℝ` / `Matrix (Fin m) (Fin n) ℝ`; Modelica `v[k]` is `v (k-1)`.
-/
import Rumoca.Prelude

set_option linter.unusedVariables false

namespace QuarterCarSuspension
open Matrix

/-- Parameters and constants. -/
structure Params where
  /-- Sprung (body) mass per corner [kg] -/
  m_s : ℝ
  /-- Unsprung (wheel) mass [kg] -/
  m_u : ℝ
  /-- Suspension spring stiffness [N/m] -/
  k_s : ℝ
  /-- Passive suspension damping [N*s/m] -/
  c_s : ℝ
  /-- Tire vertical stiffness [N/m] -/
  k_t : ℝ
  /-- Skyhook damping gain [N*s/m] -/
  c_sky : ℝ

/-- Inputs. -/
structure Inputs where
  /-- Road vertical velocity [m/s] -/
  w_road : ℝ

/-- Differentiated variables (also used for their derivatives). -/
structure States where
  /-- Suspension deflection z_body - z_wheel [m] -/
  susp_defl : ℝ
  /-- Body vertical velocity [m/s] -/
  v_body : ℝ
  /-- Tire deflection z_wheel - z_road [m] -/
  tire_defl : ℝ
  /-- Wheel vertical velocity [m/s] -/
  v_wheel : ℝ

/-- Algebraic (non-differentiated) variables. -/
structure Algebraics where
  /-- Active suspension force on the body [N] -/
  F_act : ℝ
  /-- Passive spring + damper force on the body [N] -/
  F_susp : ℝ

/-- Modelica names of the parameters and constants, in declaration order. -/
def paramNames : List String := ["m_s", "m_u", "k_s", "c_s", "k_t", "c_sky"]

/-- Modelica names of the inputs, in declaration order. -/
def inputNames : List String := ["w_road"]

/-- Modelica names of the states, in declaration order. -/
def stateNames : List String := ["susp_defl", "v_body", "tire_defl", "v_wheel"]

/-- Modelica names of the algebraic variables and outputs, in declaration order. -/
def algebraicNames : List String := ["F_act", "F_susp"]

/-- The parameter bindings of the model. -/
def Params.Bound (p : Params) : Prop :=
  p.m_s = 300.0
  ∧ p.m_u = 40.0
  ∧ p.k_s = 16000.0
  ∧ p.c_s = 1000.0
  ∧ p.k_t = 190000.0
  ∧ p.c_sky = 3000.0

/-- Initial conditions: the `fixed = true` start values of the states. -/
def Initial (p : Params) (x : States) : Prop :=
  x.susp_defl = 0
  ∧ x.v_body = 0
  ∧ x.tire_defl = 0
  ∧ x.v_wheel = 0

/-- The continuous equations of `QuarterCarSuspension` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.F_act = -(p.c_sky * x.v_body)
  ∧ y.F_susp = -(p.k_s * x.susp_defl) - p.c_s * (x.v_body - x.v_wheel)
  ∧ dx.susp_defl = x.v_body - x.v_wheel
  ∧ dx.tire_defl = x.v_wheel - u.w_road
  ∧ p.m_s * dx.v_body = y.F_susp + y.F_act
  ∧ p.m_u * dx.v_wheel = -y.F_susp - y.F_act - p.k_t * x.tire_defl

/-- `x`, `y` is a solution of `QuarterCarSuspension` under input `u`: every state
component has derivative `dx t` at every `t`, and the equations hold. -/
def IsSolution (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) : Prop :=
  ∃ dx : ℝ → States, ∀ t : ℝ,
    HasDerivAt (fun s => (x s).susp_defl) (dx t).susp_defl t ∧
    HasDerivAt (fun s => (x s).v_body) (dx t).v_body t ∧
    HasDerivAt (fun s => (x s).tire_defl) (dx t).tire_defl t ∧
    HasDerivAt (fun s => (x s).v_wheel) (dx t).v_wheel t ∧
    Equations t p (u t) (x t) (dx t) (y t)

/-- `x`, `y` is a solution of `QuarterCarSuspension` on `[0, T]` under input `u`:
every state component is continuous on `[0, T]` and has right derivative
`dx t` at every `t ∈ [0, T)`, where the equations hold. Right derivatives
admit piecewise-continuous, right-continuous inputs (steps, zero-order hold). -/
def IsSolutionOn (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ) : Prop :=
  ∃ dx : ℝ → States,
    ContinuousOn (fun s => (x s).susp_defl) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).v_body) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).tire_defl) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).v_wheel) (Set.Icc 0 T) ∧
    ∀ t ∈ Set.Ico 0 T,
      HasDerivWithinAt (fun s => (x s).susp_defl) (dx t).susp_defl (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).v_body) (dx t).v_body (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).tire_defl) (dx t).tire_defl (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).v_wheel) (dx t).v_wheel (Set.Ici t) t ∧
      Equations t p (u t) (x t) (dx t) (y t)

/-- A solution on all of `ℝ` is a solution on every `[0, T]`. -/
theorem IsSolution.isSolutionOn {p : Params} {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} (h : IsSolution p u x y) (T : ℝ) : IsSolutionOn p u x y T := by
  obtain ⟨dx, hdx⟩ := h
  exact ⟨dx,
    fun s _ => ((hdx s).1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.2.1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.2.2.1).continuousAt.continuousWithinAt,
    fun t _ => ⟨
      ((hdx t).1).hasDerivWithinAt,
      ((hdx t).2.1).hasDerivWithinAt,
      ((hdx t).2.2.1).hasDerivWithinAt,
      ((hdx t).2.2.2.1).hasDerivWithinAt,
      (hdx t).2.2.2.2⟩⟩

end QuarterCarSuspension
