/-
Generated by Rumoca - Lean 4 / Mathlib specification of `DynamicPositioningSurge`
from the checked DAE IR.

* `Equations t p u x dx y` : the continuous equations at one instant
  (`dx` holds the time derivatives of the states).
* `IsSolution p u x y`     : trajectories `x`, `y` satisfy the model under input `u`.
* `IsSolutionOn p u x y T` : the same on `[0, T]`, with continuity on `[0, T]`
  and right derivatives on `[0, T)` (admits step inputs).
* `paramNames`, `inputNames`, `stateNames`, `algebraicNames` : Modelica names.
* `Params.Bound p`         : the parameter values bound in the model.
* `Initial p x₀`           : the `fixed = true` start values.

Arrays are `Fin n → ℝ` / `Matrix (Fin m) (Fin n) ℝ`; Modelica `v[k]` is `v (k-1)`.
-/
import Rumoca.Prelude

set_option linter.unusedVariables false

namespace DynamicPositioningSurge
open Matrix

/-- Parameters and constants. -/
structure Params where
  /-- Mass including added mass [t] -/
  M : ℝ
  /-- Linear surge damping [kN*s/m] -/
  D : ℝ
  /-- Position gain [kN/m] -/
  kp : ℝ
  /-- Velocity gain [kN*s/m] -/
  kd : ℝ
  /-- Integral gain [kN/(m*s)] -/
  ki : ℝ

/-- Inputs. -/
structure Inputs where
  /-- Wave drift + wind gust force [kN] -/
  F_wave : ℝ

/-- Differentiated variables (also used for their derivatives). -/
structure States where
  /-- Surge position error from setpoint [m] -/
  x : ℝ
  /-- Surge speed [m/s] -/
  u : ℝ
  /-- Integral of position error [m*s] -/
  xi : ℝ

/-- Algebraic (non-differentiated) variables. -/
structure Algebraics where
  /-- Thruster force [kN] -/
  tau : ℝ

/-- Modelica names of the parameters and constants, in declaration order. -/
def paramNames : List String := ["M", "D", "kp", "kd", "ki"]

/-- Modelica names of the inputs, in declaration order. -/
def inputNames : List String := ["F_wave"]

/-- Modelica names of the states, in declaration order. -/
def stateNames : List String := ["x", "u", "xi"]

/-- Modelica names of the algebraic variables and outputs, in declaration order. -/
def algebraicNames : List String := ["tau"]

/-- The parameter bindings of the model. -/
def Params.Bound (p : Params) : Prop :=
  p.M = 5000.0
  ∧ p.D = 50.0
  ∧ p.kp = 200.0
  ∧ p.kd = 2000.0
  ∧ p.ki = 4.0

/-- Initial conditions: the `fixed = true` start values of the states. -/
def Initial (p : Params) (x : States) : Prop :=
  x.x = 0
  ∧ x.u = 0
  ∧ x.xi = 0

/-- The continuous equations of `DynamicPositioningSurge` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.tau = -(p.kp * x.x) - p.kd * x.u - p.ki * x.xi
  ∧ dx.xi = x.x
  ∧ dx.x = x.u
  ∧ p.M * dx.u = -(p.D * x.u) + y.tau + u.F_wave

/-- `x`, `y` is a solution of `DynamicPositioningSurge` under input `u`: every state
component has derivative `dx t` at every `t`, and the equations hold. -/
def IsSolution (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) : Prop :=
  ∃ dx : ℝ → States, ∀ t : ℝ,
    HasDerivAt (fun s => (x s).x) (dx t).x t ∧
    HasDerivAt (fun s => (x s).u) (dx t).u t ∧
    HasDerivAt (fun s => (x s).xi) (dx t).xi t ∧
    Equations t p (u t) (x t) (dx t) (y t)

/-- `x`, `y` is a solution of `DynamicPositioningSurge` on `[0, T]` under input `u`:
every state component is continuous on `[0, T]` and has right derivative
`dx t` at every `t ∈ [0, T)`, where the equations hold. Right derivatives
admit piecewise-continuous, right-continuous inputs (steps, zero-order hold). -/
def IsSolutionOn (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ) : Prop :=
  ∃ dx : ℝ → States,
    ContinuousOn (fun s => (x s).x) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).u) (Set.Icc 0 T) ∧
    ContinuousOn (fun s => (x s).xi) (Set.Icc 0 T) ∧
    ∀ t ∈ Set.Ico 0 T,
      HasDerivWithinAt (fun s => (x s).x) (dx t).x (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).u) (dx t).u (Set.Ici t) t ∧
      HasDerivWithinAt (fun s => (x s).xi) (dx t).xi (Set.Ici t) t ∧
      Equations t p (u t) (x t) (dx t) (y t)

/-- A solution on all of `ℝ` is a solution on every `[0, T]`. -/
theorem IsSolution.isSolutionOn {p : Params} {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} (h : IsSolution p u x y) (T : ℝ) : IsSolutionOn p u x y T := by
  obtain ⟨dx, hdx⟩ := h
  exact ⟨dx,
    fun s _ => ((hdx s).1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.1).continuousAt.continuousWithinAt,
    fun s _ => ((hdx s).2.2.1).continuousAt.continuousWithinAt,
    fun t _ => ⟨
      ((hdx t).1).hasDerivWithinAt,
      ((hdx t).2.1).hasDerivWithinAt,
      ((hdx t).2.2.1).hasDerivWithinAt,
      (hdx t).2.2.2⟩⟩

end DynamicPositioningSurge
