/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `x`, `u`, `xi`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.x, (1 : ℝ) * s.u, (1 : ℝ) * s.xi]
/-- Disturbance channels: `F_wave`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.F_wave]

/-- Vertex matrices of the polytope of systems (corners of the parameter box). -/
def As : Fin 2 → Matrix (Fin 3) (Fin 3) ℚ :=
  ![!![0, 1, 0; -1/25, -203/500, -1/1250; 1, 0, 0],
    !![0, 1, 0; -1/25, -52/125, -1/1250; 1, 0, 0]]
def Bm : Matrix (Fin 3) (Fin 1) ℚ := !![0; 1/5000; 0]

/-- Interpolation weights of the actual parameters. -/
noncomputable def weights (p : Params) : Fin 2 → ℝ :=
  ![(((80 : ℝ) - p.D) / (50 : ℝ)), ((p.D - (30 : ℝ)) / (50 : ℝ))]

theorem f_apply (wt : Fin 2 → ℝ) (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    (∑ i, wt i • toReal (As i)) *ᵥ z + toReal Bm *ᵥ w = ![wt 0 * ((1 : ℝ) * (z 1)) + wt 1 * ((1 : ℝ) * (z 1)), wt 0 * ((-1/25 : ℝ) * (z 0) + (-203/500 : ℝ) * (z 1) + (-1/1250 : ℝ) * (z 2)) + wt 1 * ((-1/25 : ℝ) * (z 0) + (-52/125 : ℝ) * (z 1) + (-1/1250 : ℝ) * (z 2)) + (1/5000 : ℝ) * (w 0), wt 0 * ((1 : ℝ) * (z 0)) + wt 1 * ((1 : ℝ) * (z 0))] := by
  funext i
  fin_cases i <;>
    simp [As, Bm, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (5000.0 : ℝ) = 5000 := by norm_num
theorem lit1 : (50.0 : ℝ) = 50 := by norm_num
theorem lit2 : (200.0 : ℝ) = 200 := by norm_num
theorem lit3 : (2000.0 : ℝ) = 2000 := by norm_num
theorem lit4 : (4.0 : ℝ) = 4 := by norm_num

theorem weights_nonneg {p : Params} (hp : Spec.ParamsOK p) : ∀ i, 0 ≤ weights p i := by
  obtain ⟨hb0, hl1, hh1, hb2, hb3, hb4⟩ := hp
  intro i
  fin_cases i
  · show (0 : ℝ) ≤ (((80 : ℝ) - p.D) / (50 : ℝ))
    exact (div_nonneg (by linarith) (by norm_num))
  · show (0 : ℝ) ≤ ((p.D - (30 : ℝ)) / (50 : ℝ))
    exact (div_nonneg (by linarith) (by norm_num))

theorem weights_sum (p : Params) : ∑ i, weights p i = 1 := by
  simp [weights, Fin.sum_univ_succ]
  ring

theorem link {p : Params} (hp : Spec.ParamsOK p) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    ContinuousOn (fun t => vec (x t) (u t)) (Icc 0 T) ∧ ∀ t ∈ Ico 0 T,
      HasDerivWithinAt (fun t => vec (x t) (u t))
        ((∑ i, weights p i • toReal (As i)) *ᵥ vec (x t) (u t) + toReal Bm *ᵥ dist (u t))
        (Ici t) t := by
  obtain ⟨hb0, hl1, hh1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).x) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).u) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).xi) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3⟩⟩ := hder t ht
    try simp only [hb0, hb2, hb3, hb4, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).x) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).x = ((((80 : ℝ) - p.D) / (50 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).u)) + (((p.D - (30 : ℝ)) / (50 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).u))
      linear_combination (1 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).u) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).u = ((((80 : ℝ) - p.D) / (50 : ℝ))) * ((-1/25 : ℝ) * ((1 : ℝ) * (x t).x) + (-203/500 : ℝ) * ((1 : ℝ) * (x t).u) + (-1/1250 : ℝ) * ((1 : ℝ) * (x t).xi)) + (((p.D - (30 : ℝ)) / (50 : ℝ))) * ((-1/25 : ℝ) * ((1 : ℝ) * (x t).x) + (-52/125 : ℝ) * ((1 : ℝ) * (x t).u) + (-1/1250 : ℝ) * ((1 : ℝ) * (x t).xi)) + (1/5000 : ℝ) * ((u t).F_wave)
      linear_combination (1/5000 : ℝ) * e0 + (1/5000 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).xi) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).xi = ((((80 : ℝ) - p.D) / (50 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).x)) + (((p.D - (30 : ℝ)) / (50 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).x))
      linear_combination (1 : ℝ) * e1

