def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.dqc = -(p.kp * x.dy) - p.ki * x.z
  ∧ dx.z = x.dy
  ∧ p.tau * dx.xp = 2 * (y.dqc - x.xp)
  ∧ y.dqd = 2 * x.xp - y.dqc
