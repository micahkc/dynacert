/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `dy`, `xp`, `z`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.dy, (1 : ℝ) * s.xp, (1 : ℝ) * s.z]
/-- Disturbance channels: `dqoff`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.dqoff]

def model : LTIModel 3 1 where
  A := !![1/24, 1/3000, 1/2400; -125/2, -1/4, -5/8; 1, 0, 0]
  B := !![-1/6000; 0; 0]

theorem f_apply (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(1/24 : ℝ) * (z 0) + (1/3000 : ℝ) * (z 1) + (1/2400 : ℝ) * (z 2) + (-1/6000 : ℝ) * (w 0), (-125/2 : ℝ) * (z 0) + (-1/4 : ℝ) * (z 1) + (-5/8 : ℝ) * (z 2), (1 : ℝ) * (z 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (0.5 : ℝ) = 1/2 := by norm_num
theorem lit1 : (6000.0 : ℝ) = 6000 := by norm_num
theorem lit2 : (8.0 : ℝ) = 8 := by norm_num
theorem lit3 : (250.0 : ℝ) = 250 := by norm_num
theorem lit4 : (2.5 : ℝ) = 5/2 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dy) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).xp) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).z) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3, e4⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb2, hb3, lit0, lit1, lit2, lit3, lit4] at e0 e1 e2 e3 e4
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dy) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dy = (1/24 : ℝ) * ((1 : ℝ) * (x t).dy) + (1/3000 : ℝ) * ((1 : ℝ) * (x t).xp) + (1/2400 : ℝ) * ((1 : ℝ) * (x t).z) + (-1/6000 : ℝ) * ((u t).dqoff)
      linear_combination (-1/6000 : ℝ) * e0 + (1/6000 : ℝ) * e3 + (1/6000 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).xp) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).xp = (-125/2 : ℝ) * ((1 : ℝ) * (x t).dy) + (-1/4 : ℝ) * ((1 : ℝ) * (x t).xp) + (-5/8 : ℝ) * ((1 : ℝ) * (x t).z)
      linear_combination (1/4 : ℝ) * e0 + (1/8 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).z) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).z = (1 : ℝ) * ((1 : ℝ) * (x t).dy)
      linear_combination (1 : ℝ) * e1

