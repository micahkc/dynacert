/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `e`, `ev`. -/
def vec (s : States) (v : Inputs) : Fin 2 → ℝ :=
  ![(1 : ℝ) * s.x + (-1 : ℝ) * v.x_ref, (1 : ℝ) * s.v + (-1 : ℝ) * v.v_ref]
/-- Disturbance channels: `d`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.d]

def model : LTIModel 2 1 where
  A := !![0, 1; -3, -1]
  B := !![0; 1]

theorem f_apply (z : Fin 2 → ℝ) (w : Fin 1 → ℝ) :
    model.toSystem.f z w = ![(1 : ℝ) * (z 1), (-3 : ℝ) * (z 0) + (-1 : ℝ) * (z 1) + (1 : ℝ) * (w 0)] := by
  funext i
  fin_cases i <;>
    simp [LTIModel.toSystem, model, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

theorem lit0 : (1.0 : ℝ) = 1 := by norm_num
theorem lit1 : (0.2 : ℝ) = 1/5 := by norm_num
theorem lit2 : (2.0 : ℝ) = 2 := by norm_num
theorem lit3 : (0.8 : ℝ) = 4/5 := by norm_num

theorem link {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    model.toSystem.IsSolution (fun t => vec (x t) (u t)) (fun t => dist (u t)) T := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hc0, hc1, hder⟩ := h
  obtain ⟨hrc0, hrc1, hrder⟩ := hr
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).x + (-1 : ℝ) * (u s).x_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc0)).add (continuousOn_const.mul hrc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).v + (-1 : ℝ) * (u s).v_ref) (Icc 0 T)
      exact ((continuousOn_const.mul hc1)).add (continuousOn_const.mul hrc1)
  · obtain ⟨hd0, hd1, ⟨e0, e1, e2, e3, e4, e5⟩⟩ := hder t ht
    obtain ⟨hrd0, hrd1⟩ := hrder t ht
    try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).x + (-1 : ℝ) * (u s).x_ref) _ (Ici t) t
      refine (((hd0.const_mul (1 : ℝ))).add (hrd0.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).x + (-1 : ℝ) * (u t).v_ref = (1 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref)
      linear_combination (1 : ℝ) * e4
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).v + (-1 : ℝ) * (u s).v_ref) _ (Ici t) t
      refine (((hd1.const_mul (1 : ℝ))).add (hrd1.const_mul (-1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).v + (-1 : ℝ) * (u t).a_ref = (-3 : ℝ) * ((1 : ℝ) * (x t).x + (-1 : ℝ) * (u t).x_ref) + (-1 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref) + (1 : ℝ) * ((u t).d)
      linear_combination (-2 : ℝ) * e0 + (-4/5 : ℝ) * e1 + (1 : ℝ) * e2 + (1 : ℝ) * e3 + (1 : ℝ) * e5

/-! ### Storage function `V z = zᵀ P z` and per-channel rates -/

def P : Matrix (Fin 2) (Fin 2) ℚ := !![2271542/766369, 25445/103323; 25445/103323, 240402/233201]
def α : ℚ := 209308/438085
def γ : Fin 1 → ℚ := ![744389/753427]

def lmiL : Matrix (Fin 2 ⊕ Fin 1) (Fin 2 ⊕ Fin 1) ℚ :=
  fromBlocks !![1, 693571660986277498015/165689957449962672874; 0, 1] !![-1220395864831775/304501188949746; -22483886125994476756899917733936928085/24822996634074404739122117609423025937]
      !![0, 0] !![1]
def lmiD : Fin 2 ⊕ Fin 1 → ℚ :=
  Sum.elim ![710502774216074/11563040985053965, 24822996634074404739122117609423025937/1340355233895820263126306632772468723772230] ![5732702351741012054120236262730782641262713507/5797138152564005083135872648924748712790148970931]

def cert : ChannelCert model :=
  ⟨P, α, γ, by decide +kernel, by decide +kernel, by decide +kernel,
    ⟨lmiL, lmiD, by decide +kernel, by decide +kernel⟩⟩

/-- Invariant level `max(Σγⱼδⱼ²/α, V(z₀))`. -/
def level : ℚ := 326105655065/157698298516
def δ : Fin 1 → ℚ := ![1]

theorem budget_le :
    (∑ j, (γ j : ℝ) * ((δ j : ℝ) * (δ j : ℝ))) / (α : ℝ) ≤ (level : ℝ) := by
  have h : (∑ j, γ j * (δ j * δ j)) / α ≤ level := by decide +kernel
  exact_mod_cast h

/-- `|e| ≤ 5649/6695` on `{zᵀPz ≤ level}`. -/
def box0 : LinearBoxCert P level ![1, 0] (5649/6695) :=
  ⟨by decide +kernel, by decide +kernel,
    ⟨!![1, 2973696223746208589910738660/717401755919093004988317557; 0, 1],
     ![17625279608851755521419/416699277000938021361700, 1853671429658062886489691002028059015896974/258267500337840300910857512394522183263676925],
     by decide +kernel, by decide +kernel⟩⟩

/-- `|ev| ≤ 7281/5089` on `{zᵀPz ≤ level}`. -/
def box1 : LinearBoxCert P level ![0, 1] (7281/5089) :=
  ⟨by decide +kernel, by decide +kernel,
    ⟨!![1, 2785751315/33528933438; 0, 1],
     ![2457574846038/405048241201, 984689954932388406031393851166033/2380541920056084593061771355749835924],
     by decide +kernel, by decide +kernel⟩⟩

theorem init {p : Params} (hp : p.Bound) {s : States} {v : Inputs} (h0 : Initial p s)
    (hr0 : v.x_ref = (0 : ℝ) ∧ v.v_ref = (0 : ℝ)) :
    vec s v = fun i => (((![0, 0] : Fin 2 → ℚ) i : ℚ) : ℝ) := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨i0, i1⟩ := h0
  obtain ⟨r0, r1⟩ := hr0
  funext i
  fin_cases i <;>
    simp [vec, hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3, i0, i1, r0, r1] <;> norm_num

theorem init_le :
    quad (toReal P) (fun i => (((![0, 0] : Fin 2 → ℚ) i : ℚ) : ℝ)) ≤ (level : ℝ) := by
  rw [quad_toReal_cast]
  exact_mod_cast (by decide +kernel : quad P ![0, 0] ≤ level)

theorem out0 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Ico 0 T) :
    (y t).e = (fun i => ((![1, 0] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![1, 0] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).x + (-1 : ℝ) * (u t).x_ref) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hder⟩ := h
  have hE := (hder.2.2 t ht).2.2
  obtain ⟨e0, e1, e2, e3, e4, e5⟩ := hE
  try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5
  linear_combination (1 : ℝ) * e0

theorem out1 {p : Params} (hp : p.Bound) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T) {t : ℝ}
    (ht : t ∈ Ico 0 T) :
    (y t).ev = (fun i => ((![0, 1] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) := by
  have hdot : (fun i => ((![0, 1] : Fin 2 → ℚ) i : ℝ)) ⬝ᵥ vec (x t) (u t) =
      (1 : ℝ) * ((1 : ℝ) * (x t).v + (-1 : ℝ) * (u t).v_ref) := by
    simp [vec, dotProduct, Fin.sum_univ_succ] <;> ring
  rw [hdot]
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨dx, hder⟩ := h
  have hE := (hder.2.2 t ht).2.2
  obtain ⟨e0, e1, e2, e3, e4, e5⟩ := hE
  try simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5
  linear_combination (1 : ℝ) * e1

/-- **Tube.** Under the hypotheses of `Spec.Claim`, the error-frame state
`z = vec (x t) (u t)` (coordinates `e`, `ev`) stays in the certified ellipsoid
`zᵀ P z ≤ level` on `[0, T]`. With a reference trajectory this is a tube around it:
the physical state lies in the reference plus this ellipsoid. -/
theorem tube : ∀ (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics)
    (T : ℝ), p.Bound → IsSolutionOn p u x y T → Spec.Admissible u T →
    Spec.References u T → Spec.ReferenceStart u → Initial p (x 0) →
    ∀ t ∈ Icc 0 T, quad (toReal P) (vec (x t) (u t)) ≤ (level : ℝ) := by
  intro p u x y T hp h hu hr hr0 h0
  have hx := link hp h hr
  have hw : ∀ t ∈ Ico 0 T, cert.energy (dist (u t)) ≤
      ∑ j, (γ j : ℝ) * ((δ j : ℝ) * (δ j : ℝ)) := by
    intro t ht
    have hut := hu t ht
    refine cert.energy_le_of_abs_le (δ := δ) fun j => ?_
    fin_cases j <;> simp [dist, δ] <;> simp_all
  have h0' : quad (toReal cert.P) (vec (x 0) (u 0)) ≤ (level : ℝ) := by
    rw [init hp h0 hr0]; exact init_le
  exact cert.invariant hx hw h0' budget_le

/-- **Certified.** The claim of `Spec.lean` holds with the bounds `![5649/6695, 7281/5089]`. -/
theorem certified : Spec.Claim ![5649/6695, 7281/5089] := by
  intro p u x y T hp h hu hr hr0 h0
  have hV := tube p u x y T hp h hu hr hr0 h0
  intro t ht
  refine ⟨?_, ?_⟩
  · rw [out0 hp h ht]; exact box0.abs_le (hV t ⟨ht.1, ht.2.le⟩)
  · rw [out1 hp h ht]; exact box1.abs_le (hV t ⟨ht.1, ht.2.le⟩)

