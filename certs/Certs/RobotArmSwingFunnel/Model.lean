/-- Modelica names of the states, in declaration order. -/
def stateNames : List String := ["theta", "omega"]

/-- Modelica names of the algebraic variables and outputs, in declaration order. -/
def algebraicNames : List String := ["s", "theta_ref", "omega_ref", "a_ref", "u", "e"]

/-- The parameter bindings of the model. -/
def Params.Bound (p : Params) : Prop :=
  p.G = 2.0
  ∧ p.kp = 16.0
  ∧ p.kd = 8.0
  ∧ p.A = 0.5
  ∧ p.Tf = 2

/-- Initial conditions: the `fixed = true` start values of the states. -/
def Initial (p : Params) (x : States) : Prop :=
  x.theta = 0
  ∧ x.omega = 0

/-- The continuous equations of `RobotArmSwingFunnel` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.s = t / p.Tf
  ∧ y.theta_ref = 64 * p.A * y.s ^ 3 * (1 - y.s) ^ 3
  ∧ y.omega_ref = 64 * p.A * (3 * y.s ^ 2 * (1 - y.s) ^ 3 - 3 * y.s ^ 3 * (1 - y.s) ^ 2) / p.Tf
  ∧ y.a_ref = 64 * p.A * (6 * y.s * (1 - y.s) ^ 3 - 18 * y.s ^ 2 * (1 - y.s) ^ 2 + 6 * y.s ^ 3 * (1 - y.s)) / p.Tf ^ 2
  ∧ y.u = y.a_ref + p.G * Real.sin y.theta_ref + p.kp * (y.theta_ref - x.theta) + p.kd * (y.omega_ref - x.omega)
  ∧ dx.theta = x.omega
  ∧ dx.omega = -(p.G * Real.sin x.theta) + y.u + u.w
  ∧ y.e = x.theta - y.theta_ref

/-- `x`, `y` is a solution of `RobotArmSwingFunnel` under input `u`: every state
component has derivative `dx t` at every `t`, and the equations hold. -/
def IsSolution (p : Params) (u : ℝ → Inputs) (x : ℝ → States) (y : ℝ → Algebraics) : Prop :=
  ∃ dx : ℝ → States, ∀ t : ℝ,
    HasDerivAt (fun s => (x s).theta) (dx t).theta t ∧
    HasDerivAt (fun s => (x s).omega) (dx t).omega t ∧
