/-- Certified bounds on e up to the horizon. -/
def bounds : Fin 1 → ℚ := ![25279/1000000]

/-- The references named by `nominal` are the polynomials `ref_k`, and the certified
outputs are error coordinates. -/
theorem outputs {p : Params} (hp : p.Bound) {t : ℝ} {xs dxs : States} {us : Inputs}
    {ys : Algebraics} (he : Equations t p us xs dxs ys) :
    ys.e = zvec xs t 0 := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4⟩ := hp
  obtain ⟨e0, e1, e2, e3, e4, e5, e6, e7⟩ := he
  simp only [hb0, hb1, hb2, hb3, hb4, lit0, lit1, lit2, lit3] at e0 e1 e2 e3 e4 e5 e6 e7
  have hv0 := ref0_val t
  have hv1 := ref1_val t
  try simp only [e0] at e1
  have hy0 : ys.theta_ref = GNC.PolynomialOrder.value ref0 t := by
    rw [e1, ref0_val]; ring
  try simp only [e0, hy0] at e2
  have hy1 : ys.omega_ref = GNC.PolynomialOrder.value ref1 t := by
    rw [e2, ref1_val]; ring
  try simp only [e0, hy0, hy1] at e3
  try simp only [e0, hy0, hy1, e3] at e4
  try simp only [e0, hy0, hy1, e3, e4] at e7
  exact by rw [e7]; simp only [zvec, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_succ, Matrix.cons_val']; try ring

theorem certified : Spec.Claim bounds := by
  intro p u x y T hp hsol hadm hinit t ht htf
  obtain ⟨dx, hc0, hc1, hder⟩ := hsol
  set b := min T Spec.horizon with hbdef
  have hbT : b ≤ T := min_le_left _ _
  have hsub : Icc 0 b ⊆ Icc 0 T := Icc_subset_Icc le_rfl hbT
  have hsubo : ∀ s ∈ Ico 0 b, s ∈ Ico 0 T := fun s hs => ⟨hs.1, lt_of_lt_of_le hs.2 hbT⟩
  have hz_cont : ContinuousOn (fun s => zvec (x s) s) (Icc 0 b) := by
    refine continuousOn_pi.mpr fun c => ?_
    fin_cases c
    · show ContinuousOn (fun s => (x s).theta - GNC.PolynomialOrder.value ref0 s) (Icc 0 b)
      exact (hc0.mono hsub).sub (continuous_iff_continuousAt.mpr
        fun s => (ref0_deriv s).continuousAt).continuousOn
    · show ContinuousOn (fun s => (x s).omega - GNC.PolynomialOrder.value ref1 s) (Icc 0 b)
      exact (hc1.mono hsub).sub (continuous_iff_continuousAt.mpr
        fun s => (ref1_deriv s).continuousAt).continuousOn
  have hz_der : ∀ s ∈ Ico 0 b, HasDerivWithinAt (fun s => zvec (x s) s) (zdot (dx s) s)
      (Ici s) s := by
    intro s hs
    obtain ⟨hd0, hd1, -⟩ := hder s (hsubo s hs)
    rw [hasDerivWithinAt_pi]
    intro c
    fin_cases c
    · show HasDerivWithinAt (fun s => (x s).theta - GNC.PolynomialOrder.value ref0 s)
        ((dx s).theta - GNC.PolynomialOrder.value ref0d s) (Ici s) s
      exact hd0.sub (ref0_deriv s).hasDerivWithinAt
    · show HasDerivWithinAt (fun s => (x s).omega - GNC.PolynomialOrder.value ref1 s)
        ((dx s).omega - GNC.PolynomialOrder.value ref1d s) (Ici s) s
      exact hd1.sub (ref1_deriv s).hasDerivWithinAt
  have hemb : ∀ i : Fin 8, ∀ s ∈ Ico 0 b, 0 + ((i : ℕ) : ℝ) * (cert.h : ℝ) ≤ s →
      s < 0 + (((i : ℕ) : ℝ) + 1) * (cert.h : ℝ) →
      (∀ l, |(fun j => (cert.cs l j : ℝ)) ⬝ᵥ zvec (x s) s| < (cert.ρ i l : ℝ)) →
      ∃ wt : Fin 2 → ℝ, (∀ j, 0 ≤ wt j) ∧ ∑ j, wt j = 1 ∧
        zdot (dx s) s = (∑ j, wt j • toReal (cert.As i j)) *ᵥ zvec (x s) s
          + toReal cert.B *ᵥ dist (u s) := by
    intro i s hs h1 h2 hband
    obtain ⟨-, -, he⟩ := hder s (hsubo s hs)
    simp only [cert, h] at h1 h2
    fin_cases i
    · exact emb_0 hp he (by push_cast at h1 ⊢; linarith) (by push_cast at h2 ⊢; linarith) hband
    · exact emb_1 hp he (by push_cast at h1 ⊢; linarith) (by push_cast at h2 ⊢; linarith) hband
    · exact emb_2 hp he (by push_cast at h1 ⊢; linarith) (by push_cast at h2 ⊢; linarith) hband
    · exact emb_3 hp he (by push_cast at h1 ⊢; linarith) (by push_cast at h2 ⊢; linarith) hband
    · exact emb_4 hp he (by push_cast at h1 ⊢; linarith) (by push_cast at h2 ⊢; linarith) hband
    · exact emb_5 hp he (by push_cast at h1 ⊢; linarith) (by push_cast at h2 ⊢; linarith) hband
    · exact emb_6 hp he (by push_cast at h1 ⊢; linarith) (by push_cast at h2 ⊢; linarith) hband
    · exact emb_7 hp he (by push_cast at h1 ⊢; linarith) (by push_cast at h2 ⊢; linarith) hband
  have hw : ∀ s ∈ Ico 0 b, ∑ j, (cert.γ j : ℝ) * (dist (u s) j * dist (u s) j) ≤ cert.β := by
    intro s hs
    have ha := hadm s (hsubo s hs)
    have hsq : (u s).w * (u s).w ≤ (1/100 : ℝ) := by
      have := abs_le.mp ha; nlinarith
    simp only [cert, γ, β, dist, Fin.sum_univ_succ, Fin.sum_univ_zero, Matrix.cons_val_zero, add_zero]
    push_cast
    nlinarith [hsq]
  have h0 : quad (toReal (cert.P ⟨0, by norm_num⟩ ⟨0, by norm_num⟩)) (zvec (x 0) 0) ≤ (cert.v0 : ℝ) := by
    obtain ⟨i0, i1⟩ := hinit
    have hz : zvec (x 0) 0 = 0 := by
      funext c
      fin_cases c <;> simp [zvec, i0, i1, ref0_val, ref1_val]
    rw [hz]
    simp [quad, cert]
  have htb : t ∈ Icc 0 b := ⟨ht.1, le_min ht.2.le htf⟩
  have htS : t ≤ 0 + (8 : ℕ) * (cert.h : ℝ) := by
    simp only [cert, h, Spec.horizon] at htf ⊢; push_cast; linarith
  obtain ⟨-, -, he⟩ := hder t ht
  have hout := outputs hp he
  have hb0 := cert.output_bound (by norm_num) hz_cont hz_der hemb hw h0 0
    (bnd := bounds 0) (by decide +kernel) (by decide +kernel) t htb htS
  simp only [cert, rows, dotProduct, Fin.sum_univ_succ, Fin.sum_univ_zero,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_succ,
    Matrix.cons_val', Rat.cast_one, Rat.cast_zero, one_mul, zero_mul, add_zero,
    zero_add] at hb0
  rw [hout]; exact hb0

