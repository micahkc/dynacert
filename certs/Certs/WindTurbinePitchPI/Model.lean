/-- The continuous equations of `WindTurbinePitchPI` at time `t`. -/
def Equations (t : ℝ) (p : Params) (u : Inputs) (x dx : States) (y : Algebraics) : Prop :=
  y.theta_cmd = p.kp * x.dw + p.ki * x.z
  ∧ dx.z = x.dw
  ∧ p.J * dx.dw = p.kw * x.dw + p.ktheta * x.dtheta + p.kv * u.dv_wind
