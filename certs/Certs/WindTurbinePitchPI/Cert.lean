theorem weights_nonneg {p : Params} (hp : Spec.ParamsOK p) : ∀ i, 0 ≤ weights p i := by
  obtain ⟨hb0, hb1, hl2, hh2, hb3, hb4, hb5, hb6⟩ := hp
  intro i
  fin_cases i
  · show (0 : ℝ) ≤ (((-1/2 : ℝ) - p.ktheta) / (7/10 : ℝ))
    exact (div_nonneg (by linarith) (by norm_num))
  · show (0 : ℝ) ≤ ((p.ktheta - (-6/5 : ℝ)) / (7/10 : ℝ))
    exact (div_nonneg (by linarith) (by norm_num))

theorem weights_sum (p : Params) : ∑ i, weights p i = 1 := by
  simp [weights, Fin.sum_univ_succ]
  ring

theorem link {p : Params} (hp : Spec.ParamsOK p) {u : ℝ → Inputs} {x : ℝ → States}
    {y : ℝ → Algebraics} {T : ℝ} (h : IsSolutionOn p u x y T)
    (hr : Spec.References u T) :
    ContinuousOn (fun t => vec (x t) (u t)) (Icc 0 T) ∧ ∀ t ∈ Ico 0 T,
      HasDerivWithinAt (fun t => vec (x t) (u t))
        ((∑ i, weights p i • toReal (As i)) *ᵥ vec (x t) (u t) + toReal Bm *ᵥ dist (u t))
        (Ici t) t := by
  obtain ⟨hb0, hb1, hl2, hh2, hb3, hb4, hb5, hb6⟩ := hp
  obtain ⟨dx, hc0, hc1, hc2, hder⟩ := h
  refine ⟨?_, fun t ht => ?_⟩
  · refine continuousOn_pi.mpr fun i => ?_
    fin_cases i
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dw) (Icc 0 T)
      exact (continuousOn_const.mul hc0)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).dtheta) (Icc 0 T)
      exact (continuousOn_const.mul hc1)
    · show ContinuousOn (fun s => (1 : ℝ) * (x s).z) (Icc 0 T)
      exact (continuousOn_const.mul hc2)
  · obtain ⟨hd0, hd1, hd2, ⟨e0, e1, e2, e3⟩⟩ := hder t ht
    try simp only [hb0, hb1, hb3, hb4, hb5, hb6, lit0, lit1, lit2, lit3, lit4, lit5, lit6, lit7] at e0 e1 e2 e3
    rw [hasDerivWithinAt_pi]
    intro i
    fin_cases i
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dw) _ (Ici t) t
      refine ((hd0.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dw = ((((-1/2 : ℝ) - p.ktheta) / (7/10 : ℝ))) * ((-3/80 : ℝ) * ((1 : ℝ) * (x t).dw) + (-3/100 : ℝ) * ((1 : ℝ) * (x t).dtheta)) + (((p.ktheta - (-6/5 : ℝ)) / (7/10 : ℝ))) * ((-3/80 : ℝ) * ((1 : ℝ) * (x t).dw) + (-1/80 : ℝ) * ((1 : ℝ) * (x t).dtheta)) + (3/200 : ℝ) * ((u t).dv_wind)
      linear_combination (1/40 : ℝ) * e2
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).dtheta) _ (Ici t) t
      refine ((hd1.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).dtheta = ((((-1/2 : ℝ) - p.ktheta) / (7/10 : ℝ))) * ((200 : ℝ) * ((1 : ℝ) * (x t).dw) + (-10/3 : ℝ) * ((1 : ℝ) * (x t).dtheta) + (50 : ℝ) * ((1 : ℝ) * (x t).z)) + (((p.ktheta - (-6/5 : ℝ)) / (7/10 : ℝ))) * ((200 : ℝ) * ((1 : ℝ) * (x t).dw) + (-10/3 : ℝ) * ((1 : ℝ) * (x t).dtheta) + (50 : ℝ) * ((1 : ℝ) * (x t).z))
      linear_combination (10/3 : ℝ) * e0 + (10/3 : ℝ) * e3
    · show HasDerivWithinAt (fun s => (1 : ℝ) * (x s).z) _ (Ici t) t
      refine ((hd2.const_mul (1 : ℝ))).congr_deriv ?_
      rw [f_apply]
      show (1 : ℝ) * (dx t).z = ((((-1/2 : ℝ) - p.ktheta) / (7/10 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).dw)) + (((p.ktheta - (-6/5 : ℝ)) / (7/10 : ℝ))) * ((1 : ℝ) * ((1 : ℝ) * (x t).dw))
      linear_combination (1 : ℝ) * e1

