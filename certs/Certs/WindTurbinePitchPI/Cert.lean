/-! ### Link: the rumoca model, in coordinates `z`, is `ż = A z + B w` -/

/-- Coordinates: `dw`, `dtheta`, `z`. -/
def vec (s : States) (v : Inputs) : Fin 3 → ℝ :=
  ![(1 : ℝ) * s.dw, (1 : ℝ) * s.dtheta, (1 : ℝ) * s.z]
/-- Disturbance channels: `dv_wind`. -/
def dist (v : Inputs) : Fin 1 → ℝ := ![v.dv_wind]

/-- Vertex matrices of the polytope of systems (corners of the parameter box). -/
def As : Fin 2 → Matrix (Fin 3) (Fin 3) ℚ :=
  ![!![-3/80, -3/100, 0; 200, -10/3, 50; 1, 0, 0],
    !![-3/80, -1/80, 0; 200, -10/3, 50; 1, 0, 0]]
def Bm : Matrix (Fin 3) (Fin 1) ℚ := !![3/200; 0; 0]

/-- Interpolation weights of the actual parameters. -/
noncomputable def weights (p : Params) : Fin 2 → ℝ :=
  ![(((-1/2 : ℝ) - p.ktheta) / (7/10 : ℝ)), ((p.ktheta - (-6/5 : ℝ)) / (7/10 : ℝ))]

theorem f_apply (wt : Fin 2 → ℝ) (z : Fin 3 → ℝ) (w : Fin 1 → ℝ) :
    (∑ i, wt i • toReal (As i)) *ᵥ z + toReal Bm *ᵥ w = ![wt 0 * ((-3/80 : ℝ) * (z 0) + (-3/100 : ℝ) * (z 1)) + wt 1 * ((-3/80 : ℝ) * (z 0) + (-1/80 : ℝ) * (z 1)) + (3/200 : ℝ) * (w 0), wt 0 * ((200 : ℝ) * (z 0) + (-10/3 : ℝ) * (z 1) + (50 : ℝ) * (z 2)) + wt 1 * ((200 : ℝ) * (z 0) + (-10/3 : ℝ) * (z 1) + (50 : ℝ) * (z 2)), wt 0 * ((1 : ℝ) * (z 0)) + wt 1 * ((1 : ℝ) * (z 0))] := by
  funext i
  fin_cases i <;>
    simp [As, Bm, toReal, mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

