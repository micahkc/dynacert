/-- Modelica `atan2(y, x)`: the argument of `x + y i`, in `(-π, π]`. -/
noncomputable def atan2 (y x : ℝ) : ℝ := Complex.arg ⟨x, y⟩

/-- Modelica `sign(x)`. -/
noncomputable def sign (x : ℝ) : ℝ := if 0 < x then 1 else if x < 0 then -1 else 0

/-- Modelica 1-based subscript `v[k]` for a non-literal `k`; `0` outside `1..n`
(never reached by a checked model, whose subscripts are in range). -/
noncomputable def at1 {n : ℕ} (v : Fin n → ℝ) (k : ℕ) : ℝ :=
  if h : 1 ≤ k ∧ k ≤ n then v ⟨k - 1, by omega⟩ else 0

/-- Modelica `skew(v)`: the cross-product matrix of a 3-vector. -/
def skew (v : Fin 3 → ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  !![0, -v 2, v 1; v 2, 0, -v 0; -v 1, v 0, 0]

